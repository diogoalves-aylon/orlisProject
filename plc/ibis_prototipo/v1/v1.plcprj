					<functionBlock name="EBMSetFanAddress" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB can be used to change the Address of an EBM fan.

The required inputs are the current and target address and the number of retries to be done in case of error.
The configuration message is sent when a transition of xEn from FALSE to TRUE takes place.

The output provides the info whether the operation has been successful or not.

The EBMSetFanAddress AFB must be put inside the Background task of the PLC.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Transition FALSE -&gt; TRUE executes the write operation.</descr>
								</var>
								<var name="i_usiCurrentAddress" type="USINT">
									<descr>Current EBM Fan ModBUS Address</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_usiTargetAddress" type="USINT">
									<descr>Target EBM Fan ModBUS Address</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_usiRetries" type="USINT">
									<descr>Operation retries.</descr>
									<initValue>3</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xChanged" type="BOOL">
									<descr>TRUE if the ModBUS Address has been successfully changed.</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="runCheck" type="BOOL"/>
								<var name="uiRet_ADR" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="i" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="iReset" type="INT"/>
								<var name="iTargetADR" type="INT"/>
								<var name="j" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="uiRet_Reset" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="xEn_old" type="BOOL"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
							<![CDATA[ti0R9il1tJlcBRBX08lPbwtSaq8TbTcefWaqmhJJZi1J9YFwTJr0BnhVG8sXbCtSEqwzbncd
nWTymLpMwj9WLUn1gXBMmvQGeFUbyxdsK1ISrDNudx2dZPKYukzCP1YtSfWBcEya9AZ4VRvL
