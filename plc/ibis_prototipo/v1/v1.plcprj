					</functionBlock>
					<functionBlock name="FB_EEVPidSelect" version="1.0.1" hidden="true" creationDate="0" lastModifiedDate="1591779956" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV PID selection</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable the regulation</descr>
								</var>
								<var name="usiContModType" type="USINT">
									<descr>Coninuous modulation type (0=disable, 1=cool, 2=heat)</descr>
								</var>
								<var name="uiExtLimitValue" type="UINT">
									<descr>External limit value</descr>
								</var>
								<var name="uiSupHeatValue" type="UINT">
									<descr>Super heat PID out</descr>
								</var>
								<var name="uiMopValue" type="UINT">
									<descr>Mop PID out</descr>
								</var>
								<var name="uiContModValue" type="UINT">
									<descr>Continuous modulation PID out</descr>
								</var>
								<var name="iSH" type="INT">
									<descr>Super heat measure</descr>
								</var>
								<var name="iSatTempPres" type="INT">
									<descr>Saturating temperature/pressure</descr>
								</var>
								<var name="iContModTemp" type="INT">
									<descr>Continuous modulation temperature</descr>
								</var>
								<var name="usiOpen" type="USINT">
									<descr>Open valve command status</descr>
								</var>
								<var name="uiOpenValue" type="UINT">
									<descr>0 to 1000</descr>
								</var>
								<var name="uiAlarmValue" type="UINT">
									<descr>Value in case of probe failure</descr>
								</var>
								<var name="xEnMop" type="BOOL">
									<descr>Enable MOP regulation</descr>
								</var>
								<var name="uiMaxOpenValue" type="UINT">
									<descr>Max opening value [%]</descr>
									<initValue>1000</initValue>
								</var>
								<var name="uiDeadZoneOpenMin" type="UINT">
									<descr>Dead zone opening minimum [%]</descr>
									<initValue>0</initValue>
								</var>
								<var name="uiDeadZoneOpenMax" type="UINT">
									<descr>Dead zone opening maximum [%]</descr>
									<initValue>1000</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="uiOut" type="UINT">
									<descr>Opening % of the valve (with AutoManual = TRUE)</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiRegulStatus" type="USINT">
									<descr>1: Mop, 0: SuperHeat</descr>
								</var>
								<var name="iLimSupHeat" type="INT">
									<descr>SH limit when other enabled</descr>
								</var>
								<var name="iLimMop" type="INT">
									<descr>Mop limit when other enabled</descr>
								</var>
								<var name="iLimContMod" type="INT">
									<descr>Continuous modulation limit when other enabled</descr>
								</var>
								<var name="iShManualOut" type="INT"/>
								<var name="iMopManualOut" type="INT"/>
								<var name="iContModManualOut" type="INT"/>
								<var name="xAutoManualSh" type="BOOL"/>
								<var name="xAutoManualMop" type="BOOL"/>
								<var name="xAutoManualContMod" type="BOOL"/>
								<var name="xResetPID" type="BOOL">
									<descr>Reset both the PID</descr>
								</var>
								<var name="xShAlarm" type="BOOL">
									<descr>SH value alarm</descr>
								</var>
								<var name="xMopAlarm" type="BOOL">
									<descr>MOP value alarm</descr>
								</var>
								<var name="xContModAlarm" type="BOOL">
									<descr>Continuous modulation value alarm</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="xEnOld" type="BOOL">
									<descr>Regulation enable old value</descr>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
