					<functionBlock name="CheckCOMAlarm" version="1.0.1" creationDate="0" lastModifiedDate="1601478411" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>Check CAN Communication Alarm</title>
						<descr>&lt;HTML&gt;This AFB check if there is a missing communication in the CAN bus between the controller and EEV driver corresponding to i_usiNodeID address.</descr>
						<vars>
							<inputVars>
								<var name="i_usiNodeID" type="USINT"/>
							</inputVars>
							<outputVars>
								<var name="xComAlarm" type="BOOL"/>
							</outputVars>
							<externalVars>
								<var name="sysPeripheralStatus" type="BOOL" dim0="130"/>
							</externalVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
