					<functionBlock name="SuperHeatCalc" version="1.0.1" creationDate="0" lastModifiedDate="1602234040" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>Superheat calculation</title>
						<descr>&lt;HTML&gt;This FB calculates the value of superheat given values of evaporation pressure and temperature, depending on selected refrigerant.
It uses Press2Temp AFB for pressure to temperature conversion.
A low pass filter of superheat value is implemented.
Measurements unit (SI or BU) are also managed.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>T: block enabled  F: block disabled, Out = 0</descr>
									<initValue>TRUE</initValue>
								</var>
								<var name="i_iEvapPressure" type="INT">
									<descr>Evaporator pressure (*0.01 bar/psi)</descr>
									<initValue>75</initValue>
								</var>
								<var name="i_iEvapOutTemp" type="INT">
									<descr>Evaporator output temperature (*0.1 °C/°F)</descr>
									<initValue>40</initValue>
								</var>
								<var name="i_usiRefrType" type="USINT">
									<descr>Refrigerant type</descr>
								</var>
								<var name="i_usiMeasUnitType" type="USINT">
									<descr>Measurement unit type (0=SI, 1=imperial)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiFilterCoeff" type="UINT">
									<descr>Coefficient of filter (0..10000)</descr>
									<initValue>10000</initValue>
								</var>
								<var name="i_arCustRefParam" type="REAL" dim0="5">
									<descr>Custom Refrigerant Parameters Array</descr>
								</var>
								<var name="i_iCustRefPressMin" type="INT">
									<descr>Custom Refrigerant minimum pressure (*0.01 Bar)</descr>
								</var>
								<var name="i_iCustRefPressMax" type="INT">
									<descr>Custom Refrigerant maximum pressure (*0.01 Bar)</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_iSuperHeatSI" type="INT">
									<descr>Superheat (K)</descr>
								</var>
								<var name="q_iEvapTempSI" type="INT">
									<descr>Evaporator saturated temperature (°C)</descr>
								</var>
								<var name="q_iSuperHeat" type="INT">
									<descr>Superheat (K/°R)</descr>
								</var>
								<var name="q_iEvapTemp" type="INT">
									<descr>Evaporator saturated temperature (°C/°F)</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="EvapTempFilter" type="FB_LowPassFilter"/>
								<var name="P2T" type="Press2Temp"/>
								<var name="iEvapOutTempSI" type="INT"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="FBD" encoded="true">
							<![CDATA[ti0R9il1tJlcBRBX08lPbwtSaq8TbTcefWaqmhJJxi5p9sFzHJmUBWBUG8ovbbtR8qlrbKcY
