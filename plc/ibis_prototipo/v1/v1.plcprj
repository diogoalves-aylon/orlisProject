END_FUNCTION

FUNCTION sysWriteParBYTE: BOOL
	{ DE:"Write BYTE to EEPROM.
The function return a BOOL which could have the following meanings:
TRUE	=	Writing executed correctly.
FALSE	=	Writing not executed.

Example: bret:=sysWriteParBYTE(ADR(EEPROMPARAMETER),NewValue); 	
" }
	VAR_INPUT
		address : UDINT;  { DE:"Address" }
		Value   : BYTE;   { DE:"Value" }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysWriteParSTRING : BOOL
	{ DE:"Write a STRING to EEPROM.
The function return a BOOL which could have the following meanings:
TRUE	=	Writing executed correctly.
FALSE	=	Writing not executed.

Example: bret:=sysWriteParSTRING(ADR(EEPROMPARAMETER),NewValue);

Note: For BIOS version <= 668_14 sysWriteParSTRING() function does not protect Eeprom from continuous writes. Each call of this function must be counted as an actual write to Eeprom vs the number 100K guaranteed writes. 
" }
	VAR_INPUT
		id  : UDINT;  { DE:"Address" }
		msg : STRING; { DE:"String" }
		len : USINT;  { DE:"SIZEOF(String to write)" }		
	END_VAR
  {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysWD_Background: BOOL
	{ DE:"Write Watch Dog time value [sec/10]. 
It must be used in the background task. If the function is called 
with value lower than 255 it must be called again before the 
watch dog timer expires otherwise the target will reset.
Important Note: The use of breakpoints together with this
function might cause a target reset.
" }
	VAR_INPUT
		WD_Value  : USINT;  { DE:"Background task watch dog time [sec/10], 255=watch dog disabled" }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysWD_Timed: BOOL
	{ DE:" Write Watch Dog time value [sec/10]. 
It must be used in the timed task. If the function is called 
with value lower than 255 it must be called again before the 
watch dog timer expires otherwise the target will reset.
Important Note: The use of breakpoints together with this
function might cause a target reset.
" }
	VAR_INPUT
		WD_Value  : USINT;  {  DE:"Timed watch dog value [sec/10], 255=watch dog disabled " }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysExecutionPassword: BOOL
	{ DE:"If password correct, code execution can go on
The function return a BOOL which could have the following meanings:
TRUE	=	Password match correctly.
FALSE	=	watchdog occurred!
Password value is compared with 'Protection Password' parameter, to be set in Device.
" }
	VAR_INPUT
		Value   : DWORD;  { DE:"Password value" }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysPlugInRelay: BOOL
	{ DE:"Handle Plug-In's relay status.
The function return a BOOL which could have the following meanings:
TRUE	=	Relay driven.
FALSE	=	Not present RS232 Plug In.
" }
	VAR_INPUT
		Status   : BOOL;  { DE:"Relay status: TRUE=energized, FALSE=not energized" }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysINT_TO_STRING : BOOL
	{ DE:"Convert a INT number to a STRING.
The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done!
" }

	VAR_INPUT
		msg   : STRING; { DE:"Decimal number in STRING format" }
		len   : USINT;  { DE:"SIZEOF(String to fill)" }		
		value : INT;    { DE:"Int to convert" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION


FUNCTION sysSTRCAT : BOOL
	{ DE:"Append two STRINGs.
The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done!
" }

	VAR_INPUT
		msg_des : STRING; { DE:"Destination string" }
		len   	: USINT;  { DE:"SIZEOF(Destination string)" }		
		msg_app : STRING; { DE:"String to append" }
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysSTREQU : BOOL
	{ DE:"Test if two STRINGSs are equal.
The function return a BOOL which could have the following meanings:
TRUE	=	Equal.
FALSE	=	Not equal.
" }

	VAR_INPUT
		msg1 : STRING; { DE:"first string" }
		msg2 : STRING; { DE:"second string" }
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysSTREXT : USINT
	{ DE:" Extract a string anticipate by a separator character or <CR> in 
a text line	terminated by <CR><LF><NULL> in a given position.
The function return a USINT which could have the following meanings:
	0	=	String extracted correctly.       
	255	=	String extracted truncated.		       
	254	=	Position not present.	       
	253	=	No <CR><LF><NULL> at the end of scanned string.		       
	252	=	String to be scanned too long.       
" }

	VAR_INPUT
		pos			: USINT;  {	DE:"Position [1...255]"}
		msg_in  : STRING; { DE:"String to scan" }
		sep			: BYTE;		{ DE:"ASCII code of the separator character"}
		msg_ext : STRING; { DE:"String extracted" }		
		len   	: USINT;  { DE:"SIZEOF(String extracted)" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysSTRINGtoINT : INT
	{ DE:" On success, the function returns the converted integral number
as an INT value. If no valid conversion could be performed, a zero value
is returned.If the correct value is out of the range of representable values,
an invalid number is returned.
" }

	VAR_INPUT
		msg  : STRING; { DE:"String to convert" }
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysUART_init : BOOL
	{ DE:" Init serial port for custom protocol implementation using sysUART_putbuff() and sysUART_getbuff().  

Serial port allowed: 
 0=RS485 On-Board 2
 1=RS485 or RS232 Plug-In
 2=RS485 On-Board 1

Baud allowed:
 4800   [b/s]
 9600   [b/s]
 19200  [b/s]
 38400  [b/s]
 57600  [b/s]
 76800  [b/s]
 115200 [b/s]
 		
Configuration	value allowed:
(0x02)	= 7 data bits no parity one stop bit		 
(0x03)	= 8 data bits no parity one stop bit		 
(0x06)	= 7 data bits no parity two stop bits	
(0x07)	= 8 data bits no parity two stop bits		 
(0x0A)	= 7 data bits odd Parity one stop bit		 
(0x0B)	= 8 data bits odd Parity one stop bit		 
(0x0E)	= 7 data bits odd Parity two stop bits	 
(0x0F)	= 8 data bits odd Parity two stop bits	 
(0x1A)	= 7 data bits even Parity one stop bit	 
(0x1B)	= 8 data bits even Parity one stop bit	 
(0x1E)	= 7 data bits even Parity two stop bits	 
(0x1F)	= 8 data bits even Parity two stop bits	 
	
The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done! This can be due to:
		-parameter num is out of range
		-parameter baud is out of range
		-parameter cnf is out of range
		-serial port num configured to work as Modbus RTU master in Connection
		-serial port already configured

NOTE: Once the function has been called, the serial settings can't be changed runtime anymore. 
A reboot is required to load new settings.

" }

	VAR_INPUT
		num  : USINT; { DE:"Serial port number: 0=RS485 On-Board 2, 1=RS485 or RS232 Plug-In, 2=RS485 On-Board 1" }
		baud : UDINT; { DE:"Baud: 4800,9600,19200,38400,57600,76800,115200 [b/s]" }		
		cnf  : USINT; { DE:"Configuration: see function description" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysUART_putbuff : BOOL
	{ DE:" Put buffer to transmit into serial port. Serial port must been configured successfully using 
sysUART_init() function. The programmer is in charge to use the same port num used in sysUART_init() function.

Serial port allowed: 
 0=RS485 On-Board 2
 1=RS485 or RS232 Plug-In
 2=RS485 On-Board 1 

The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done! This can be due to:
		-The serial port is not initialized, call first the sysUART_init.
		-The serial is busy to transmit. Wait till the end of the ongoing TX process.
		
" }

	VAR_INPUT
		num  : USINT; { DE:"Serial port number: 0=RS485 On-Board 2, 1=RS485 or RS232 Plug-In, 2=RS485 On-Board 1" }
		buff : @BYTE; { DE:"Buffer to transmit" }		
		len  : UINT;  { DE:"Length of the buffer to transmit" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysUART_getbuff : BOOL
	{ DE:" Gut buffer received into serial port. Serial port must been configured using 
sysUART_init() function. The programmer is in charge to use the same port num used in sysUART_init() function.
The execution of this function is not linked to an interrupt, if it runs in background it might be suspended by Timed 
or other tasks related to serial management. 
The performance that can be obtained using this function are strictly linked to the load of the application running and of the other serials.

Serial port allowed: 
 0=RS485 On-Board 2
 1=RS485 or RS232 Plug-In
 2=RS485 On-Board 1 
 
The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done! This can be due to:
		-The serial port is not initialized, call first the sysUART_init.
		-The Timeout expired without receiving the expected data lenght.
		
" }

	VAR_INPUT
		num  : USINT; { DE:"Serial port number: 0=RS485 On-Board 2, 1=RS485 or RS232 Plug-In, 2=RS485 On-Board 1" }
		buff : @BYTE; { DE:"Buffer to be received" }		
		len  : UINT;  { DE:"Length of the buffer to be received" }		
		to   : UINT;  { DE:"Timeout [ms]" }				
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysSMTP_SendEmail : USINT
	{ DE:" Send an email.
Calling this function an email will be sended.	
To monitor the sending progress the function has to be called again. 
During the sending process its parameters must not be changed.
To send again another email (or the same) the function sysSMTP_Reset() 
has to be called one time before sysSMTP_SendEmail().

The function return a USINT which could have the following meanings:
0	=	Idle state
1	=	Email sending request activated
2	=	No file found, abort sending
3	=	Email sending on going
4	=	Email successfully sent
5	=	Mail Server timeout , try again.
6	=	Error sending email
" }

	VAR_INPUT
		ip	: @BYTE; { DE:"Ip address of the SMTP server" }		
		port	: UINT;  { DE:"SMTP port allowed by SMTP server" }	
		from	: STRING; { DE:"email address of the sender" }
		to	:  STRING; { DE:"email address of the recipient" }
		user	: STRING; { DE:"User name for authentication" }
		psw	: STRING; { DE:"Password for authentication" }
		sub	: STRING; { DE:"Email subject" }
		msg	: STRING; { DE:"Email text message" }	
		filename : STRING; { DE:"File name of the file to be printed into the email" }				
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysSMTP_Reset  : BOOL
	{ DE:" Reset SMTP Finite State Machine.
See also sysSMTP_SendEmail().

The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done! Wait and retry.
" }

	VAR_INPUT
		dummy : USINT; { DE:"Dummy" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysDNS_GetIpByName  : USINT
	{ DE:" Get IP address from host name.
Calling this function the IP address of the host will be searched.
To monitor the searching progress the function has to be called again. 
During the searching process the host name must not be changed.
To search again another IP, or the same, the function sysDNS_Reset() 
has to be called one time before sysDNS_GetIpByName().

The function return a USINT which could have the following meanings:
0	=	Idle state
1	=	Host Address searcing request activated
2	=	Host Address searcing on going
3	=	Host Address successfully resolved
4	=	All DNS Resolver retries used up and timeouts expired
5	=	DNS Protocol Error, invalid or corrupted reply received
6	=	Host Name does not exist in DNS record database 

" }

	VAR_INPUT
		name : STRING; { DE:"Host name to resolve" }
		ip : @BYTE; { DE:"Ip address of the Host" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysDNS_Reset   : BOOL
	{ DE:" Reset DNS Finite State Machine.
See also sysDNS_GetIpByName().

The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done! Wait and retry.
" }

	VAR_INPUT
		dummy : USINT; { DE:"Dummy" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysBridge : BOOL
	{ DE:" Enable/Disable bridge function for each modbus RTU slave.
Any slave modbus RTU node defined in a Connection project can be 
achieved by modbus TCPIP  using modbus commands 0x03 and 0x10.
If the slave node is a member of this product family , it can be 
achieved using software in modbus TCP/IP.
To achieve the node is necessary enable the bridge function for it
and it can be done calling the function sysBridge() passing it's node
number and enable set to TRUE. To remove the node call sysBridge() 
passing it's node number and enable set to FALSE.If all the nodes
can be achieved is sufficient to call the function sysBridge() passing
node=255 and enable=TRUE. To disable all node=255 and enable=FALSE.
In modbus TCP/IP to achieve a node, i.e. node=2, is sufficeint to
set ID to 2 instead of 255.

The function return a BOOL which could have the following meanings:
TRUE = Done.
FALSE = Not done! Node value not allowed.
" }

	VAR_INPUT
		node	: USINT; { DE:"node value [0...127] and [255]" }		
		enable	: BOOL;  { DE:"TRUE=Enable, FALSE=Disable" }	
		tmo1	: UINT; { DE:"Timeout for Read Registers command [ms]" }
		tmo2	: UINT; { DE:"Timeout for Write Registers command [ms]" }
		tmo3	: UINT; { DE:"Timeout for Packet command [ms]" }
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysHTTP_Authentication : USINT
               { DE:" Configure Web server authentication parameters.

This function allows to modify Web server username and password. 

In order to restore the factory cybersecurity level call this function with username='administrator', password='password' and realm equal to the 
the MAC address of the controller (written in hex uppercase format: '00:18:BB:XX:XX:XX').
After the reboot of the PLC, unsecure protocols are disabled until the web password will be modified. 

This function returns a USINT with the following meaning:
0 = Web credentials successfully updated.
251 = Web credentials not correctly updated.
253 = Web credentials not updated: password too long.
254 = Web credentials not updated: username too long.
255 = Web credentials not updated: realm too long.
" }


	VAR_INPUT
		realm	: STRING; { DE:"Web server realm string, max 19 chars" }		
		user	: STRING; { DE:"Web server user name string, max 15 chars" }		
		psw	: STRING; { DE:"Web server password string, max 15 chars" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysHTTP_ListableFilesExt : USINT
	{ DE:" Load/Clear extension list for listable file from Web browser.
Calling this function with action=TRUE the extension ext, if possible, will
be put into the list of the listable files from the Web browser. No more than
tree extensions can be put into the list. Calling this function with 
action=FALSE will clear the list, so no files will be listable by the browser.
At power on the extensions list is empty.
Extension must be written in upper case.

The function return a USINT which could have the following meanings:
0 = Extension correctly loaded into the extension list.
255 = Extension too long, extension not loaded into extension list.
254 = Extension list full, extension not loaded into extension list.
" }

	VAR_INPUT
		action	: BOOL; { DE:"TRUE=put the externsion into the list, FALSE=clear all list" }	 		
		ext	: STRING; { DE:"File's extension string, max 3 chars" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

(*
FUNCTION sysTFTP_Enabling : BOOL
	{ DE:" Enable/Disable TFTP function.
Calling this function with enable=TRUE the TFTP server will be enabled.
Calling this function with enable=FALSE the TFTP server will be disabled.
At power on TFTP is disabled.

NOTE: carefully has to be taken passing FALSE to the function. Infact
a TFTP session that involve more then one file is in progress it could 
be fail.

The function return a BOOL which could have the following meanings:
TRUE = Done.
" }

	VAR_INPUT
		enable	: BOOL; { DE:"TRUE=Enable, FALSE=Disable" }	 		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION
*)

FUNCTION sysAnswerDelayIncTime : BOOL
	{ DE:" Increment answer delay for Micronet and/or Modbus RTU and ASCII protocols.
Calling this function is possible to increment the answer delay for Micronet
and/or Modbus RTU and ASCII protocols when used in slave mode.          
It can be called every time is necessary. The increment value (delay) is lost
every power-on and the value can be changed run-time.

The function return a BOOL which could have the following meanings:
TRUE = Done.
FALSE = Not done! Error in parameters limits.
" }

	VAR_INPUT
		protocol	:	USINT; { DE:"2=Micronet, 3=Modbus" }	 		
		delay	:	UINT; { DE:"Increment in answer delay [0...10000ms]" }	 				
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysDataPush_Start : USINT
	{ DE:" Start data push connection.
Calling this function a Data Push connection will be estabilished.
	1)a connection to the remote server is requested.
	2)if estabilished controller send its identification string.
	3)if match string is NULL controller wait Modbus TCP-IP frames from remote server,
	otherwise controller wait the match string from remote server. If match is ok
	controller wait Modbus TCP-IP frames from remote server.
To monitor its progress the function has to be called again. 
During the data push process its parameters must not be changed.
To achieve another Data Push session the function sysDataPush_Reset() 
has to be called before sysDataPush_Start().

The function return a USINT which could have the following meanings:

0x00 = Idle state, only in this state the function starts Data Push procedure 
0x01 = Get socket
0x02 = Connection request 
0x03 = Identification string: tx request
0x04 = Identification string: ack arrived
0x05 = Match string from remote server: wait rx
0x06 = Match string from remote server: string arrived
0x07 = Channel open for remote server, Modbus TCP-IP communication can accour
0x08 = Channel close for remote server, Modbus TCP-IP communication can't accour (or undeflow)
0x09 = Channel aborted for remote server, Modbus TCP-IP communication can't accour (or undeflow)
0x0A = Get socket failed
0x0B = Connection failed
0x0C = Connection timeout
0x0D = Identification string: tx request timeout (10 sec.)
0x0E = Match string from remote server: wait rx timeout (10 sec.)
0x0F = Match string from remote server doesn't match
0x11 = Ethernet Plug-In not present
0x12 = Identification string too long
0x13 = Match string too long
0x14 = Reinit request

NOTE: underflow accour if Modbus TCP-IP interframing time is greater then tmo.
" }

	VAR_INPUT
		ip	: @BYTE; { DE:"Ip address of the remote server " }		
		port	: UINT;  { DE:"Port allowed by remote server" }	
		ident	: STRING; { DE:"Identification string, max 32 chars" }
		match	: STRING; { DE:"Match string, max 32 chars" }	
		tmo	: UINT;  { DE:"Underflow timeout in seconds [0...65535]" }	
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysDataPush_Reset  : USINT
	{ DE:" Reset Data Push Finite State Machine.
Calling this function a Data Push connection will be resetted.
To monitor its progress the function has to be called again. 	
The function can request a Data Push reinit (0x14) only 
if sysDataPush_Start() return codes from 0x07 to 0x13, otherwise
it will not have effect.
The function sysDataPush_Start() can be called when sysDataPush_Reset()
return idle state (0x00).
See also sysDataPush_Start(). 

The function return a USINT which could have the following meanings:
0x00 = Idle state 
0x14 = Reinit request
" }

	VAR_INPUT
		dummy : USINT; { DE:"Dummy" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysWriteDbgMsg  : BOOL
	{ DE:" Print debug message.
" }

	VAR_INPUT
		level : UINT;
		str : STRING; 
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysSNTP_GetTime: USINT
	{ DE:" Get UTC time from SNTP server.
Calling this function the UTC time will be provided.
To monitor the searching progress the function has to be called again. 
During the searching process the port and ip address must not be changed.
In Unicast mode:
To search again a refresh of the UTC the function sysSNTP_Reset() 
has to be called one time before sysSNTP_GetTime().
In Multicast mode:
To refrech the UTC, function sysSNTP_GetTime() has to be called continuously.
If SNTP server address is setted to (0,0,0,0) then the massages from any
SNTP server are accepted

The function return a USINT which could have the following meanings:
0	=	Idle state
1	=	UTC time search request activated => second, minute,hour,day,month and year are setted at 0
2	=	UTC time searcing on going
3	=	UTC time was found => second, minute,hour,day,month and year are valid
5	=	Error
6	=	Error, mode not swithed

" }

	VAR_INPUT
		isMulticast:	BOOL;   { DE:"FALSE=Unicast; TRUE=Multicast; Unicast active from reset"}
		port:		UINT;   { DE:"SNTP port" }		
		addr_1 :	USINT;  { DE:"SNTP server address part 1" }
		addr_2 :	USINT;  { DE:"SNTP server address part 2" }
		addr_3 :	USINT;  { DE:"SNTP server address part 3" }
		addr_4 :	USINT;  { DE:"SNTP server address part 4" }		
		second : 	@USINT; { DE:"second [0..59]" }	
		minute: 	@USINT; { DE:"minute [0..59]" }	
		hour: 		@USINT; { DE:"hour [0..23]" }	
		day: 		@USINT; { DE:"day [1..31]" }	
		month: 		@USINT; { DE:"month [1..12]" }	
		year:	 	@USINT; { DE:"year [00..99]" }	
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysSNTP_Reset   : BOOL
	{ DE:" Reset SNTP Finite State Machine.
See also sysSNTP_GetTime().

The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done! Wait and retry.
" }

	VAR_INPUT
		dummy : USINT; { DE:"Dummy" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysFTP_ClientCommand: USINT
	{ DE:" Realize a connection with an FTP server setted in PASSIVE MODE.
Calling this function is possible to realize the following command:
0 = Puts a file on FTP server               
1 = Retrieves a file from FTP server        
2 = Append file on FTP server (with create) 
3 = Deletes a file on FTP server            
6 = Makes a directory on FTP server         
7 = Removes an empty directory on FTP server
To command again the function sysFTP_ClientCommand() 
has to be called one time before sysFTP_ClientCommand().

The function return a USINT which could have the following meanings:
0 =  Idle, no operation on going.
1 =  Request event.
2 =  Request on going
3 =  Operation succesfully ended
4 =  Error, an input parameter is out of range
5 =  Error, request rejected because FTP is busy
6 =  Error, timeout on file operation              
7 =  Error, login error, username/password invalid 
8 =  Error, file access not allowed                
9 =  Error, file not found                         
10 = Error, working directory path not found      
11 = Error, local file open/write error           
12 = Error, generic FTP client error              
" }

	VAR_INPUT
		user	: STRING; { DE:"FTP server user name string" }		
		psw	: STRING; { DE:"FTP server password string" }	
		port	: UINT;   { DE:"FTP server port" }		
		addr_1  : USINT;  { DE:"FTP server address part 1" }
		addr_2  : USINT;  { DE:"FTP server address part 2" }
		addr_3  : USINT;  { DE:"FTP server address part 3" }
		addr_4  : USINT;  { DE:"FTP server address part 4" }	
		command : USINT;  { DE:"Command requested, see above" }	
		vc      : USINT;  { DE:"FTP Client volume 0=NOR Flash,1=microSD" }
		fnc     : STRING; { DE:"FTP Client file name" }
		ds      : STRING; { DE:"FTP Server directory" }
		fns     : STRING; { DE:"FTP Server file name" }
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysFTP_ClientReset: BOOL
	{ DE:" Reset FTP client Finite State Machine.
See also sysFTP_ClientCommand().

The function return a BOOL which could have the following meanings:
TRUE	=	Done.
FALSE	=	Not done! Wait and retry.
" }

	VAR_INPUT
		dummy : USINT; { DE:"Dummy" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysFTP_Authentication : USINT
	{ DE:" Configure FTPserver authentication parameters.
Calling this function FTP server user name and password will be reloaded
at the requested values.If this function is not called user name and 
password will be loaded as follow: 'administrator', 'password'.

The function return a USINT which could have the following meanings:
0 = Parameters correctly reloaded.
254 = User name string too long, no parameters reloaded.
253 = Password string too long, no parameters reloaded.
252 = Login not active or not enabled to use this function. 
251 = New credential not saved correctly
" }

	VAR_INPUT
		user	: STRING; { DE:"FTP server user name string, max 15 chars" }		
		psw	: STRING; { DE:"FTP server password string, max 15 chars" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysFTP_AuthentOnOff: USINT
	{ DE:"The function enables or disables the user authentication on the FTP server.
It takes place only if HTTP administator password was changed at first access.

Input values:
TRUE  Enable authentication	
FALSE Disable authentication	

Output values: 
- 0 Done
- 1 Already in the required state

	" }
	VAR_INPUT
	  login	:	BOOL; { DE:"TRUE=Enable authentication, FALSE=Disable authentication" }	
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysFTP_Service: USINT
	{ DE:"Start/Stop FTP service.

This function can be called periodically.

Input values:
0 Service STOP request	
1 Service START request	

Output values: 
- 0 Service Stopped
- 1 Service Started
- 255 Error input out of range (no action) or not enabled to use this function.
- 254 Service was already not running.
- 253 Service was already running.


	" }
	VAR_INPUT
	  action	:	USINT; { DE:"0=STOP, 1=START" }	
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION


FUNCTION sysFTP_AcceptClient: USINT
	{ DE:" Accept connection from a list of remote FTP clients by their IP address.
The list can handle up to three IP addresses. An IP address is linked to a node index.
Allowed node indexes are 1, 2 and 3. If the list is empty (resetted) the FTP server
accept any FTP client. If node index value 0 is used then all the three IP listed will 
be resetted (emptying the list).

The function returns a USINT which could have the following meanings:
0 = Parameters correctly loaded.
255 = node number greter than max limit
" }

	VAR_INPUT
		node:		USINT;  { DE:"node index [0...3], 0=reset" }		
		addr_1 :	USINT;  { DE:"FTP server address part 1" }
		addr_2 :	USINT;  { DE:"FTP server address part 2" }
		addr_3 :	USINT;  { DE:"FTP server address part 3" }
		addr_4 :	USINT;  { DE:"FTP server address part 4" }
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysFTP_AuthentGuest: USINT
	{ DE:" Configure guest FTP server authentication parameters.
Calling this function is possible to add in FTP server handling the
manage of up to 3 guests (in addition to admimistrator). Every guest has
its own index (from 1 to 3), its user n252 = Password string too long, no parameters loaded.
ame and password. 
It is possible to add up to 10 files name (8.3 format). 
Everyone has its attribute (READ,WRITE both).
If guest index is set to 0 all guest lists will be resetted.

The function returns a USINT which could have the following meanings:
0 = Parameters correctly loaded.
255 = Guest id number greter than max limit
254 = User name string too long, no parameters loaded.
253 = Password string too long, no parameters loaded.
252 = Not enabled to use this function.
251 = New credential not saved correctly.
" }

	VAR_INPUT
		guest_id	: USINT;  { DE:"guest index [0...3], 0=reset" }	
		user		: STRING; { DE:"FTP server user name string, max 15 chars" }		
		psw		: STRING; { DE:"FTP server password string, max 15 chars" }		
		fname1  	: STRING; { DE:"1st File name string, max 12 chars" }		
		fname2  	: STRING; { DE:"2nd File name string, max 12 chars" }		
		fname3  	: STRING; { DE:"3rd File name string, max 12 chars" }		
		fname4  	: STRING; { DE:"4th File name string, max 12 chars" }		
		fname5  	: STRING; { DE:"5th File name string, max 12 chars" }		
		fname6  	: STRING; { DE:"6th File name string, max 12 chars" }		
		fname7  	: STRING; { DE:"7th File name string, max 12 chars" }		
		fname8  	: STRING; { DE:"8th File name string, max 12 chars" }		
		fname9  	: STRING; { DE:"9th File name string, max 12 chars" }		
		fname10 	: STRING; { DE:"10th File name string, max 12 chars" }	
		fatt1  		: USINT;  { DE:"1st File attribute 1=READ 2=WRITE 3=READ or WRITE" }		
		fatt2  		: USINT;  { DE:"2nd File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
		fatt3  		: USINT;  { DE:"3rd File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
		fatt4  		: USINT;  { DE:"4th File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
		fatt5  		: USINT;  { DE:"5th File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
		fatt6  		: USINT;  { DE:"6th File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
		fatt7  		: USINT;  { DE:"7th File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
		fatt8  		: USINT;  { DE:"8th File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
		fatt9  		: USINT;  { DE:"9th File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
		fatt10  	: USINT;  { DE:"10th File attribute 1=READ 2=WRITE 3=READ or WRITE"  }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysFTP_ProtectFiles : BOOL
	{ DE:" Hide all the files for FTP. 
If its parameter is TRUE then all files will be protected, otherwise this protection is removed.
In any case setting of sysFTP_AuthentGuest() function override sysFTP_ProtectFiles() 
protection even if activated.

The function return always TRUE.
" }

	VAR_INPUT
		toProtect: BOOL; { DE:"if TRUE FTP files will be protected, otherwise not" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysHTTP_Service: USINT
	{ DE:"Start/Stop HTTP service.

This function can be called periodically.

Input values:
0 Service STOP request	
1 Service START request	

Output values: 
- 0 Service Stopped
- 1 Service Started
- 255 Error input out of range (no action) or not enabled to use this function.
- 254 Service was already not running.
- 253 Service was already running.


	" }
	VAR_INPUT
	  action	:	USINT; { DE:"0=STOP, 1=START" }	
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION



FUNCTION sysHTTP_AcceptClient: USINT
	{ DE:" Accept connection from a list of remote HTTP clients by their IP address.
The list can handle up to three IP addresses. An IP address is linked to a node index.
Allowed node indexes are 1, 2 and 3. If the list is empty (resetted) the web server
accept any HTTP client. If node index value 0 is used then all the three IP listed will 
be resetted (emptying the list).

The function returns a USINT which could have the following meanings:
0 = Parameters correctly loaded.
255 = node number greter than max limit
" }

	VAR_INPUT
		node:		USINT;  { DE:"node index [0...3], 0=reset" }		
		addr_1 :	USINT;  { DE:"Network address part 1" }
		addr_2 :	USINT;  { DE:"Network address part 2" }
		addr_3 :	USINT;  { DE:"Network address part 3" }
		addr_4 :	USINT;  { DE:"Network address part 4" }
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysHTTP_AuthentGuest: USINT
	{ DE:" Configure guest Web server authentication parameters.
Calling this function is possible to add in web server handling the
manage of up to 3 guests (in addition to admimistrator). Every guest has
its own index (from 1 to 3), its user name and password and the possibility
to redirect its index file. For instance if its_index is TRUE and gust_id is 1
when the browser call the index.htm file the server answer with index1.htm.
It is possible to add up to 10 files name (8.3 format). If one of this file is
requested by a guest configured connection, it will not be
sent by the server. The message will be 'Error 403-Forbidden'.
If guest index is set to 0 all guest lists will be resetted.

The function returns a USINT which could have the following meanings:
0 = Parameters correctly loaded.
255 = Guest id number greter than max limit
254 = User name string too long, no parameters loaded.
253 = Password string too long, no parameters loaded.
251 = new credential not saved correctly.
" }

	VAR_INPUT
		guest_id	: USINT;  { DE:"guest index [0...3], 0=reset" }	
		its_index	: BOOL;   { DE:"TRUE=index<guest_id>.htm, FALSE=index<guest_id>.htm" }	
		user		: STRING; { DE:"Web server user name string, max 15 chars" }		
		psw		: STRING; { DE:"Web server password string, max 15 chars" }		
		fname1  	: STRING; { DE:"1st File name string, max 12 chars" }		
		fname2  	: STRING; { DE:"2nd File name string, max 12 chars" }		
		fname3  	: STRING; { DE:"3rd File name string, max 12 chars" }		
		fname4  	: STRING; { DE:"4th File name string, max 12 chars" }		
		fname5  	: STRING; { DE:"5th File name string, max 12 chars" }		
		fname6  	: STRING; { DE:"6th File name string, max 12 chars" }		
		fname7  	: STRING; { DE:"7th File name string, max 12 chars" }		
		fname8  	: STRING; { DE:"8th File name string, max 12 chars" }		
		fname9  	: STRING; { DE:"9th File name string, max 12 chars" }		
		fname10 	: STRING; { DE:"10th File name string, max 12 chars" }		
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysHTTP_AuthentOnOff: USINT
	{ DE:"The function enables or disables the user authentication on the HTTP server.
It takes place only if HTTP administator password was changed at first access.

Input values:
