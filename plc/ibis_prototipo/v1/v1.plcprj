					<functionBlock name="FB_LowPassFilter" version="1.0.0" hidden="true" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV low pass filter</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="i_iInput" type="INT"/>
								<var name="i_uiCoefficient" type="UINT"/>
							</inputVars>
							<outputVars>
								<var name="q_iOutFilter" type="INT"/>
							</outputVars>
							<localVars>
								<var name="rOldOutFilter" type="REAL"/>
								<var name="rFilter" type="REAL"/>
								<var name="rAlfa" type="REAL"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
