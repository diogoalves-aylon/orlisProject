					<functionBlock name="FB_EEVDynSetpCalc" version="1.1.0" hidden="true" creationDate="0" lastModifiedDate="1622105746" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV dynamic setpoint calculation</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable the FB</descr>
								</var>
								<var name="xEnDyn" type="BOOL">
									<descr>Enable the dynamical set point calculation</descr>
								</var>
								<var name="xEnCalc" type="BOOL">
									<descr>Enable the calculation for SH control</descr>
								</var>
								<var name="xAlarm" type="BOOL">
									<descr>Blocking alarm</descr>
								</var>
								<var name="xTimerLoadEnd" type="BOOL">
									<descr>Timer high load end</descr>
								</var>
								<var name="uiSupHeatSetpOffset" type="UINT">
									<descr>Maximum set point offset</descr>
								</var>
								<var name="iSupHeatSetpMin" type="INT">
									<descr>Minimum limit super heating set point</descr>
								</var>
								<var name="uiStepSH" type="UINT">
									<descr>Set point incremental step</descr>
								</var>
								<var name="iSH" type="INT">
									<descr>Super heating measure</descr>
								</var>
								<var name="uiStepTime" type="UINT">
									<descr>Set point incremental time [s]</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="iSupHeatSetp" type="INT">
									<descr>Super heating set point</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT">
									<descr>System timer [ms]</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="xEnOld" type="BOOL"/>
								<var name="l_uiSupHeatSetpMax" type="UINT"/>
								<var name="xTimeTrig" type="BOOL">
									<descr>Timer trigger</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="sysTimerOld" type="UDINT">
									<descr>oldsysTimer</descr>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
