				<globalVars/>
				<retainVars/>
				<constantVars/>
				<iecVarsDeclaration/>
				<functions/>
				<functionBlocks>
					<functionBlock name="DayLightSaving" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Day light saving</title>
						<descr>&lt;HTML&gt;Changing summertime &lt;---&gt; wintertime, Zones: Europe, USA/Canada&lt;br&gt;
&lt;br&gt;
The usiZone input must be configured according to the location where the controller is used:&lt;br&gt;  
&lt;br&gt;
0: No Time Zone specified. Daylight saving functionality is disabled.&lt;br&gt; 
&lt;br&gt; 
1: Europe. Daylight saving functionality will start on last Sunday of March at 1:00 a.m. DST and end on last Sunday of October at 2:00 a.m.&lt;br&gt; 
&lt;br&gt;
2: US/Canada. Daylight saving functionality will start on second Sunday of March at 2:00 a.m. local time and end on first Sunday of November at 3:00 a.m.&lt;br&gt; 
&lt;br&gt;
&lt;br&gt;
&lt;br&gt;
The output usiStatus represents a value from 0 to 255, whereby each bit represents a status. The table contains the bits and their description:&lt;br&gt; 
0=Summer Time&lt;br&gt;
1=Winter Time&lt;br&gt; 
2...5=Reserved&lt;br&gt; 
6=usiZone input is invalid&lt;br&gt; 
7=Error in setting time&lt;br&gt;</descr>
						<vars>
							<inputVars>
								<var name="usiZone" type="USINT">
									<descr>Time zone, 0=disable, 1= Europe, 2 = US/Canada</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="usiStatus" type="USINT">
									<descr>DayLightSaving active status (0 to 255)</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClockError" type="BOOL"/>
								<var name="sysClock" type="TypeDataTime">
									<descr>System Date and Time Read. It is a structure of type TypeDataTime composed 
by the following fields:
	seconds		: USINT; seconds [0...59]
	minutes		: USINT; minutes [0...59] 
	hours		: USINT; hours [0...23]
	dayweek		: USINT; day of week [0...6]
	daymonth		: USINT; day of month [1...31]
	month		: USINT; month [1...12]
	year		: USINT; year [10...99]</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="xlSt" type="BOOL"/>
								<var name="xlWt" type="BOOL"/>
								<var name="xlRes6" type="BOOL"/>
								<var name="xlRes7" type="BOOL"/>
								<var name="xlRes8" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="xlRes9" type="BOOL"/>
								<var name="xlAlrm" type="BOOL"/>
								<var name="xlValid" type="BOOL"/>
								<var name="xlStSet" type="BOOL"/>
								<var name="xlWtSet" type="BOOL"/>
								<var name="xlZone" type="BOOL"/>
								<var name="xla" type="BOOL"/>
								<var name="xlb" type="BOOL"/>
								<var name="xlc" type="BOOL"/>
								<var name="xld" type="BOOL"/>
								<var name="xle" type="BOOL"/>
								<var name="usiPrev" type="USINT" dim0="4"/>
								<var name="usilZoneOld" type="USINT"/>
								<var name="usilDiff" type="USINT"/>
								<var name="stlDateTime" type="TypeDataTime"/>
								<var name="stlDateTimeNew" type="TypeDataTime"/>
								<var name="dtlDateTimeWrite" type="TypeDataTime"/>
								<var name="usilDay" type="USINT"/>
								<var name="usilMonth" type="USINT"/>
								<var name="usilYear" type="USINT"/>
								<var name="usilHour" type="USINT"/>
								<var name="usilMin" type="USINT"/>
								<var name="usilSec" type="USINT"/>
								<var name="usilWeekday" type="USINT"/>
								<var name="xlIsFirstMain" type="BOOL"/>
								<var name="Poubelle" type="USINT"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
