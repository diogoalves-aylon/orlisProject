					<functionBlock name="ECBlueBasicRampTiming" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB can be used to set the Ramp Timing parameter (h25, reg26).

After the call of the FB, a PIN/motor reset can be executed by using the related FB. This allows news settings to be taken over.

The configuration message is sent when a transition of xEn from FALSE to TRUE takes place.

The output provides the info on whether the operation has been successful or not.

The ECBlueBasicRampTiming AFB must be put inside the Background task of the PLC.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Transition FALSE -&gt; TRUE changes the settings in the fan.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_usiZiehlAddress" type="USINT">
									<descr>Ziehl Fan Address. Broadcast not suppoted. Default: 1.</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_xRW" type="BOOL">
									<descr>FALSE: Read current settings. TRUE: Write new settings.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_uiRampUpTime" type="UINT">
									<descr>RampUp Time / s, e.g. ECblue 152 = 20 (depending on device type)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiRampDownTime" type="UINT">
									<descr>RampDown Time / s, e.g. ECblue 116 = 20 (depending on device type)</descr>
									<initValue>0</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xChanged" type="BOOL">
									<descr>TRUE if the ControlMode parameter has been successfully changed.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xWorking" type="BOOL">
									<descr>ControlMode Change Operation in progress.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xFailed" type="BOOL">
									<descr>ControlMode Change has failed.</descr>
								</var>
								<var name="q_xWrongInputs" type="BOOL">
									<descr>Inputs out of range</descr>
								</var>
								<var name="q_uiRampUpC" type="UINT">
									<descr>Current RampUp Time Setting</descr>
									<initValue>65535</initValue>
								</var>
								<var name="q_uiRampDownC" type="UINT">
									<descr>Current RampDown Time Setting</descr>
									<initValue>65535</initValue>
								</var>
								<var name="q_xRead" type="BOOL">
									<descr>Successfully read current parameters</descr>
									<initValue>FALSE</initValue>
								</var>
							</outputVars>
							<localVars>
								<var name="i" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="xEn_old" type="BOOL"/>
								<var name="MsgNum" type="USINT">
									<initValue>10</initValue>
								</var>
								<var name="uiTargetAddr" type="UINT"/>
								<var name="uiRet_CMODE" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_CMODE_Check" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="j" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="k" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="uiRet_PIN" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="iPINL2" type="INT">
