					<functionBlock name="ECBlueBasicErrorStatus" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB converts the WORD i12, iReg=13, Error status into booleans that provide info on the fan error status.</descr>
						<vars>
							<inputVars>
								<var name="i_wErrorStatus" type="WORD">
									<descr>Error Status WORD. iReg=13.</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xIGBTFault" type="BOOL">
									<descr>TRUE: IGBT FAULT</descr>
								</var>
								<var name="q_xEarth2GroundF" type="BOOL">
									<descr>TRUE: EARTH TO GROUND FAULT</descr>
								</var>
								<var name="q_xUZKHI" type="BOOL">
									<descr>TRUE: UZK HI</descr>
								</var>
								<var name="q_xUZKLO" type="BOOL">
									<descr>TRUE: UZK LO</descr>
								</var>
								<var name="q_xUINHI" type="BOOL">
									<descr>TRUE: UIN HI (from FW10)</descr>
								</var>
								<var name="q_xUINLO" type="BOOL">
									<descr>TRUE: UIN LO (from FW10)</descr>
								</var>
								<var name="q_xLineFault" type="BOOL">
									<descr>TRUE: LINE FAULT</descr>
								</var>
								<var name="q_xTB" type="BOOL">
									<descr>TRUE: TB (reserved for PMblue etc.)</descr>
								</var>
								<var name="q_xHallSens" type="BOOL">
									<descr>TRUE: HALLSENSOR</descr>
								</var>
								<var name="q_xMotorBlock" type="BOOL">
									<descr>TRUE: MOTOR BLOCKED</descr>
								</var>
								<var name="q_xPeakCurr" type="BOOL">
									<descr>TRUE: PEAK CURRENT (from FW10)</descr>
								</var>
								<var name="q_xSineFilter" type="BOOL">
									<descr>TRUE: Sinefilter (only Fcontrol)</descr>
								</var>
								<var name="q_xSafetyShutdown" type="BOOL">
									<descr>TRUE: Safety Shutdown (max. electronic Current, from FW13)</descr>
								</var>
								<var name="q_xTempErr" type="BOOL">
									<descr>TRUE: Temperature error</descr>
								</var>
								<var name="q_xMotorStart" type="BOOL">
									<descr>TRUE: Motor Start</descr>
								</var>
								<var name="q_xCOMerr" type="BOOL">
									<descr>TRUE: COM error (Watchdog)</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="conv" type="WordToBit"/>
								<var name="InfoOpCd1" type="ECBlueBasicInfoOpCd1"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
