									<initValue>16777215</initValue>
								</var>
								<var name="MASKBIT_26" type="UDINT">
									<descr>Enumeration</descr>
									<initValue>67108864</initValue>
								</var>
								<var name="MASKBIT_27" type="UDINT">
									<descr>Enumeration</descr>
									<initValue>134217728</initValue>
								</var>
								<var name="MASKBIT_28" type="UDINT">
									<descr>Enumeration</descr>
									<initValue>268435456</initValue>
								</var>
								<var name="MASKBIT_29" type="UDINT">
									<descr>Enumeration</descr>
									<initValue>536870912</initValue>
								</var>
								<var name="MASKBIT_30" type="UDINT">
									<descr>Enumeration</descr>
									<initValue>1073741824</initValue>
								</var>
								<var name="MASKBIT_31" type="UDINT">
									<descr>Enumeration</descr>
									<initValue>2147483648</initValue>
								</var>
								<var name="l_udiMinOnTimerEt" type="UDINT">
									<descr>MinOnTimerElapsedTime</descr>
									<initValue>0</initValue>
								</var>
								<var name="l_udiMinOffTimerEt" type="UDINT">
									<descr>MinOffTimerElapsedTime</descr>
									<initValue>0</initValue>
								</var>
								<var name="l_udiMinCycleTimerEt" type="UDINT">
									<descr>MinCycleTimerElapsedTime</descr>
									<initValue>0</initValue>
								</var>
								<var name="l_udiOpHoursEt" type="UDINT">
									<descr>OperatingHoursTimerElapsedTime</descr>
									<initValue>0</initValue>
								</var>
								<var name="l_udiMinOnTimerEt_Old" type="UDINT">
									<descr>OldMinOnTimerElapsedTime</descr>
									<initValue>0</initValue>
								</var>
								<var name="l_udiMinOffTimerEt_Old" type="UDINT">
