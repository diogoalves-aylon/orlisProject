					</functionBlock>
					<functionBlock name="HPDefrCircuitPriority" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Heat Pump Defrost Circuit Priority</title>
						<descr>&lt;HTML&gt;The HPDefrCircuitPriority function manages the defrost priority and timing in a double circuit heat pump.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable/Disable the function block</descr>
								</var>
								<var name="usiDefrostType" type="USINT">
									<descr>Type of defrost (0=disable defrosts, 1=synchronous, 2=asynchronous, 3=independent)</descr>
								</var>
								<var name="uiTimeBetweenDefrosts" type="UINT">
									<descr>Minimum time between two defrosts (min)</descr>
								</var>
								<var name="usiStatusDefrCir1" type="USINT"/>
								<var name="usiStatusDefrCir2" type="USINT"/>
							</inputVars>
							<outputVars>
								<var name="xEnDefrCir1" type="BOOL">
									<descr>Enable defrost on circuit 1</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="xEnDefrCir2" type="BOOL">
									<descr>Enable defrost on circuit 2</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="xStartDefrostCir1" type="BOOL">
									<descr>Force start defrost on circuit 1</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="xStartDefrostCir2" type="BOOL">
									<descr>Force start defrost on circuit 2</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="uiTimerDefrostDelay" type="UINT">
									<descr>Timer delay next defrost (min)</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT"/>
							</externalVars>
							<localVars>
								<var name="l_xDefrostWaitTimerQCir1" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_xDefrostWaitEnCir1" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_udiDefrostWaitTimerPt" type="UDINT"/>
								<var name="l_udiDefrostWaitTimerEt_OldCir1" type="UDINT"/>
								<var name="l_udiDefrostWaitTimerEtCir1" type="UDINT"/>
								<var name="sysTimer_Old" type="UDINT"/>
								<var name="l_xDefrostWaitResetCir1" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_xDefrostWaitTimerQCir2" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_xDefrostWaitEnCir2" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_udiDefrostWaitTimerEt_OldCir2" type="UDINT"/>
								<var name="l_udiDefrostWaitTimerEtCir2" type="UDINT"/>
								<var name="l_xDefrostWaitResetCir2" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="uiTimerDefrostDelayCir1" type="UINT">
									<initValue>0</initValue>
								</var>
								<var name="uiTimerDefrostDelayCir2" type="UINT">
									<initValue>0</initValue>
								</var>
								<var name="l_xFirstDefrost" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="xlEnOld" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="usilDefrostType" type="USINT">
									<initValue>0</initValue>
								</var>
								<var name="uilTimeBetweenDefrosts" type="UINT">
									<initValue>0</initValue>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
