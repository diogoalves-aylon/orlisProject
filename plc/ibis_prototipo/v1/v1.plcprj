					<function name="f_ECBlueBasicControlWEn" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>The output returns the new Control word to be written onto the fan.
Only the bit 0 (enable/disable fan) is modified, all the others are kept unchanged.</descr>
						<returnValue>WORD</returnValue>
						<vars>
							<inputVars>
								<var name="i_xEnableFan" type="BOOL">
									<descr>TRUE: Fan Enable. FALSE: Fan Disable. Default: FALSE.</descr>
								</var>
								<var name="i_wCurrentWORD" type="WORD">
									<descr>Current Control WORD. It is normally read from the fan.</descr>
								</var>
							</inputVars>
							<localVars>
								<var name="wTMP" type="WORD"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<sourceCode type="ST" encoded="true">
							<![CDATA[ti0R9il1tJlcBRBX08lPbwtSaq8TbTcefWaqmhJJ/iiZ95lzvJiEBvhWg8hnbBtSKq5bbN8Y
