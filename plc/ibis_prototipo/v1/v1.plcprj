					<functionBlock name="Counter2Energy" version="1.0.1" creationDate="0" lastModifiedDate="1702553793">
						<title>Counter to Energy</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable FB</descr>
								</var>
								<var name="udiPulseCnt" type="DWORD">
									<descr>Pulse count from  Pulse2Counter FB (pulses)</descr>
								</var>
								<var name="uiPulseConstant" type="UINT">
									<descr>Number of pulses per Unit Energy (pulses/kWh)</descr>
								</var>
								<var name="ptrE2_TotalActiveEnergy" type="@REAL">
									<descr>Pointer for Total Active Energy in EEPROM Area</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="rTotalActivePower" type="REAL">
									<descr>Active Power (kW)</descr>
								</var>
								<var name="rTotalActiveEnergy" type="REAL">
									<descr>Energy consumption data (kWh)</descr>
								</var>
								<var name="uiAlarmID" type="WORD">
									<descr>Alarm ID</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime"/>
								<var name="sysTimer" type="UDINT">
									<descr>SystemTimer</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="l_xSW" type="BOOL">
									<descr>Return Value of system Par Write Function</descr>
								</var>
								<var name="l_udisysTimer_old" type="UDINT">
									<descr>Old Value Of System Timer</descr>
								</var>
								<var name="l_udiElapsedTime" type="UDINT">
									<descr>Elapsed Time Of Timer</descr>
								</var>
								<var name="l_rPrevEnergy" type="REAL">
									<descr>Previous Energy</descr>
								</var>
								<var name="l_rEnergy" type="REAL">
									<descr>Calulated Energy</descr>
								</var>
								<var name="j" type="USINT">
									<descr>For Loop Variable</descr>
								</var>
								<var name="i" type="USINT">
									<descr>For Loop Variable</descr>
								</var>
								<var name="l_udiPulseCntOld" type="UDINT">
									<descr>Old Pulse Count</descr>
								</var>
								<var name="l_udiPulseCntOld_Power" type="UDINT">
									<descr>Old Pule Count For Power</descr>
								</var>
								<var name="l_udiMinPulseDelta" type="UDINT">
									<descr>Minimum Delta Between The Pulse</descr>
								</var>
								<var name="l_udiPrevPulseVal" type="UDINT" dim0="5">
									<descr>Prev Pulse Value</descr>
								</var>
								<var name="l_udiCumulativeValue" type="UDINT">
									<descr>Cummulative Value</descr>
								</var>
								<var name="l_udiRollingAverage" type="UDINT">
									<descr>Rolling Average</descr>
								</var>
								<var name="l_xFirstMain" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="xCJ_GetHourTic" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_uiHour_memo" type="UINT">
									<descr>Memo of the previous hour tic</descr>
								</var>
							</localVars>
							<localConsts>
								<const name="PULSECONSTANTLL" type="UINT">
									<descr>Low limit for pulse constant</descr>
									<initValue>1</initValue>
								</const>
								<const name="PULSECONSTANTHL" type="UINT">
									<descr>High limit for pulse constant</descr>
									<initValue>1000</initValue>
								</const>
								<const name="PRESET" type="WORD">
									<descr>Rolling AVerage Time Duration</descr>
									<initValue>60000</initValue>
								</const>
								<const name="PLSECNTLIMIT" type="REAL">
									<descr>Define for Real reg overflow</descr>
									<initValue>3.40E+38</initValue>
								</const>
								<const name="MASKBIT2" type="UINT">
									<descr>MASKBIT2 Total Active Energy</descr>
									<initValue>2</initValue>
								</const>
								<const name="MASKBIT1" type="UINT">
									<descr>Maskbit For Pulse Constant Alarm</descr>
									<initValue>1</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
