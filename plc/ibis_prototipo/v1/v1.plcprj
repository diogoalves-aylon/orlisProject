					</functionBlock>
					<functionBlock name="ThermalPowerFromEnthalpy" version="1.0.0" creationDate="0" lastModifiedDate="1729506511">
						<title>Thermal Power From Enthalpy</title>
						<descr>&lt;HTML&gt;&lt;p&gt;The ThermalPowerFromEnthalpy function calculates thermal power and thermal energy based on mass flow and on enthalpies.&lt;/p&gt;
&lt;p&gt;Energy is stored into EEprom once per hour  after enabling or reset  and when block is disabled&lt;/p&gt;

&lt;p&gt;The thermal power is calculated based on the following formula: 
&lt;br&gt;Pth =m*|Δh|
&lt;br&gt;[Pth] = g/s * kJ / kg / 1000= kW 
&lt;br&gt;with 
&lt;br&gt;m = mass flow in g/s 
&lt;br&gt;Δh = enthalpy difference in kJ / kg
&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable/Disable the function block</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="rFlow" type="REAL">
									<descr>Mass flow (g/s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="rInputEnthalpy" type="REAL">
									<descr>Input enthalpy (kJ/kg)</descr>
									<initValue>0</initValue>
								</var>
								<var name="rOutputEnthalpy" type="REAL">
									<descr>Output enthalpy (kJ/kg)</descr>
									<initValue>0</initValue>
								</var>
								<var name="ptrE2_ThermalEnergySaved" type="@REAL">
									<descr>rThermalEnergySaved pointer for EEPROM variable</descr>
									<initValue>0</initValue>
								</var>
								<var name="xReset" type="BOOL">
									<descr>Reset the calculation of the thermal energy</descr>
									<initValue>FALSE</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="rThermalPower" type="REAL">
									<descr>Thermal Power (kW)</descr>
									<initValue>0</initValue>
								</var>
								<var name="rThermalEnergy" type="REAL">
									<descr>Thermal Energy (kWh)</descr>
									<initValue>0</initValue>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT">
									<descr>SystemTimer</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="l_xFirstMain" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_xSw" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_udiSecondTimerEl" type="UDINT">
									<descr>Second Timer</descr>
								</var>
								<var name="l_udisysTimer_old" type="UDINT">
									<descr>Old  Values of system Timer</descr>
								</var>
								<var name="xRstEnergy" type="BOOL"/>
								<var name="l_xResetOld" type="BOOL">
									<descr>Old Reset Value</descr>
								</var>
								<var name="l_udiHourTimerEl" type="UDINT"/>
								<var name="l_uiAlertId" type="UINT">
									<descr>Alert ID</descr>
								</var>
								<var name="l_xIsFirstMain" type="BOOL">
									<descr>First scan  bit</descr>
								</var>
								<var name="l_rThermalEnergy" type="REAL">
									<descr>Thermal Energy</descr>
								</var>
								<var name="l_rThermalEnergyOld" type="REAL">
									<descr>Old Value of Thermal Energy</descr>
								</var>
								<var name="udiDiffTimer" type="UDINT">
									<descr>Timer difference</descr>
								</var>
							</localVars>
							<localConsts>
								<const name="SECONDTIMER" type="UDINT">
									<descr>Second Timer</descr>
									<initValue>1000</initValue>
								</const>
								<const name="HOURTIMER" type="UDINT">
									<descr>Second Timer</descr>
									<initValue>3600000</initValue>
								</const>
								<const name="MASKBIT1" type="UINT">
									<descr>Maskbit1 for alarm of Thermal power reached to max value</descr>
									<initValue>1</initValue>
								</const>
								<const name="MASKBIT2" type="UINT">
									<descr>Maskbit2 for alarm of Thermal Energy reached to max value</descr>
									<initValue>2</initValue>
								</const>
								<const name="MAXREAL" type="REAL">
									<descr>Max value of Real</descr>
									<initValue>3.40E+38</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
