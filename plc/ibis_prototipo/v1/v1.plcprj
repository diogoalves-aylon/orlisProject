					</functionBlock>
					<functionBlock name="Press2Temp" version="1.1.3" creationDate="0" lastModifiedDate="1715183117">
						<title>Pressure to temperature conversion</title>
						<descr>&lt;HTML&gt;Calculate the temperature of a refrigerant based on the refrigerant pressure and refrigerant type.&lt;br&gt;
&lt;br&gt;
usiRefState:&lt;br&gt;
&lt;br&gt;
0 Vapor (50%) + Liquid (50%) &lt;br&gt;
1 Vapor&lt;br&gt;
2 Liquid&lt;br&gt;
&lt;br&gt;
&lt;br&gt;
usiReftype:&lt;br&gt;
&lt;br&gt;
0	R22&lt;br&gt;
1	R134a&lt;br&gt;
2	R404A&lt;br&gt;
3	R407C&lt;br&gt;
4	R410A&lt;br&gt;
5	R407A&lt;br&gt;
6	R407F&lt;br&gt;
7	R290&lt;br&gt;
8	R507A&lt;br&gt;
9	R717&lt;br&gt;
10	R723&lt;br&gt;
11	R1234ze&lt;br&gt;
12	R744&lt;br&gt;
13	R448A&lt;br&gt;
14	R427A&lt;br&gt;
15	R450 (N13)&lt;br&gt;
16	R513A&lt;br&gt;
17	R449A&lt;br&gt;
18	R1234yf&lt;br&gt;
19	R454B&lt;br&gt;
20	R454C&lt;br&gt;
21	R455A&lt;br&gt;
22	R434A&lt;br&gt;
23	R442A&lt;br&gt;
24	R32 &lt;br&gt;
25	R452B&lt;br&gt;
26	R452A&lt;br&gt;
&lt;br&gt;
uiAlertID&lt;br&gt;
&lt;br&gt;
bit 0 iPress outside valid range&lt;br&gt;
bit 1 usiRefType or usiRefState not valid&lt;br&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable/Disable the function block</descr>
								</var>
								<var name="iPress" type="INT">
									<descr>Refrigerant relative pressure (*0.01 Bar)</descr>
								</var>
								<var name="usiRefType" type="USINT">
									<descr>Refrigerant type (0 to 26 Default: 0 Custom: 255)</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiRefState" type="USINT">
									<descr>Refrigerant state (0 to 2 Default: 0)</descr>
									<initValue>0</initValue>
								</var>
								<var name="arCustRefParam" type="REAL" dim0="5">
									<descr>Custom Refrigerant parameters array</descr>
								</var>
								<var name="iCustRefPressMin" type="INT">
									<descr>Custom Refrigerant minimum pressure (*0.01 Bar)</descr>
									<initValue>0</initValue>
								</var>
								<var name="iCustRefPressMax" type="INT">
									<descr>Custom Refrigerant maximum pressure (*0.01 Bar)</descr>
									<initValue>0</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="iTemp" type="INT">
									<descr>Refrigerant temperature (*0.1 °C)</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="arParam" type="REAL" dim0="5"/>
								<var name="xAlertBit0" type="BOOL"/>
								<var name="rTemp" type="REAL"/>
								<var name="iPressMin" type="INT">
									<initValue>-32760</initValue>
								</var>
								<var name="iPressMax" type="INT">
									<initValue>32760</initValue>
								</var>
								<var name="xRightGasState" type="BOOL"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
