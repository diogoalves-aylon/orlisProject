					<functionBlock name="CompMgmt" version="1.1.2" creationDate="0" lastModifiedDate="1716536925">
						<title>Compressors Management</title>
						<descr>&lt;HTML&gt;The CompMgmt (Compressor Management) function block calculates the number of compressors
required to control the water temperature or the refrigerant pressure.
&lt;p&gt;The CompMgmt (Compressor Management) function block calculates the number of compressors
required to control the water temperature or the refrigerant pressure.&lt;/p&gt;
&lt;p&gt;In a refrigeration machine, compressors need to be managed in a way to help prevent their failures
and balance machine lifetime.&lt;/p&gt;
&lt;p&gt;The CompMgmt function block controls up to 8 compressors and aims to manage the optimum
functionality of compressors. For this purpose, CompMgmt provides features for compressor failure
management and to optimize operation.&lt;/p&gt;

&lt;p&gt;The CompMgmt must be used together with the function block CompCntrl_OnOff which controls
the operation of a single compressor.&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Note:&lt;/b&gt;  If the input xQuickStop is set to TRUE, the compressor is stopped even if the timer uiMinOnTime has not elapsed. usiState is forced to idle. &lt;/p&gt;

&lt;p&gt;&amp;nbsp;&lt;/p&gt;

&lt;p&gt;&lt;b&gt;Alarm ID&lt;/b&gt;&lt;/p&gt;
&lt;table border&gt;
	&lt;tbody&gt;
		  &lt;colgroup span= 3  class= columns &gt;&lt;/colgroup&gt;
		  &lt;tr&gt;
			&lt;th&gt;Bit&lt;/th&gt;
			&lt;th&gt;Value&lt;/th&gt;
			&lt;th&gt;Description:&lt;/th&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;0&lt;/td&gt;
			&lt;td&gt;1&lt;/td&gt;
			&lt;td&gt;Number of compressors out of range&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;	
			&lt;td&gt;1&lt;/td&gt;
			&lt;td&gt;2&lt;/td&gt;
			&lt;td&gt;All compressors are in allarm&lt;/td&gt;
		  &lt;/tr&gt;
	&lt;/tbody&gt;
 &lt;/table&gt;
 
 &lt;p&gt;&lt;b&gt;Alert ID&lt;/b&gt;&lt;/p&gt;
&lt;table border&gt;
	&lt;tbody&gt;
		  &lt;colgroup span= 3  class= columns &gt;&lt;/colgroup&gt;
		  &lt;tr&gt;
			&lt;th&gt;Bit&lt;/th&gt;
			&lt;th&gt;Value&lt;/th&gt;
			&lt;th&gt;Description:&lt;/th&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;	
			&lt;td&gt;0&lt;/td&gt;
			&lt;td&gt;1&lt;/td&gt;
			&lt;td&gt;Parameter Latch&lt;/td&gt;
			&lt;/tr&gt;
		  &lt;tr&gt;
		  &lt;tr&gt;	
			&lt;td&gt;1&lt;/td&gt;
			&lt;td&gt;2&lt;/td&gt;
			&lt;td&gt;Wrong band parameter&lt;/td&gt;
			&lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;2&lt;/td&gt;
			&lt;td&gt;4&lt;/td&gt;
			&lt;td&gt;Out of range&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;	
			&lt;td&gt;3&lt;/td&gt;
			&lt;td&gt;8&lt;/td&gt;
			&lt;td&gt;Alarm compressor 1&lt;/td&gt;
			&lt;/tr&gt;
		  &lt;tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;4&lt;/td&gt;
			&lt;td&gt;16&lt;/td&gt;
			&lt;td&gt;Alarm compressor 2&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;5&lt;/td&gt;
			&lt;td&gt;32&lt;/td&gt;
			&lt;td&gt;Alarm compressor 3&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;6&lt;/td&gt;
			&lt;td&gt;64&lt;/td&gt;
			&lt;td&gt;Alarm compressor 4&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;7&lt;/td&gt;
			&lt;td&gt;128&lt;/td&gt;
			&lt;td&gt;Alarm compressor 5&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;8&lt;/td&gt;
			&lt;td&gt;256&lt;/td&gt;
			&lt;td&gt;Alarm compressor 6&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;9&lt;/td&gt;
			&lt;td&gt;512&lt;/td&gt;
			&lt;td&gt;Alarm compressor 7&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;	
			&lt;td&gt;10&lt;/td&gt;
			&lt;td&gt;1024&lt;/td&gt;
			&lt;td&gt;Alarm compressor 8&lt;/td&gt;
		  &lt;/tr&gt;

	&lt;/tbody&gt;
 &lt;/table&gt;

&lt;p&gt;&amp;nbsp;&lt;/p&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enables the function block</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="iPv" type="INT">
									<descr>Process value: water temperature or low pressure (User Unit)</descr>
								</var>
								<var name="iSetp" type="INT">
									<descr>Set point for the process value (User Unit)</descr>
								</var>
								<var name="xQuickStop" type="BOOL">
									<descr>Quick stop of all the compressors</descr>
								</var>
								<var name="usiNbComp" type="USINT">
									<descr>Number of fix speed compressors (0 to 8)</descr>
								</var>
								<var name="udiStatusC1" type="UDINT">
									<descr>Status of compressor 1</descr>
								</var>
								<var name="udiStatusC2" type="UDINT">
									<descr>Status of compressor 2</descr>
								</var>
								<var name="udiStatusC3" type="UDINT">
									<descr>Status of compressor 3</descr>
								</var>
								<var name="udiStatusC4" type="UDINT">
									<descr>Status of compressor 4</descr>
								</var>
								<var name="udiStatusC5" type="UDINT">
									<descr>Status of compressor 5</descr>
								</var>
								<var name="udiStatusC6" type="UDINT">
									<descr>Status of compressor 6</descr>
								</var>
								<var name="udiStatusC7" type="UDINT">
									<descr>Status of compressor 7</descr>
								</var>
								<var name="udiStatusC8" type="UDINT">
									<descr>Status of compressor 8</descr>
								</var>
								<var name="usiCompMode" type="USINT">
									<descr>Compressor control sequence mode (0 to 2)</descr>
								</var>
								<var name="xHeatCool" type="BOOL">
									<descr>Mode selection (0: cooling, 1: heating)</descr>
								</var>
								<var name="xCntrlMode" type="BOOL">
									<descr>Regulation mode (TRUE: proportional, FALSE: neutral)</descr>
								</var>
								<var name="uiBand1" type="UINT">
									<descr>Band low for Neutral zone (User Unit)</descr>
									<initValue>20</initValue>
								</var>
								<var name="uiBand2" type="UINT">
									<descr>Band high for neutral zone  (User Unit)</descr>
									<initValue>40</initValue>
								</var>
								<var name="uiTIncB1" type="UINT">
									<descr>Delay to increment the number of requested compressors for band 1 only (s)</descr>
									<initValue>60</initValue>
								</var>
								<var name="uiTDecB1" type="UINT">
									<descr>Delay to decrement the number of requested compressors for band 1 only (s)</descr>
									<initValue>30</initValue>
								</var>
								<var name="uiTIncB2" type="UINT">
									<descr>Delay to increment the number of requested compressors for band 2 only (s)</descr>
									<initValue>30</initValue>
								</var>
								<var name="uiTDecB2" type="UINT">
									<descr>Delay to decrement the number of requested compressors for band 2 only (s)</descr>
									<initValue>15</initValue>
								</var>
								<var name="uiPb" type="UINT">
									<descr>Proportional band for proportional band control (0 to 32767 * User Unit)</descr>
									<initValue>40</initValue>
								</var>
								<var name="uiTIncPb" type="UINT">
									<descr>Timer before incrementing number of compressors (s)</descr>
									<initValue>30</initValue>
								</var>
								<var name="uiTDecPb" type="UINT">
									<descr>Timer before decrementing number of compressors (s)</descr>
									<initValue>30</initValue>
								</var>
								<var name="ptrArr_Priority" type="@USINT">
									<descr>Priority of the compressors in sequencing mode LIFO</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="usiState" type="USINT">
									<descr>Current state (0 to  99)</descr>
								</var>
								<var name="uiCapacity" type="UINT">
									<descr>Total capacity of the running compressors (0 to 1000 * 0.1%)</descr>
								</var>
								<var name="uiCapAvail" type="UINT">
									<descr>Total capacity of the available  compressors (in case of alarm) (0 to 1000 * 0.1%)</descr>
								</var>
								<var name="xCmdeC1" type="BOOL">
									<descr>Start command for  compressor 1</descr>
								</var>
								<var name="xCmdeC2" type="BOOL">
									<descr>Start command for  compressor 2</descr>
								</var>
								<var name="xCmdeC3" type="BOOL">
									<descr>Start command for  compressor 3</descr>
								</var>
								<var name="xCmdeC4" type="BOOL">
									<descr>Start command for  compressor 4</descr>
								</var>
								<var name="xCmdeC5" type="BOOL">
									<descr>Start command for  compressor 5</descr>
								</var>
								<var name="xCmdeC6" type="BOOL">
									<descr>Start command for  compressor 6</descr>
								</var>
								<var name="xCmdeC7" type="BOOL">
									<descr>Start command for  compressor 7</descr>
								</var>
								<var name="xCmdeC8" type="BOOL">
									<descr>Start command for  compressor 8</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="arudil_CompressorAlarm" type="BOOL" dim0="8"/>
								<var name="arudil_CompressorCycleTimer" type="BOOL" dim0="8"/>
								<var name="arudil_CompressorModeAuto" type="BOOL" dim0="8"/>
								<var name="arudil_CompressorOffTimer" type="BOOL" dim0="8"/>
								<var name="arudil_CompressorOnTimer" type="BOOL" dim0="8"/>
								<var name="arxStartC" type="BOOL" dim0="8"/>
								<var name="TON_C1" type="BOOL"/>
								<var name="TON_C2" type="BOOL"/>
								<var name="xAllCompInAlarm" type="BOOL"/>
								<var name="xCompNbOutOfRange" type="BOOL"/>
								<var name="xCtrlModeLatch" type="BOOL"/>
								<var name="xDecrement" type="BOOL"/>
								<var name="xHeatCoolLatch" type="BOOL"/>
								<var name="xIncrement" type="BOOL"/>
								<var name="xlFound" type="BOOL"/>
								<var name="xOutOfRange" type="BOOL"/>
								<var name="xParamLatch" type="BOOL"/>
								<var name="xWrongBandParam" type="BOOL"/>
								<var name="siBand" type="SINT"/>
								<var name="arusil_FIFOStopPriority" type="USINT" dim0="8"/>
								<var name="arusil_FixedStartPriority" type="USINT" dim0="8"/>
								<var name="arusil_Priority" type="USINT" dim0="8"/>
								<var name="arusil_StartPriority" type="USINT" dim0="8"/>
								<var name="arusil_StopPriority" type="USINT" dim0="8"/>
								<var name="arusil_temp" type="USINT" dim0="8"/>
								<var name="i" type="USINT"/>
								<var name="j" type="USINT"/>
								<var name="n" type="USINT"/>
								<var name="usiCompModeLatch" type="USINT"/>
								<var name="usil_CompIndex" type="USINT"/>
								<var name="usil_temp" type="USINT"/>
								<var name="usilNbCompAct" type="USINT"/>
								<var name="usilNbCompActCalc" type="USINT"/>
								<var name="usilNbCompActSP" type="USINT"/>
								<var name="usiNbCompLatch" type="USINT"/>
								<var name="iPb" type="INT"/>
								<var name="iDebug" type="UINT"/>
								<var name="arudil_OperatingHours" type="UDINT" dim0="8"/>
								<var name="udil_temp" type="UDINT"/>
								<var name="udilStatus" type="UDINT"/>
								<var name="uidl_FixedStartPrioritySize" type="UDINT"/>
								<var name="uidl_PrioritySize" type="UDINT"/>
								<var name="ByteToBit" type="ByteToBit"/>
								<var name="l_xEnOld" type="BOOL"/>
								<var name="RTON_CompB1" type="R_TRIG"/>
								<var name="RTON_CompB2" type="R_TRIG"/>
								<var name="TON_CompB1" type="TON"/>
								<var name="TON_CompB2" type="TON"/>
								<var name="TON_Decrement" type="TON"/>
								<var name="TON_Increment" type="TON"/>
								<var name="ptrArl_FixedStartPriority" type="@USINT"/>
							</localVars>
							<localConsts>
								<const name="uilCompArrSize" type="USINT">
									<initValue>8</initValue>
								</const>
								<const name="MASKBIT_23" type="UDINT">
									<initValue>8388607</initValue>
								</const>
								<const name="usCompArrayMaxIndex" type="USINT">
									<initValue>7</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
