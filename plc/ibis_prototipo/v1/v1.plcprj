					<functionBlock name="FB_EEVOpenAlert" version="1.0.0" hidden="true" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV open alert</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Alarm active only if the FB is active</descr>
								</var>
								<var name="uiOut" type="UINT">
									<descr>Opening value of the valve</descr>
								</var>
								<var name="uiMaxValue" type="UINT">
									<descr>Opening maximum value of the valve</descr>
								</var>
								<var name="uiTimeCheck" type="UINT">
									<descr>Time checked in seconds</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="xOpenAlert" type="BOOL">
									<descr>T: the alarm occured</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="Timer" type="TON"/>
								<var name="t_on" type="BOOL"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
