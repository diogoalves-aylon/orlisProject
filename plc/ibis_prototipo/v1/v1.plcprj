					<functionBlock name="EEVSHCntrl" version="1.0.5" creationDate="0" lastModifiedDate="1654092369" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>SH and MOP control through EEV</title>
						<descr>&lt;HTML&gt;This AFB manages the EEV opening degree to control the superheat and the MOP (maximum operating pressure) in an evaporator or equivalent system.
The inputs are some logic commands and the analogic quantities superheat and MOP, which normally corresponds to operating suction pressure or equivalent saturated vapor temperature. These quantities (superheat and saturated vapor temperature) must be calculated outside this AFB in an appropriate way (through dedicated AFBs). The output is the opening degree for the EEV, some states and alarms.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Enables the function block</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xStart" type="BOOL">
									<descr>TRUE: enables the regulation FALSE: closing procedure</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xAlarm" type="BOOL">
									<descr>TRUE: alarm ongoing stop regulation FALSE: normal regulation</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xComAlarm" type="BOOL">
									<descr>TRUE: communication alarm, fixed position FALSE: normal regulation</descr>
									<initValue>TRUE</initValue>
								</var>
								<var name="i_xDefrost" type="BOOL">
									<descr>TRUE: abrupt close of the valve to permit the defrost FALSE: restart regulation</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xManualMode" type="BOOL">
									<descr>TRUE: commands directly the output with uiManualValue FALSE: regulation active</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_uiManualValue" type="UINT">
									<descr>Manual value to set the output (0.1 %)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiExtLimitValue" type="UINT">
									<descr>External value limitation of EEV opening (0.1 %)</descr>
									<initValue>1000</initValue>
								</var>
								<var name="i_iSuperHeatPv" type="INT">
									<descr>Super heat process value (0.1 * K/ °R)</descr>
									<initValue>-32768</initValue>
								</var>
								<var name="i_iMOPPv" type="INT">
									<descr>Mop process value (0.1 * °C/°F/bar/psi)</descr>
									<initValue>-32768</initValue>
								</var>
								<var name="i_iContModPv" type="INT">
									<descr>Continuous modulation process value (0.1 * °C/°F/bar/psi)</descr>
									<initValue>-32768</initValue>
								</var>
								<var name="i_iSuperHeatSetp" type="INT">
									<descr>Super heat set point  (0.1 * K/ °R)</descr>
								</var>
								<var name="i_uiPbAlarmValue" type="UINT">
									<descr>Output in case of process value (superheat or continuous modulation) not valid</descr>
									<initValue>500</initValue>
								</var>
								<var name="i_uiComAlarmValue" type="UINT">
									<descr>Output in case of communication alarm</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiExtAlarmValue" type="UINT">
									<descr>Output in case of generic external alarm</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_usiUnitType" type="USINT">
									<descr>Type of unit to be controlled</descr>
									<initValue>5</initValue>
								</var>
								<var name="i_xEnMOP" type="BOOL">
									<descr>TRUE: enable the MOP regulation FALSE: disable the MOP control</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_iMOPSetp" type="INT">
									<descr>Mop PID set point (0.1 * °C/°F/bar/psi)</descr>
									<initValue>320</initValue>
								</var>
								<var name="i_usiContModType" type="USINT">
									<descr>Continuous modulation type (0=disable, 1=cool, 2=heat)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_iContModSetp" type="INT">
									<descr>Continuous modulation setpoint (0.1 * °C/°F/bar/psi)</descr>
									<initValue>50</initValue>
								</var>
								<var name="i_uiMaxValue" type="UINT">
									<descr>Maximum opening value (0.1 %)</descr>
									<initValue>1000</initValue>
								</var>
								<var name="i_uiDeadZoneValueMin" type="UINT">
									<descr>Dead zone minimum opening value (0.1 %)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiDeadZoneValueMax" type="UINT">
									<descr>Dead zone maximum opening value  (0.1 %)</descr>
									<initValue>1000</initValue>
								</var>
								<var name="i_uiMaxVarOut" type="UINT">
									<descr>Maximum variation of output (0.1 %/s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiValueOnStart" type="UINT">
									<descr>Fixed output value after restart from stop, hold for the time uiTimeOnStart (0.1 %)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiTimeOnStart" type="UINT">
									<descr>Time with uiValueOnStart before starting the regulation (s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiValueOnStop" type="UINT">
									<descr>Fixed value on stop, hold for the time uiTimeOnStop if xFreezeOnStopMode = TRUE (0.1 %)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiTimeOnStop" type="UINT">
									<descr>Time with the fixed value before closing (s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiValueOnDefrost" type="UINT">
									<descr>Fixed value on restart from defrost (0.1 %)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiHighLoadDelay" type="UINT">
									<descr>Time to wait for MOP control/alarm and dynamic setpoint  (s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiMOPAlarmDelay" type="UINT">
									<descr>Time to trigger the MOP alarm  (s)</descr>
									<initValue>180</initValue>
								</var>
								<var name="i_uiOpenAlarmDelay" type="UINT">
									<descr>Time to trigger the full opening alarm (s)</descr>
									<initValue>3600</initValue>
								</var>
								<var name="i_uiSuperHeatPb" type="UINT">
									<descr>Super heat PID proportional band  (0.1 * K/ °R)</descr>
									<initValue>100</initValue>
								</var>
								<var name="i_uiSuperHeatTi" type="UINT">
									<descr>Super heat PID integral time constant (s)</descr>
									<initValue>40</initValue>
								</var>
								<var name="i_uiSuperHeatTd" type="UINT">
									<descr>Super heat PID derivative time constant (s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_xEnSuperHeatEvo" type="BOOL">
									<descr>Enable evoluted superheat algorithm</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_uiSuperHeatDz" type="UINT">
									<descr>Super heat regulation dead band</descr>
									<initValue>5</initValue>
								</var>
								<var name="i_uiMOPPb" type="UINT">
									<descr>Mop PID proportional band  (0.1 * °C/°F/bar/psi)</descr>
									<initValue>10</initValue>
								</var>
								<var name="i_uiMOPTi" type="UINT">
									<descr>Mop PID integral time constant (s)</descr>
									<initValue>10</initValue>
								</var>
								<var name="i_uiMOPTd" type="UINT">
									<descr>Mop PID derivative time constant  (s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiContModPb" type="UINT">
									<descr>Continuous modulation PID proportional band (0.1 * °C/°F/bar/psi)</descr>
									<initValue>10</initValue>
								</var>
								<var name="i_uiContModTi" type="UINT">
									<descr>Continuous modulation PID integral time constant  (s)</descr>
									<initValue>10</initValue>
								</var>
								<var name="i_uiContModTd" type="UINT">
									<descr>Continuous modulation PID derivative time constant  (s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_xEnDinSetpCalc" type="BOOL">
									<descr>Enable the dynamical super heat set point calculation</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_uiDinSetpMaxOffset" type="UINT">
									<descr>Maximum offset in the dynamical set point calculation (0.1 * K/ °R)</descr>
									<initValue>100</initValue>
								</var>
								<var name="i_uiSetpIncrStep" type="UINT">
									<descr>Incremental step in the dynamical set point calculation (0.1 * K/ °R)</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_uiSetpIncrTime" type="UINT">
									<descr>Step time in the dynamical set point calculation  (s)</descr>
									<initValue>20</initValue>
								</var>
								<var name="i_ptriLastValue" type="@INT">
									<descr>EEPROM address of the last stored value</descr>
									<initValue>0</initValue>
								</var>
								<var name="aauiEEVCntrlParams" type="UINT" dim0="14" dim1="15">
									<descr>Array of predefined values related to i_usiUnitType</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_uiOut" type="UINT">
									<descr>Output value  representing the opening level of the EE Valve (0.1 %)</descr>
								</var>
								<var name="q_usiRegulStatus" type="USINT">
									<descr>Current regulation status</descr>
								</var>
								<var name="q_iSupHeatSetpCalc" type="INT">
									<descr>Superheat current setpoint calculated (0.1 * K/ °R)</descr>
								</var>
								<var name="q_uiSuperHeatPbUnit" type="UINT">
									<descr>Super heat PID proportional band for selected unit type (0.1 * K/ °R)</descr>
								</var>
								<var name="q_uiSuperHeatTiUnit" type="UINT">
									<descr>Super heat PID integral time constant  for selected unit type (s)</descr>
								</var>
								<var name="q_uiSuperHeatTdUnit" type="UINT">
									<descr>Super heat PID derivative time constant  for selected unit type (s)</descr>
								</var>
								<var name="q_xEnSuperHeatEvoUnit" type="BOOL">
									<descr>Enable evoluted superheat algorithm  for selected unit type</descr>
								</var>
								<var name="q_uiSuperHeatDzUnit" type="UINT">
									<descr>Super heat regulation dead band for selected unit type  (0.1 * K/ °R)</descr>
								</var>
								<var name="q_uiMOPPbUnit" type="UINT">
									<descr>Mop PID proportional band  for selected unit type (0.1 * °C/°F/bar/psi)</descr>
								</var>
								<var name="q_uiMOPTiUnit" type="UINT">
									<descr>Mop PID integral time constant  for selected unit type (s)</descr>
								</var>
								<var name="q_uiMOPTdUnit" type="UINT">
									<descr>Mop PID derivative time constant  for selected unit type(s)</descr>
								</var>
								<var name="q_xEnDinSetpCalcUnit" type="BOOL">
									<descr>Enable the dynamical super heat set point calculation  for selected unit type</descr>
								</var>
								<var name="q_uiDinSetpMaxOffsetUnit" type="UINT">
									<descr>Maximum offset in the dynamical set point calculation  for selected unit type (0.1 * K/ °R)</descr>
								</var>
								<var name="q_uiSetpIncrStepUnit" type="UINT">
									<descr>Incremental step in the dynamical set point calculation  for selected unit type (0.1 * K/ °R)</descr>
								</var>
								<var name="q_uiSetpIncrTimeUnit" type="UINT">
									<descr>Step time in the dynamical set point calculation  for selected unit type (s)</descr>
								</var>
								<var name="q_uiAlarmID" type="UINT">
									<descr>Alarm flags</descr>
								</var>
								<var name="q_uiAlertID" type="UINT">
									<descr>Alert flags</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="xMopAlarm" type="BOOL"/>
								<var name="EEVMgmt" type="FB_EEVMgmt"/>
								<var name="MOPAlarm" type="FB_EEVMopAlarm"/>
								<var name="Supervisor" type="FB_EEVSupervisor"/>
								<var name="DynSetpCalc" type="FB_EEVDynSetpCalc"/>
								<var name="uiAlertParams" type="UINT">
									<descr>changed parameters</descr>
								</var>
								<var name="uiTimeOnStopLocal" type="UINT"/>
								<var name="uiTimeOnStartLocal" type="UINT"/>
								<var name="uiMopAlarmDelayLocal" type="UINT"/>
								<var name="uiOpenAlarmDelayLocal" type="UINT"/>
								<var name="uiHighLoadDelayLocal" type="UINT"/>
								<var name="xMOPActive" type="BOOL">
									<descr>TRUE: MOP regulation ongoing FALSE: super heat regulation ongoing</descr>
								</var>
								<var name="Limiter" type="FB_EEVSpeedLimiter"/>
								<var name="uiAlarmParams" type="UINT">
									<descr>alarm parameters</descr>
								</var>
								<var name="xIntAlarm" type="BOOL">
									<descr>internal alarm signaling</descr>
								</var>
								<var name="uiValueOnStartLocal" type="UINT">
									<descr>Fixed output value after restart from stop, hold for the time uiTimeOnStart (0.1 %)</descr>
								</var>
								<var name="uiValueOnStopLocal" type="UINT">
									<descr>Fixed output value after restart from stop, hold for the time uiTimeOnStart (0.1 %)</descr>
								</var>
								<var name="uiValueOnDefrostLocal" type="UINT">
									<descr>Fixed value on restart from defrost (0.1 %)</descr>
								</var>
								<var name="CheckParameters" type="FB_EEVCheckUnitAndParameters"/>
								<var name="iSuperHeatSetpLocal" type="INT">
									<descr>Super heat PID set point  (0.1 * K/ °R)</descr>
									<initValue>80</initValue>
								</var>
								<var name="iMOPSetpLocal" type="INT"/>
								<var name="uiMaxValueLocal" type="UINT"/>
								<var name="uiDeadZoneValueMinLocal" type="UINT"/>
								<var name="uiDeadZoneValueMaxLocal" type="UINT"/>
								<var name="uiMaxVarOutLocal" type="UINT"/>
								<var name="uiPbAlarmValueLocal" type="UINT"/>
								<var name="AlarmsMgmt" type="FB_EEVAlarmsMgmt"/>
								<var name="OpenAlert" type="FB_EEVOpenAlert"/>
								<var name="iContModSetpLocal" type="INT">
									<descr>Continuous modulation setpoint (0.1 * °C/°F/bar/psi)</descr>
									<initValue>50</initValue>
								</var>
								<var name="usiContModTypeLocal" type="USINT">
									<descr>Coninuous modulation type (0=disable, 1=cool, 2=heat)</descr>
									<initValue>0</initValue>
								</var>
								<var name="uiExtLimitValueLocal" type="UINT">
									<descr>External value limitation of EEV opening (0.1 %)</descr>
									<initValue>1000</initValue>
								</var>
								<var name="uiManualValueLocal" type="UINT">
									<descr>Manual value to set the output (0.1 %)</descr>
									<initValue>1000</initValue>
								</var>
								<var name="uiExtAlarmValueLocal" type="UINT">
									<descr>Output in case of generic external alarm</descr>
									<initValue>0</initValue>
