								</var>
								<var name="l_udiCommPauseTimerEt" type="UDINT">
									<descr>Local Variable for CommPause Timer Elapsed Time</descr>
								</var>
								<var name="l_udiCommPauseTimerPt" type="UDINT">
									<descr>Local Variable for CommPause Timer Preset Time</descr>
								</var>
								<var name="l_xCommPauseTimerQ" type="BOOL">
									<descr>Local Variable for CommPauseTimer Elapsed Bit</descr>
								</var>
								<var name="l_udiCommPauseTimerEt_Old" type="UDINT">
									<descr>Local Variable for previous scan value of CommPause Timer Elapsed Time</descr>
								</var>
								<var name="l_xMilliSecTimerEn" type="BOOL">
									<descr>Local Variable for MilliSec Timer Enable</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="l_udiMilliSecTimerEt" type="UDINT">
									<descr>Local Variable for MilliSec Timer Elapsed Time</descr>
								</var>
								<var name="l_udiMilliSecTimerPt" type="UDINT">
									<descr>Local Variable for MilliSec Timer Preset Time</descr>
								</var>
								<var name="l_xMilliSecTimerQ" type="BOOL">
									<descr>Local Variable for MilliSec Timer Elapsed Bit</descr>
								</var>
								<var name="l_udiMilliSecTimerEt_Old" type="UDINT">
									<descr>Local Variable for previous scan value of MilliSec Timer Elapsed Time</descr>
								</var>
								<var name="l_xCmd" type="BOOL">
									<descr>Local Variable for Command</descr>
								</var>
								<var name="l_iSetPoint" type="INT">
									<descr>Local Variable for SetPoint</descr>
								</var>
								<var name="l_xPUsed" type="BOOL">
									<descr>Local Variable for Comp Previously Used</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="l_xValve" type="BOOL">
									<descr>Local Variable for Valve</descr>
									<initValue>FALSE</initValue>
