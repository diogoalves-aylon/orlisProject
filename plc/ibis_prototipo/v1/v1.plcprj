					</functionBlock>
					<functionBlock name="YearlyEvent" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Yearly Event</title>
						<descr>&lt;HTML&gt;Event will be true if current time is between start and stop time. Repeated over years.</descr>
						<vars>
							<inputVars>
								<var name="i_usiStartMonth" type="USINT">
									<descr>Start month of the event (1..12)</descr>
								</var>
								<var name="i_usiStartDaymonth" type="USINT">
									<descr>Start daymonth of the event (1..31)</descr>
								</var>
								<var name="i_usiStartHours" type="USINT">
									<descr>Start hour of the event (0..23)</descr>
								</var>
								<var name="i_usiStopMonth" type="USINT">
									<descr>Stop month of the event (1..12)</descr>
								</var>
								<var name="i_usiStopDaymonth" type="USINT">
									<descr>Stop daymonth of the event (1..31)</descr>
								</var>
								<var name="i_usiStopHours" type="USINT">
									<descr>Stop hour of the event (0..23)</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xEvent" type="BOOL">
									<descr>Set if time is between Start &amp; Stop</descr>
								</var>
								<var name="q_xError" type="BOOL">
									<descr>Error occured calling the Function Block, check inputs</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime">
									<descr>System Date and Time Read. It is a structure of type TypeDataTime composed 
by the following fields:
	seconds		: USINT; seconds [0...59]
	minutes		: USINT; minutes [0...59] 
	hours		: USINT; hours [0...23]
	dayweek		: USINT; day of week [0...6]
	daymonth		: USINT; day of month [1...31]
	month		: USINT; month [1...12]
	year		: USINT; year [10...99]</descr>
								</var>
								<var name="sysClockError" type="BOOL"/>
							</externalVars>
							<localVars>
								<var name="l_uiClockHours" type="UINT"/>
								<var name="l_uiStartHours" type="UINT"/>
								<var name="l_uiStopHours" type="UINT"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
