					<functionBlock name="CompMgmtVS" version="1.2.0" creationDate="0" lastModifiedDate="1717498827">
						<title>Compressor Management with VSD</title>
						<descr>&lt;HTML&gt;&lt;p&gt;CompMgmtVS is used to control compressor’s types: variable speed or on/off. Variable speed compressors have priority respect on/off compressors.&lt;/p&gt;
&lt;p&gt;The CompMgmtVS function block supports up to 4 compressors that could be switched on or off depending on the request. &lt;/p&gt;
&lt;p&gt;This function block balances compressor operating hours by using one of the 3 methods: FIFO,	Runtime, LIFO. &lt;/p&gt;
&lt;p&gt;Compressor changeover is managed in case of a detected compressor error. An increase/decrease of delay or hysteresis allows to prevent a frequent Compressor switching on/off.&lt;/p&gt;
&lt;p&gt;usiCompMode, xCntrlMode, usiNbOnOff and usiNbVs are latched once xEn passes from FALSE to TRUE. To modify these inputs the function block must be disabled.&lt;p&gt;
&lt;p&gt;For more details, see the help online of CompMgmtVS.&lt;/p&gt;


&lt;p&gt;&lt;b&gt;Alarm ID&lt;/b&gt;&lt;/p&gt;
&lt;table border&gt;
	&lt;tbody&gt;
		  &lt;colgroup span= 3  class= columns &gt;&lt;/colgroup&gt;
		  &lt;tr&gt;
			&lt;th&gt;Bit&lt;/th&gt;
			&lt;th&gt;Value&lt;/th&gt;
			&lt;th&gt;Description:&lt;/th&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;0&lt;/td&gt;
			&lt;td&gt;1&lt;/td&gt;
			&lt;td&gt;rSp outside range 0.0...100.0&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;1&lt;/td&gt;
			&lt;td&gt;2&lt;/td&gt;
			&lt;td&gt;CompMode value wrong 0...2&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;2&lt;/td&gt;
			&lt;td&gt;4&lt;/td&gt;
			&lt;td&gt;CompSeq1,2,3,4&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;3&lt;/td&gt;
			&lt;td&gt;8&lt;/td&gt;
			&lt;td&gt;Number off compressors wrong&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;4&lt;/td&gt;
			&lt;td&gt;16&lt;/td&gt;
			&lt;td&gt;OnOff(Vs) Nominal freqeuenz value wrong 0.0...500.0&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;5&lt;/td&gt;
			&lt;td&gt;32&lt;/td&gt;
			&lt;td&gt;Vs frequenz values wrong MinFreq 0...500.0, MaxFreq 0...500.0, MaxFreq&lt;MinFreq, NbVs&gt;0 and MinFreq==0 or MaxFreq==0&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;6&lt;/td&gt;
			&lt;td&gt;64&lt;/td&gt;
			&lt;td&gt;OnOff capacity value wrong 0...1000&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;7&lt;/td&gt;
			&lt;td&gt;128&lt;/td&gt;
			&lt;td&gt;Vs capacity value wrong 0...1000&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;8&lt;/td&gt;
			&lt;td&gt;256&lt;/td&gt;
			&lt;td&gt;MinRange, MaxRange: 0...100.00, MinRange=0 is not possible, MaxFreq 0...500.0, MaxRange&lt;=MinRange&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;9&lt;/td&gt;
			&lt;td&gt;512&lt;/td&gt;
			&lt;td&gt;Delay value wrong 0...6000 seconds&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;10&lt;/td&gt;
			&lt;td&gt;1024&lt;/td&gt;
			&lt;td&gt;Hysteresis value wrong 0...100.00%&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;11&lt;/td&gt;
			&lt;td&gt;2048&lt;/td&gt;
			&lt;td&gt;All compressors are in alarm state &lt;/td&gt;
		  &lt;/tr&gt;
	&lt;/tbody&gt;
 &lt;/table&gt;
 
&lt;p&gt;&lt;b&gt;Alert ID&lt;/b&gt;&lt;/p&gt;
&lt;table border&gt;
	&lt;tbody&gt;
		  &lt;colgroup span= 3  class= columns &gt;&lt;/colgroup&gt;
		  &lt;tr&gt;
			&lt;th&gt;Bit&lt;/th&gt;
			&lt;th&gt;Value&lt;/th&gt;
			&lt;th&gt;Description:&lt;/th&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;	
			&lt;td&gt;0&lt;/td&gt;
			&lt;td&gt;1&lt;/td&gt;
			&lt;td&gt;Warning running hours C1 are to high and will be frozen at 16700100&lt;/td&gt;
			&lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;1&lt;/td&gt;
			&lt;td&gt;2&lt;/td&gt;
			&lt;td&gt;Warning running hours C2 are to high and will be frozen at 16700100&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;2&lt;/td&gt;
			&lt;td&gt;4&lt;/td&gt;
			&lt;td&gt;Warning running hours C3 are to high and will be frozen at 16700100&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
		    &lt;td&gt;3&lt;/td&gt;
			&lt;td&gt;8&lt;/td&gt;
			&lt;td&gt;Warning running hours C4 are to high and will be frozen at 16700100&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;4&lt;/td&gt;
			&lt;td&gt;16&lt;/td&gt;
			&lt;td&gt;C1 is in alarm state or not in auto mode&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;5&lt;/td&gt;
			&lt;td&gt;32&lt;/td&gt;
			&lt;td&gt;C2 is in alarm state or not in auto mode&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;6&lt;/td&gt;
			&lt;td&gt;64&lt;/td&gt;
			&lt;td&gt;C3 is in alarm state or not in auto mode&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;7&lt;/td&gt;
			&lt;td&gt;128&lt;/td&gt;
			&lt;td&gt;C4 is in alarm state or not in auto mode&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;8&lt;/td&gt;
			&lt;td&gt;256&lt;/td&gt;
			&lt;td&gt;Mode was change during run mode&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;9&lt;/td&gt;
			&lt;td&gt;512&lt;/td&gt;
			&lt;td&gt;ControlMode was change and xEn was set to TRUE&lt;/td&gt;
		  &lt;/tr&gt;
		  &lt;tr&gt;
			&lt;td&gt;10&lt;/td&gt;
			&lt;td&gt;1024&lt;/td&gt;
			&lt;td&gt;Number of compressors were change and xEn was to set TRUE&lt;/td&gt;
		  &lt;/tr&gt;
	&lt;/tbody&gt;
 &lt;/table&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enables the AFB</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="rSp" type="REAL">
									<descr>Setpoint 0...100.00 %</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="udiStatusC1" type="UDINT">
									<descr>Status of C1, Bit 0-23 Op.hours, Bits 24-25=Res, Bit26-27--&gt;1=auto 2=Man 3=Maintenance, Bit 28 TRUE= Off timer active, Bit 29 TRUE= On timer active, Bit 30 TRUE= Cycle timer active, Bit 31 TRUE=Alarm</descr>
									<initValue>0</initValue>
								</var>
								<var name="udiStatusC2" type="UDINT">
									<descr>Status of C2, Bit 0-23 Op.hours, Bits 24-25=Res, Bit26-27--&gt;1=auto 2=Man 3=Maintenance, Bit 28 TRUE= Off timer active, Bit 29 TRUE= On timer active, Bit 30 TRUE= Cycle timer active, Bit 31 TRUE=Alarm</descr>
									<initValue>0</initValue>
								</var>
								<var name="udiStatusC3" type="UDINT">
									<descr>Status of C3, Bit 0-23 Op.hours, Bits 24-25=Res, Bit26-27--&gt;1=auto 2=Man 3=Maintenance, Bit 28 TRUE= Off timer active, Bit 29 TRUE= On timer active, Bit 30 TRUE= Cycle timer active, Bit 31 TRUE=Alarm</descr>
									<initValue>0</initValue>
								</var>
								<var name="udiStatusC4" type="UDINT">
									<descr>Status of C4, Bit 0-23 Op.hours, Bits 24-25=Res, Bit26-27--&gt;1=auto 2=Man 3=Maintenance, Bit 28 TRUE= Off timer active, Bit 29 TRUE= On timer active, Bit 30 TRUE= Cycle timer active, Bit 31 TRUE=Alarm</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiCompMode" type="USINT">
									<descr>Compressor Mode, 0=FIFO, 1=Runtime, 2=LIFO</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiLifoSeqC1" type="USINT">
									<descr>Lifo sequence of C1, Range 1 to 4, only in usiCompMode=2</descr>
									<initValue>1</initValue>
								</var>
								<var name="usiLifoSeqC2" type="USINT">
									<descr>Lifo sequence of C2, Range 1 to 4, only in usiCompMode=2</descr>
									<initValue>2</initValue>
								</var>
								<var name="usiLifoSeqC3" type="USINT">
									<descr>Lifo sequence of C3, Range 1 to 4, only in usiCompMode=2</descr>
									<initValue>3</initValue>
								</var>
								<var name="usiLifoSeqC4" type="USINT">
									<descr>Lifo sequence of C4, Range 1 to 4, only in usiCompMode=2</descr>
									<initValue>4</initValue>
								</var>
								<var name="xCtrlMode" type="BOOL">
									<descr>Switch ON/OFF of the Compressors with Delay or Hysteresis, FALSE= Delay, TRUE=Hys</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="usiNbOnOff" type="USINT">
									<descr>Number of fixed speed compressors. Default: 0.</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiNbVs" type="USINT">
									<descr>Number of variable speed compressors. Default: 0.</descr>
									<initValue>0</initValue>
								</var>
								<var name="rNomFreq" type="REAL">
									<descr>Nominal speed of the fixed speed compressors, Range 0.1 to 500.0 Hz, default value 50.0 Hz</descr>
									<initValue>50.0</initValue>
								</var>
								<var name="rMinFreq" type="REAL">
									<descr>Minimum frequency of the variable speed compressors, Range 0.0 to 500.0 Hz, valid rMinFreq&lt;rMaxFreq, default value 10.0 Hz</descr>
									<initValue>10.0</initValue>
								</var>
								<var name="rMaxFreq" type="REAL">
									<descr>Maximum frequency of the variable speed compressors, Range 0.0 to 500.0 Hz, valid rMinFreq&lt;rMaxFreq, default value 50.0 Hz</descr>
									<initValue>50.0</initValue>
								</var>
								<var name="uiCapOnOff" type="UINT">
									<descr>Capacity of the fixed speed compressors, Range 1 to 1000, default=100</descr>
									<initValue>100</initValue>
								</var>
								<var name="uiCapVs" type="UINT">
									<descr>Capacity of the variable speed compressors at rNomFreq, Range 1 to 1000, default=100</descr>
									<initValue>100</initValue>
								</var>
								<var name="rMinRange" type="REAL">
									<descr>Low limit of the range, Range 0.00 to 100.00, valid rMinRange&lt;rMaxRange, default value 5.00%</descr>
									<initValue>5.00</initValue>
								</var>
								<var name="rMaxRange" type="REAL">
									<descr>High limit of the range, Range 0.00 to 100.00, valid rMinRange&lt;rMaxRange, default value 98.00%</descr>
									<initValue>98.00</initValue>
								</var>
								<var name="rHighLimit" type="REAL">
									<descr>High limit of PID output %</descr>
									<initValue>100.0</initValue>
								</var>
								<var name="rLowLimit" type="REAL">
									<descr>Low limit of PID output %</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="uiSpMaxVar" type="UINT">
									<descr>Time to increase/decrease the setpoint of 10% [s] 0 leave rSp as is</descr>
									<initValue>0</initValue>
								</var>
								<var name="uiDelayOn" type="UINT">
									<descr>Delay time to switch on a requested compressor, Range 1 to 6000 seconds</descr>
									<initValue>0</initValue>
								</var>
								<var name="uiDelayOff" type="UINT">
									<descr>Delay time to switch off a non requested compressor, Range 1 to 6000 seconds</descr>
									<initValue>0</initValue>
								</var>
								<var name="rHys" type="REAL">
									<descr>Hysteresis to switch on/off a requested or non requested compressor, Range 0.00 to 50.00 %</descr>
									<initValue>0</initValue>
								</var>
								<var name="xHoldLastC" type="BOOL">
									<descr>Hold last compressor on if shut off is requested. Default: FALSE.</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="usiState" type="USINT">
									<descr>Current AFB State  1=Idle, 20=Run, 21=Hold last compressor on, 90=Alert, 99=Alarm</descr>
									<initValue>0</initValue>
								</var>
								<var name="rPIDHighLimit" type="REAL">
									<descr>Change the current value of the PID High Limit %</descr>
									<initValue>100.0</initValue>
								</var>
								<var name="rPIDLowLimit" type="REAL">
									<descr>Change the current value of the PID Low Limit %</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="rCapacity" type="REAL">
									<descr>Actual total capacity of the running compressors  - same unit of measure of uiCapOnOff/uiCapVS</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="rReqCapacity" type="REAL">
									<descr>Requested capacity of the system  - same unit of measure of uiCapOnOff/uiCapVS</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="xStartC1" type="BOOL">
									<descr>Start command for compressor 1</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="rSetpC1" type="REAL">
									<descr>Set point for compressor 1, Range 0.00 to 100.00 %</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="iSetpC1" type="INT">
									<descr>Set point for compressor 1, Range 0 to 1000</descr>
									<initValue>0</initValue>
								</var>
								<var name="xStartC2" type="BOOL">
									<descr>Start command for compressor 2</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="rSetpC2" type="REAL">
									<descr>Set point for compressor 2, Range 0.00 to 100.00 %</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="iSetpC2" type="INT">
									<descr>Set point for compressor 2, Range 0 to 1000</descr>
									<initValue>0</initValue>
								</var>
								<var name="xStartC3" type="BOOL">
									<descr>Start command for compressor 3</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="rSetpC3" type="REAL">
									<descr>Set point for compressor 3, Range 0.00 to 100.00 %</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="iSetpC3" type="INT">
									<descr>Set point for compressor 3, Range 0 to 1000</descr>
									<initValue>0</initValue>
								</var>
								<var name="xStartC4" type="BOOL">
									<descr>Start command for compressor 4</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="rSetpC4" type="REAL">
									<descr>Set point for compressor 4, Range 0.00 to 100.00 %</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="iSetpC4" type="INT">
									<descr>Set point for compressor 4, Range 0 to 1000</descr>
									<initValue>0</initValue>
								</var>
								<var name="rMinCapacity" type="REAL">
									<descr>Minimum capacity of the system</descr>
								</var>
								<var name="rMaxCapacity" type="REAL">
									<descr>Maximum capacity of the system</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
									<initValue>0</initValue>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
									<initValue>0</initValue>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT"/>
							</externalVars>
							<localVars>
								<var name="h" type="USINT">
									<descr>Help Var</descr>
								</var>
								<var name="i" type="USINT">
									<descr>Help Var</descr>
								</var>
								<var name="rlAnalogC" type="REAL" idxMin0="0" idx0="usilNbCOMPminus1">
									<descr>Help Var</descr>
								</var>
								<var name="rlarcTanB" type="REAL">
									<descr>Range min, max: calculation</descr>
								</var>
								<var name="rlCapHys" type="REAL">
									<descr>Helpvar for rlCapReqHysKw</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="rlCapMaxSysKw" type="REAL">
									<descr>Vs+Oo: System capacity calculated with usiNbVs, no unit</descr>
								</var>
								<var name="rlCapMaxSysW" type="REAL">
									<descr>Vs+Oo: System capacity calculated with usiNbVs*1000 for precision, no unit</descr>
								</var>
								<var name="rlCapOoKw" type="REAL">
									<descr>Help Var</descr>
								</var>
								<var name="rlCapReqHysKw" type="REAL">
									<descr>Required Capacity for the Hysteresis calculation</descr>
								</var>
								<var name="rlCapReqSysKw" type="REAL">
									<descr>Required Capacity of the System, no unit</descr>
								</var>
								<var name="rlCapReqSysW" type="REAL">
									<descr>Required Capacity of the System *1000 for precision, no unit</descr>
								</var>
								<var name="rlCapSysMinKw" type="REAL">
									<descr>Help variable to calculate range min and max, no unit</descr>
								</var>
								<var name="rlCapSysMinW" type="REAL">
									<descr>Help variable to calculate range min and max *1000 for precision, no unit</descr>
								</var>
								<var name="rlCapSysOffKw" type="REAL"/>
								<var name="rlCapSysRdyKw" type="REAL">
									<descr>Vs+Oo: Ready system capacity calculated with usilVsReady and usilOoReady, no unit</descr>
								</var>
								<var name="rlCosB" type="REAL">
									<descr>Range min, max: calculation</descr>
								</var>
								<var name="rlDiffDigitRange" type="REAL">
									<descr>Help Var for integer out</descr>
								</var>
								<var name="rlDiffOutRange" type="REAL">
									<descr>Help Var for integer out</descr>
								</var>
								<var name="rlOoCapOutKw" type="REAL">
									<descr>Oo: Actual output capacity calculated with OoOn, no unit</descr>
								</var>
								<var name="rlOoCapRdyKw" type="REAL">
									<descr>Oo: Actual capacity calculated wit OoReady, no unit</descr>
								</var>
								<var name="rlOoCapW" type="REAL">
									<descr>Oo: Capacity calculatetd with rCapOnOff *1000 for precision, no unit</descr>
								</var>
								<var name="rlOoReq" type="REAL">
									<descr>Help Var</descr>
								</var>
								<var name="rlP1x" type="REAL">
									<descr>Range min, max: calculation</descr>
								</var>
								<var name="rlP1y" type="REAL">
									<descr>Range min, max: calculation</descr>
								</var>
								<var name="rlP2x" type="REAL">
									<descr>Range min, max: calculation</descr>
								</var>
								<var name="rlP2y" type="REAL">
									<descr>Range min, max: calculation</descr>
								</var>
								<var name="rlReqCapacity" type="REAL">
									<descr>Internal Var for PidHold</descr>
								</var>
								<var name="rlSp" type="REAL">
									<descr>Sp internal, for e.g delay</descr>
								</var>
								<var name="rlSpOld" type="REAL">
									<descr>SpOld for PidHold</descr>
								</var>
								<var name="rlTanB" type="REAL">
									<descr>Range min, max: calculation</descr>
								</var>
								<var name="rlVsCapDiffKw" type="REAL">
									<descr>Vs: Difference capacity of rlVsCapMaxKw-rlVsCapMinKw, no unit</descr>
								</var>
								<var name="rlVsCapMaxKw" type="REAL">
									<descr>Vs: Maximal capacity calculatetd with max Frequency, no unit</descr>
								</var>
								<var name="rlVsCapMaxW" type="REAL">
									<descr>Vs: Maximal capacity calculatetd with max Frequency *1000 for precision, no unit</descr>
								</var>
								<var name="rlVsCapMinKw" type="REAL">
									<descr>Vs: Minimal capacity calculatetd with min Frequency, no unit</descr>
								</var>
								<var name="rlVsCapOutKw" type="REAL">
									<descr>Vs: Actual output capacity calculated with VsOn, no unit</descr>
								</var>
								<var name="rlVsCapRdyKw" type="REAL">
									<descr>Vs: Actual capacity calculated wit VsReady, no unit</descr>
								</var>
								<var name="rlVsReady" type="REAL">
									<descr>Help Var</descr>
								</var>
								<var name="rlVsReq" type="REAL">
									<descr>Help Var</descr>
								</var>
								<var name="rSpMaxVar" type="REAL">
									<descr>Help Var</descr>
								</var>
								<var name="rTrigLimit" type="REAL">
									<initValue>0</initValue>
								</var>
								<var name="siPidHold" type="SINT">
