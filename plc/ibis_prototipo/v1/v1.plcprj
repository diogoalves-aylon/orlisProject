					</functionBlock>
					<functionBlock name="ECBlueBasicSetFixedSpeed" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB can be used to set the following parameters:
 - SetIntern1 (h5, reg6)
 - SetIntern2 (h6, reg7)
 - Min Speed (h7, reg8)
 - Max Speed (h8, reg9)
 - SetIntern3 (h9, reg10)

After the call of the AFB, a PIN/motor reset can be executed by using the related FB. This allows news settings to be taken over.

The configuration message is sent when a transition of xEn from FALSE to TRUE takes place.

The output provides the info on whether the operation has been successful or not.

The ECBlueBasicSetFixedSpeed AFB must be put inside the Background task of the PLC.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Transition FALSE -&gt; TRUE changes the settings in the fan.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_usiZiehlAddress" type="USINT">
									<descr>Ziehl Fan Address. Broadcast not suppoted. Default: 1.</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_uiSetIntern1" type="UINT">
									<descr>Set Intern1 for control mode. Range 0... 6000 [1/min]. Default 0.</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiSetIntern2" type="UINT">
									<descr>Set Intern2 for control mode. Range 0... 6000 [1/min]. Default 0.</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiSetIntern3" type="UINT">
									<descr>Set Intern3 for control mode. Range 0... 6000 [1/min]. Default 0.</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiMinSpeed" type="UINT">
									<descr>Minimal speed. Range 0... 6000 [1/min]. Default 0.</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiMaxSpeed" type="UINT">
									<descr>Maximal speed. Range 0... 6000 [1/min]. Default 0.</descr>
									<initValue>0</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xChanged" type="BOOL">
									<descr>TRUE if the parameters have been successfully changed.</descr>
								</var>
								<var name="q_xWorking" type="BOOL">
									<descr>Change Operation in progress.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xFailed" type="BOOL">
									<descr>Change has failed.</descr>
								</var>
								<var name="q_xWrongInputs" type="BOOL">
									<descr>Inputs out of range</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="i" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="xEn_old" type="BOOL"/>
								<var name="MsgNum" type="USINT">
									<initValue>10</initValue>
								</var>
								<var name="uiRet_Check" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="j" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="k" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="uiRet_PIN" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="iPINL1" type="INT">
									<initValue>1234</initValue>
								</var>
								<var name="uiRet_SetIntern1" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="uiVals_check" type="UINT" dim0="5">
									<initValue>[65535,65535,65535,65535,65535]</initValue>
								</var>
								<var name="o" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="n" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="m" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="uiRet_MaxSpeed" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_MinSpeed" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_SetIntern2" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_SetIntern3" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="l" type="USINT">
									<initValue>250</initValue>
								</var>
							</localVars>
							<localConsts>
								<const name="usiRetries" type="USINT">
									<descr>Operation retries.</descr>
									<initValue>5</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
