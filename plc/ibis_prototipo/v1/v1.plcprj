					<functionBlock name="EcFanMgmt" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>EC Fan Management</title>
						<descr>&lt;HTML&gt;This AFB drives EC motors with the PWM and read the speed feedback</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Enable function</descr>
								</var>
								<var name="i_xUnitRpm" type="BOOL">
									<descr>Measure Unit:   FALSE = decimal of %, TRUE =rpm</descr>
								</var>
								<var name="i_uiSpeed" type="UINT">
									<descr>Setpoint speed in decimal of % or rpm</descr>
								</var>
								<var name="i_uiMinSpeed" type="UINT">
									<descr>Minimum Setpoint speed in decimal of % or rpm</descr>
								</var>
								<var name="i_uiMaxSpeed" type="UINT">
									<descr>Maximum Setpoint speed in decimal of % or rpm</descr>
								</var>
								<var name="i_uiStartSpeed" type="UINT">
									<descr>Start Setpoint speed in decimal of % or rpm</descr>
								</var>
								<var name="i_usiStartTime1s" type="USINT">
									<descr>Start Time in sec</descr>
								</var>
								<var name="i_uiRampStep" type="UINT">
									<descr>Ramp Up and Down in decimal of % or rpm / second</descr>
								</var>
								<var name="i_uiTacho" type="UINT">
									<descr>Tacho frequency in decimal of hertz</descr>
								</var>
								<var name="i_uiPulseRevol" type="UINT">
									<descr>Tacho pulse per revolution</descr>
								</var>
								<var name="i_uiRpmAt100" type="UINT">
									<descr>Rpm equivalent to 100.0%</descr>
								</var>
								<var name="i_usiErrorRel" type="USINT">
									<descr>Relative Error in decimal of  %</descr>
								</var>
								<var name="i_usiErrorEvalTime1s" type="USINT">
									<descr>Error Evaluation Time before generating error output</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_uiPwmDuty_010V" type="UINT">
									<descr>Duty Pwm in decimal or % or 0_10V in decimal of Volt</descr>
								</var>
								<var name="q_uiTacho" type="UINT">
									<descr>Tacho output in decimal of % or rpm</descr>
								</var>
								<var name="q_xError" type="BOOL">
									<descr>Error flag in case of Tacho speed over Error Relative after the Error Time</descr>
								</var>
								<var name="q_uiAlarmID" type="UINT"/>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT"/>
							</externalVars>
							<localVars>
								<var name="l_udiDeltaTime1ms" type="UDINT">
									<descr>Delta time between from previous call</descr>
								</var>
								<var name="l_udiTimerPrevious1ms" type="UDINT">
									<descr>System timer at previous call</descr>
								</var>
								<var name="l_udiMinTimeStart1ms" type="UDINT">
									<descr>Timer to manage Start time</descr>
								</var>
								<var name="l_udiErrorTime1ms" type="UDINT"/>
								<var name="l_uiSpeed" type="UINT"/>
								<var name="l_uiSpeedPrevious" type="UINT"/>
								<var name="l_uiTemp" type="UINT"/>
								<var name="l_rRampStep" type="REAL"/>
								<var name="l_rSpeedPrevious" type="REAL"/>
								<var name="l_rSpeed" type="REAL"/>
							</localVars>
							<localConsts>
								<const name="OUT_OF_RANGE" type="UINT">
									<descr>AlarmID</descr>
									<initValue>1</initValue>
								</const>
								<const name="WRONG_RELATIONSHIP" type="UINT">
									<descr>AlarmID</descr>
									<initValue>2</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
