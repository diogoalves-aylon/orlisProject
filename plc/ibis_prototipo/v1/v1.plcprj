					<functionBlock name="EEVDCntrl" version="1.0.5" creationDate="1561704204" lastModifiedDate="1617180753" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV driver application control</title>
						<descr>&lt;HTML&gt;This AFB is specific for the EEV driver for stepper valves and acts as an expansion for controller, exchanging data through CAN expansion bus.

The EEVDCntrl AFB, instantiated as many times as there are EEVs is in charge of controlling the EEV depending on some application variables and sensors. 
In particular the algorithms implemented inside the AFB decide the opening degree of the EEV considering some measures like refrigerant superheat or pressure or refrigerated fluid temperature.

The EEVDCntrl AFB must be put inside the Timed task of the PLC.&lt;br&gt; 
&lt;br&gt; 
For i_usiRefrType values see Press2Temp AFB description.&lt;br&gt; 
&lt;br&gt; 
q_usiRegulStatus, current regulation status values:&lt;br&gt; 
&lt;br&gt; 
 0=OFF&lt;br&gt; 
 1=SH&lt;br&gt; 
 2= MOP&lt;br&gt; 
 3=CONTINUOUS MODULATION&lt;br&gt; 
 4=EXTERNAL LIMITATION&lt;br&gt; 
 5=START&lt;br&gt; 
 6=STOP&lt;br&gt; 
 7=DEFROST&lt;br&gt; 
 8=MANUAL&lt;br&gt; 
 9=ALARM&lt;br&gt;</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>T: block enabled  F: block disabled, Out = 0</descr>
									<initValue>TRUE</initValue>
								</var>
								<var name="i_xStart" type="BOOL">
									<descr>T: enables the regulation  F: closing procedure, Out = 0</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xDefrost" type="BOOL">
									<descr>T: start the defrost, Out = 0  F: re-enable the regulation</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xManualMode" type="BOOL">
									<descr>T: Manual mode, Out = uiManualValue F: regulation acitve</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_uiManualValue" type="UINT">
									<descr>Manual value to set the output (0.1 %)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_uiExtLimitValue" type="UINT">
									<descr>External value limitation of EEV opening (0.1 %, default 100.0%)</descr>
									<initValue>1000</initValue>
								</var>
								<var name="i_iEvapPressure" type="INT">
									<descr>Evaporator pressure (*0.01 bar/psi)</descr>
									<initValue>-32768</initValue>
								</var>
								<var name="i_iEvapOutTemp" type="INT">
									<descr>Evaporator output temperature (*0.1 °C/°F)</descr>
									<initValue>-32768</initValue>
								</var>
								<var name="i_iContModPv" type="INT">
									<descr>Continuous modulation process value (0.1 * °C/°F/bar/psi)</descr>
									<initValue>-32768</initValue>
								</var>
								<var name="i_usiMeasUnitType" type="USINT">
									<descr>Measurement unit type (0=SI, 1=imperial)</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_usiRefrType" type="USINT">
									<descr>Refrigerant type</descr>
									<initValue>0</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_uiOut" type="UINT">
									<descr>Opening percentage of the EE Valve</descr>
									<initValue>0</initValue>
								</var>
								<var name="q_usiRegulStatus" type="USINT">
									<descr>Current regulation status</descr>
									<initValue>0</initValue>
								</var>
								<var name="q_iEvapTemp" type="INT">
									<descr>Evaporator saturated temperature (0.1 * °C/°F)</descr>
									<initValue>0</initValue>
								</var>
								<var name="q_iSuperHeat" type="INT">
									<descr>SuperHeat (K/°R)</descr>
									<initValue>0</initValue>
								</var>
								<var name="q_wAlarmID" type="WORD">
									<descr>Alarm word</descr>
									<initValue>0</initValue>
								</var>
								<var name="q_wAlertID" type="WORD">
									<descr>Alert word</descr>
									<initValue>0</initValue>
								</var>
							</outputVars>
							<localVars>
								<var name="xAlarm" type="BOOL">
									<descr>T: external alarm ongoing  F: no alarm, Out = 0</descr>
								</var>
								<var name="uiSuperHeatPbUnit" type="UINT">
									<descr>Super heat PID proportional band for selected unit type (0.1 * K/ °R)</descr>
								</var>
								<var name="uiSuperHeatTiUnit" type="UINT">
									<descr>Super heat PID integral time constant  for selected unit type (s)</descr>
								</var>
								<var name="uiSuperHeatTdUnit" type="UINT">
									<descr>Super heat PID derivative time constant  for selected unit type (s)</descr>
								</var>
								<var name="xEnSuperHeatEvoUnit" type="BOOL">
									<descr>Enable advanced superheat algorithm  for selected unit type</descr>
								</var>
								<var name="uiSuperHeatDzUnit" type="UINT">
									<descr>Super heat regulation dead band (advanced algorithm) for selected unit type  (0.1 * K/ °R)</descr>
								</var>
								<var name="uiMOPPbUnit" type="UINT">
									<descr>Mop PID proportional band  for selected unit type (0.1 * °C/°F/bar/psi)</descr>
								</var>
								<var name="uiMOPTiUnit" type="UINT">
									<descr>Mop PID integral time constant  for selected unit type (s)</descr>
								</var>
								<var name="uiMOPTdUnit" type="UINT">
									<descr>Mop PID derivative time constant  for selected unit type(s)</descr>
								</var>
								<var name="xEnDinSetpCalcUnit" type="BOOL">
									<descr>Enable the dynamical super heat set point calculation  for selected unit type</descr>
								</var>
								<var name="uiDinSetpMaxOffsetUnit" type="UINT">
									<descr>Maximum offset in the dynamical set point calculation  for selected unit type (0.1 * K/ °R)</descr>
								</var>
								<var name="uiSetpIncrStepUnit" type="UINT">
									<descr>Incremental step in the dynamical set point calculation  for selected unit type (0.1 * K/ °R)</descr>
								</var>
								<var name="uiSetpIncrTimeUnit" type="UINT">
									<descr>Step time in the dynamical set point calculation  for selected unit type (s)</descr>
								</var>
								<var name="xComAlarm" type="BOOL">
									<descr>TRUE: communication alarm, fixed position FALSE: normal regulation</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="udiNewVar" type="@UINT">
									<initValue>0</initValue>
								</var>
								<var name="xSelTest" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="SuperHeatCalc" type="SuperHeatCalc"/>
								<var name="iSuperHeat" type="INT">
									<descr>SuperHeat (K/°R)</descr>
								</var>
								<var name="iLastValue" type="INT"/>
								<var name="usiNodeID" type="USINT">
									<descr>T: block enabled  F: block disabled, Out = 0</descr>
									<initValue>20</initValue>
								</var>
								<var name="ptriEEVDAlarms" type="@INT">
									<initValue>?iEEVDAlarms</initValue>
								</var>
								<var name="ptriEEVDOpeningReq" type="@INT">
									<initValue>?iEEVDOpeningReq</initValue>
								</var>
								<var name="iSupHeatSetpCalc" type="INT">
									<descr>Super heat PID set point calculated</descr>
								</var>
								<var name="uiFilterCoeff" type="UINT">
									<descr>Coefficient of filter (0..255)</descr>
									<initValue>10000</initValue>
								</var>
								<var name="arCustRefParam" type="REAL" dim0="5">
									<descr>Custom Refrigerant Parameters Array</descr>
								</var>
								<var name="iCustRefPressMin" type="INT">
									<descr>Custom Refrigerant minimum pressure (*0.01 Bar)</descr>
								</var>
								<var name="iCustRefPressMax" type="INT">
									<descr>Custom Refrigerant maximum pressure (*0.01 Bar)</descr>
								</var>
								<var name="ptruiPbAlarmValue" type="@UINT">
									<descr>Output in case of process value (superheat or continuous modulation) not valid</descr>
									<initValue>?uiPbAlarmValue</initValue>
								</var>
								<var name="ptruiExtAlarmValue" type="@UINT">
									<descr>Output in case of generic external alarm</descr>
									<initValue>?uiExtAlarmValue</initValue>
								</var>
								<var name="ptruiComAlarmValue" type="@UINT">
									<descr>Output in case of communication alarm</descr>
									<initValue>?uiComAlarmValue</initValue>
								</var>
								<var name="ptrusiUnitType" type="@USINT">
									<descr>Type of unit to be controlled</descr>
									<initValue>?usiUnitType</initValue>
								</var>
								<var name="ptrxEnMOP" type="@BOOL">
									<descr>TRUE: enable the MOP regulation FALSE: disable the MOP control</descr>
									<initValue>?xEnMOP</initValue>
								</var>
								<var name="ptriMOPSetp" type="@INT">
									<descr>Mop PID set point (0.1 * °C/°F/bar/psi)</descr>
									<initValue>?iMOPSetp</initValue>
								</var>
								<var name="ptrusiContModType" type="@USINT">
									<descr>Continuous modulation type (0=disable, 1=cool, 2=heat)</descr>
									<initValue>?usiContModType</initValue>
								</var>
								<var name="ptriContModSetp" type="@INT">
									<descr>Continuous modulation setpoint (0.1 * °C/°F/bar/psi)</descr>
									<initValue>?iContModSetp</initValue>
								</var>
								<var name="ptruiMaxValue" type="@UINT">
									<descr>Maximum opening value (0.1 %)</descr>
									<initValue>?uiMaxValue</initValue>
								</var>
								<var name="ptruiDeadZoneValueMin" type="@UINT">
