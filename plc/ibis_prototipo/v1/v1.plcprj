					</functionBlock>
					<functionBlock name="ECBlueBasicSetFanAddress" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB can be used to change the Address of a Ziehl EC Blue Basic fan.

The configuration message is sent when a transition of xEn from FALSE to TRUE takes place.

The output provides the info on whether the operation has been successful or not.

The ECBlueBasicSetFanAddress AFB must be put inside the Background task of the PLC.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Transition FALSE -&gt; TRUE executes the write operation.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_usiCurrentAddress" type="USINT">
									<descr>Current Ziehl Fan ModBUS Address</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_usiTargetAddress" type="USINT">
									<descr>Target Ziehl Fan ModBUS Address. Range: 1 - 247.</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_uiMode" type="UINT">
									<descr>0: 8N1. 1: 8O1. 2: 8E1 (default). 3: 8N2</descr>
									<initValue>2</initValue>
								</var>
								<var name="i_uiBaud" type="UINT">
									<descr>0: 4800 (not supported by M172P).  1: 9600.  2: 19200 (default). 3: 38400.  4: 1115200.</descr>
									<initValue>2</initValue>
								</var>
								<var name="i_udiTWaitReboot" type="UDINT">
									<descr>Time for reboot wait in seconds. Default: 240 seconds (4 minutes).</descr>
									<initValue>240</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xChanged" type="BOOL">
									<descr>TRUE if the ModBUS Address has been successfully changed.</descr>
								</var>
								<var name="q_xWorking" type="BOOL">
									<descr>Address Change Operation in progress.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xFailed" type="BOOL">
									<descr>Address Change has failed.</descr>
								</var>
								<var name="q_xCommLost" type="BOOL">
									<descr>Impossible to double-check the successful address change, bacause communication has been lost (either because of issues on the fan side or Mode/Baud changed).</descr>
								</var>
								<var name="q_xManRebReq" type="BOOL">
									<descr>A manual fan reboot is required (through power off / power on). Or eventually uiMode and/or uiBaud have been changed.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xWrongInputs" type="BOOL">
									<descr>uiBaud and/or uiMode and/or usiTargetADR have an out-of-range value.</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT"/>
							</externalVars>
							<localVars>
								<var name="uiRet_ADR_W" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="i" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="iTargetADR" type="INT"/>
								<var name="xEn_old" type="BOOL"/>
								<var name="uiRet_PIN" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="wCOMPar" type="WORD">
									<initValue>65535</initValue>
								</var>
								<var name="k" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="l" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="uiRet_PIN_2" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="MsgNum" type="USINT">
									<initValue>10</initValue>
								</var>
								<var name="sysTDiff" type="UDINT">
									<initValue>0</initValue>
								</var>
								<var name="sysTimer_old" type="UDINT">
									<initValue>0</initValue>
								</var>
								<var name="sysTimer_RebStart" type="UDINT">
									<initValue>0</initValue>
								</var>
								<var name="uiTargetAddr" type="UINT"/>
								<var name="wCOMPar_Check" type="WORD">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_ADR_Check" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="z" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="iPINL1" type="INT">
									<initValue>1234</initValue>
								</var>
								<var name="iPIN2" type="INT">
									<initValue>3698</initValue>
								</var>
							</localVars>
							<localConsts>
								<const name="usiRetries" type="USINT">
									<descr>Operation retries.</descr>
									<initValue>5</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
