					<functionBlock name="EnergyTrend" version="1.0.1" creationDate="0" lastModifiedDate="1702560576">
						<title>Energy Trend</title>
						<descr>&lt;HTML&gt;The function block EnergyTrend is provided for applications that require energy monitoring where
the detailed energy consumption is needed for user-defined periods. It stores actual and historical
energy information on a daily, weekly, monthly, yearly, user-defined base.
It may be used with the function block Counter2Energy it may be used
independently.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable FB</descr>
								</var>
								<var name="rTotalActiveEnergy" type="REAL">
									<descr>Output from Pulse2Energy (kW)</descr>
								</var>
								<var name="ptrE2_ConsumDayPrev" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumDayPrev</descr>
								</var>
								<var name="ptrE2_ConsumDay" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumDay</descr>
								</var>
								<var name="ptrE2_ConsumWeekPrev" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumWeekPrev</descr>
								</var>
								<var name="ptrE2_ConsumWeek" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumWeek</descr>
								</var>
								<var name="ptrE2_ConsumMonthPrev" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumMonthPrv</descr>
								</var>
								<var name="ptrE2_ConsumMonth" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumMonth</descr>
								</var>
								<var name="ptrE2Arr_ConsumMonthly" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumMonthly</descr>
								</var>
								<var name="ptrE2_ConsumYearPrev" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumYearPrv</descr>
								</var>
								<var name="ptrE2_ConsumYear" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumYear</descr>
								</var>
								<var name="ptrE2_ConsumPrevReset" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumPrevReset</descr>
								</var>
								<var name="ptrE2_ConsumReset" type="@REAL">
									<descr>EEPROM Area Pointer For ConsumReset</descr>
								</var>
								<var name="ptrE2_TotalActiveEnergyPrev" type="@REAL">
									<descr>EEPROM Area Pointer PrevTotal Active Energy</descr>
								</var>
								<var name="ptrE2_DateTimeReset" type="@USINT">
									<descr>EEPROM Area Pointer For Date Time Reset</descr>
								</var>
								<var name="xConsumReset" type="BOOL">
									<descr>Consumption reset</descr>
								</var>
								<var name="xReset" type="BOOL">
									<descr>Alarm reset</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="rConsumDayPrev" type="REAL">
									<descr>Total active energy Consume PrevDay (kWh)</descr>
								</var>
								<var name="rConsumDay" type="REAL">
									<descr>Total active energy Consume Current Day (kWh)</descr>
								</var>
								<var name="rConsumWeekPrev" type="REAL">
									<descr>Total active energy Consume  Prev Week (kWh)</descr>
								</var>
								<var name="rConsumWeek" type="REAL">
									<descr>Total active energy Consume Current Week (kWh)</descr>
								</var>
								<var name="rConsumMonthPrev" type="REAL">
									<descr>Total active energy Consume Month Prev (kWh)</descr>
								</var>
								<var name="rConsumMonth" type="REAL">
									<descr>Total active energy Consume  Current Month (kWh)</descr>
								</var>
								<var name="ptrArr_ConsumMonthly" type="@REAL">
									<descr>ArrayPointer For Consume Monthly</descr>
								</var>
								<var name="rConsumYearPrev" type="REAL">
									<descr>Total active energy Consume Prev Year (kWh)</descr>
								</var>
								<var name="rConsumYear" type="REAL">
									<descr>Total active energy Consume Current Year (kWh)</descr>
								</var>
								<var name="rConsumPrevReset" type="REAL">
									<descr>Total active energy Reset Prev (kWh)</descr>
								</var>
								<var name="rConsumReset" type="REAL">
									<descr>Total active energy Reset (kWh)</descr>
								</var>
								<var name="ptrSt_DateTimeReset" type="@USINT">
									<descr>Pointer for Date Time Reset</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime">
									<descr>SystemTimer</descr>
								</var>
								<var name="sysClockError" type="BOOL">
									<descr>System clock error</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="i" type="UDINT">
									<descr>Variable For Loop</descr>
								</var>
								<var name="k" type="USINT">
									<descr>Variable For Loop</descr>
								</var>
								<var name="l_dtDateTimeResetOut" type="TypeDataTime">
									<descr>Date Time Reset Values</descr>
								</var>
								<var name="l_ptrDateTime" type="@USINT">
									<descr>Loca Pointer For Date Time</descr>
								</var>
								<var name="l_ptrEnrgy" type="@REAL">
									<descr>Local Pointer For Energy</descr>
								</var>
								<var name="l_rConsumCrntDaydelta" type="REAL">
									<descr>Day Energy Consume Difference</descr>
								</var>
								<var name="l_rConsumCrntMonthdelta" type="REAL">
									<descr>Month Energy Consume Difference</descr>
								</var>
								<var name="l_rConsumCrntWeekdelta" type="REAL">
									<descr>Week Energy Consume Difference</descr>
								</var>
								<var name="l_rConsumCrntYeardelta" type="REAL">
									<descr>Year Energy Consume Difference</descr>
								</var>
								<var name="l_rConsumdelta" type="REAL">
									<descr>Energy Consume Difference</descr>
								</var>
								<var name="l_rCurrentDayPrev" type="REAL">
									<descr>PrevDay Energy Consumption</descr>
								</var>
								<var name="l_rCurrentMonthPrev" type="REAL">
									<descr>PrevMonth Energy Consumption</descr>
								</var>
								<var name="l_rCurrentWeekPrev" type="REAL">
									<descr>PrevWeek Energy Consumption</descr>
								</var>
								<var name="l_rMonthlyConsum" type="REAL" dim0="12">
									<descr>Monthly Energy Consumption</descr>
								</var>
								<var name="l_rTotalActiveEnergyPrev" type="REAL">
									<descr>Prev Total Active Energy</descr>
								</var>
								<var name="l_usiCrntWeekDay" type="USINT">
									<descr>Current Week Day</descr>
								</var>
								<var name="l_usiCrntWeekDayPrev" type="USINT">
									<descr>Prev Week Day</descr>
								</var>
								<var name="l_usiDay" type="USINT">
									<descr>Current Day</descr>
								</var>
								<var name="l_usiDayPrev" type="USINT">
									<descr>Prev Day</descr>
								</var>
								<var name="l_usiMonth" type="USINT">
									<descr>Current Month</descr>
								</var>
								<var name="l_usiMonthPrev" type="USINT">
									<descr>Prev Month</descr>
								</var>
								<var name="l_usiYear" type="USINT">
									<descr>Current Year</descr>
								</var>
								<var name="l_usiYearPrev" type="USINT">
									<descr>Prev Year</descr>
								</var>
								<var name="l_xConsumResetOld" type="BOOL">
									<descr>Old Reset Trigger</descr>
								</var>
								<var name="l_xEnOld" type="BOOL">
									<descr>Old Enable Trigger</descr>
								</var>
								<var name="l_xTrigDay" type="BOOL">
									<descr>Day Trigger</descr>
								</var>
								<var name="l_xTrigMonth" type="BOOL">
									<descr>Month Trigger</descr>
								</var>
								<var name="l_xTrigWeek" type="BOOL">
									<descr>Week Trigger</descr>
								</var>
								<var name="l_xTrigYear" type="BOOL">
									<descr>Year Trigger</descr>
								</var>
								<var name="n" type="USINT"/>
								<var name="l_xSw" type="BOOL">
									<descr>Return Value of SystemParWriteFunction</descr>
								</var>
								<var name="l_usiHour" type="USINT">
									<descr>Current Hour</descr>
								</var>
								<var name="l_usiHourPrev" type="USINT">
									<descr>Prev Hour</descr>
								</var>
								<var name="l_xTrigHour" type="BOOL">
									<descr>Hour Trigger</descr>
								</var>
								<var name="ptrTemp" type="PVOID">
									<descr>temporary pointer</descr>
								</var>
							</localVars>
							<localConsts>
								<const name="MASKBIT1" type="UINT">
									<descr>Maskbit For Alarm</descr>
									<initValue>1</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
