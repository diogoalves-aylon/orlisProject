					<functionBlock name="EBMStatusInfo" version="1.0.0" creationDate="0" lastModifiedDate="1626186771" excludeFromBuild="FALSE">
						<descr>This AFB converts some of the most relevant ModBUS registers of the emb-papst fans into readable data on the PLC side.
For further information, refer to the ebm-papst ModBUS Specification document.</descr>
						<vars>
							<inputVars>
								<var name="i_xFanON" type="BOOL">
									<descr>Fan ON/OFF. Set to FALSE to avoid unwanted warnings.</descr>
									<initValue>TRUE</initValue>
								</var>
								<var name="i_uiRefV" type="UINT">
									<descr>Reference Voltage. Reg 53665</descr>
								</var>
								<var name="i_uiRefC" type="UINT">
									<descr>Reference Current. Reg 53666</descr>
								</var>
								<var name="i_uiPower" type="UINT">
									<descr>Fan Power. Reg 53282</descr>
								</var>
								<var name="i_uiActualSpeed" type="UINT">
									<descr>Fan Actual Speed. Reg 53265</descr>
								</var>
								<var name="i_uiMaxSpeed" type="UINT">
									<descr>Fan Max Speed. Reg 53530</descr>
								</var>
								<var name="i_uiDCLinkV" type="UINT">
									<descr>DC Link Voltage. Reg 53268</descr>
								</var>
								<var name="i_uiDCLinkC" type="UINT">
									<descr>DC Link Current. Reg 53269</descr>
								</var>
								<var name="i_uiCMod" type="UINT">
									<descr>Current Module. Reg 53274</descr>
								</var>
								<var name="i_uiSensorVal" type="UINT">
									<descr>Sensor Value. Reg 53276</descr>
								</var>
								<var name="i_uiEleTemp" type="UINT">
									<descr>Interior Electronics Temperature. Reg 53272</descr>
								</var>
								<var name="i_iMotorTemp" type="INT">
									<descr>Motor Temperature. Reg 53271</descr>
								</var>
								<var name="i_wMotorStatus" type="WORD">
									<descr>Motor Status WORD. Reg 53266</descr>
								</var>
								<var name="i_wMotorWarning" type="WORD">
									<descr>Motor Warning WORD. Reg 53267</descr>
								</var>
								<var name="i_uiOpHoursIN" type="UINT">
									<descr>Operating Hours WORD. Reg 53258</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_rFanSpeed" type="REAL">
									<descr>Fan Speed [rpm]</descr>
								</var>
								<var name="q_xAlarm" type="BOOL">
									<descr>Alarm Active</descr>
								</var>
								<var name="q_xWarning" type="BOOL">
									<descr>Warning Active</descr>
								</var>
								<var name="q_xFanBAD" type="BOOL">
									<descr>Fan BAD</descr>
								</var>
								<var name="q_iFanStatus" type="INT">
									<descr>Fan Status. 0: N/A. 1: Warning. 2: Error. 3: Ok. 4: D/C.</descr>
								</var>
								<var name="q_rPowerScd" type="REAL">
									<descr>Fan Power [W]</descr>
								</var>
								<var name="q_rDCLinkVSc" type="REAL">
									<descr>DC Link Voltage Scaled</descr>
								</var>
								<var name="q_rDCLinkCSc" type="REAL">
									<descr>DC Link Current Scaled</descr>
								</var>
								<var name="q_rCModSc" type="REAL">
									<descr>Modulation Scaled</descr>
								</var>
								<var name="q_rSensorValSc" type="REAL">
									<descr>Sensor Value</descr>
								</var>
								<var name="q_rEleTemp" type="REAL">
									<descr>Interior Electronics Temperature Scaled</descr>
								</var>
								<var name="q_rMotorTemp" type="REAL">
									<descr>Motor Temperature Out</descr>
								</var>
								<var name="q_uiOpHours" type="UINT">
									<descr>Operating Hours Out</descr>
								</var>
								<var name="q_xDCLinkUndv" type="BOOL">
									<descr>DC Link Undervoltage</descr>
								</var>
								<var name="q_xDCLinkOverv" type="BOOL">
									<descr>DC-link Overvoltage</descr>
								</var>
								<var name="q_xLockedMotor" type="BOOL">
									<descr>Locked Motor</descr>
								</var>
								<var name="q_xHallSensor" type="BOOL">
									<descr>Hall Sensor</descr>
								</var>
								<var name="q_xMotorOverheat" type="BOOL">
									<descr>Motor Overheated</descr>
								</var>
								<var name="q_xPowerModOverheat" type="BOOL">
									<descr>Power Module Overheated</descr>
								</var>
								<var name="q_xMainsUndv" type="BOOL">
									<descr>Mains Undervoltage / Phase failure</descr>
								</var>
								<var name="q_xCableBreak" type="BOOL">
									<descr>Cable Break</descr>
								</var>
								<var name="q_xEleTempHigh" type="BOOL">
									<descr>Electronics Temperature High</descr>
								</var>
								<var name="q_xMotorTempHigh" type="BOOL">
									<descr>Motor Temperature High</descr>
								</var>
								<var name="q_xOutputTempHigh" type="BOOL">
									<descr>Output Temperature High</descr>
								</var>
								<var name="q_xCommMSErr" type="BOOL">
									<descr>Communications error between master controller and slave controller</descr>
								</var>
								<var name="q_xBrake" type="BOOL">
									<descr>Brake mode: set if exterior drive is applied in opposite direction with high speed for prolonged period</descr>
								</var>
								<var name="q_xEleIntOverh" type="BOOL">
									<descr>Electronics interior overheated</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="ERROR_ALARM_DETAILS" type="WordToBit"/>
								<var name="ALARM_TIMER" type="TON"/>
								<var name="WARNING_ALARMS" type="WordToBit"/>
								<var name="WARNING_TIMER" type="TON"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
