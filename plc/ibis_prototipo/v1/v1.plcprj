								<var name="xSendCfgOld" type="BOOL"/>
								<var name="xComAlarm" type="BOOL"/>
								<var name="usiFileRes" type="USINT"/>
								<var name="EEVLoader" type="FB_EEVParFileLoader"/>
								<var name="uiOldEEVSelection" type="UINT">
									<descr>EEV selection (0=custom, 1..100 internal, 101..255 from file)</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiNodeID" type="USINT">
									<descr>node address</descr>
									<initValue>20</initValue>
								</var>
								<var name="usiEEVID" type="USINT">
									<descr>EEV ID</descr>
									<initValue>1</initValue>
								</var>
