						</sourceCode>
					</function>
					<function name="f_ECBlueBasicSpeedCtrl" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>The output returns the new Speed Value to be written onto the fan.
Its interpretation depends on how it has been set in h4 = Controlmode.
IMPORTANT: this requires the configuration function block to be used to set it to the right value (ECBlueBasicCMODE).</descr>
						<returnValue>UINT</returnValue>
						<vars>
							<inputVars>
								<var name="i_usiControlMode" type="USINT">
									<descr>1: Frequency [1/10 Hz]. 2: 0...32767. 3: 0...1000</descr>
								</var>
								<var name="i_uiSetSpeed" type="UINT">
									<descr>Input speed in 0...1000 format, if Mode is 2 or 3. In 1/10 Hz if using Mode 1 (no scaling applied for mode 1).</descr>
								</var>
							</inputVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<sourceCode type="ST" encoded="true">
							<![CDATA[ti0R9il1tJlcBRBX08lPbwtSaq8TbTcefWaqmhJJbi5p9vFwdJicBKBQ084vbmNR+qnTa6cY
