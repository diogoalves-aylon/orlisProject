									<descr>Enumeration</descr>
									<initValue>4</initValue>
								</var>
								<var name="MASKBIT_3" type="UDINT">
									<descr>Enumeration</descr>
									<initValue>8</initValue>
								</var>
								<var name="MASKBIT_4" type="UDINT">
									<descr>Enumeration</descr>
