					</functionBlock>
					<functionBlock name="WeekSchedule" version="1.0.5" creationDate="0" lastModifiedDate="1728912810">
						<title>Weekly Scheduler</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="i_xEN" type="BOOL">
									<descr>Enable of Functional Block</descr>
								</var>
								<var name="i_usiNrEvents" type="USINT">
									<descr>Total Events in Eeprom</descr>
								</var>
								<var name="i_ptrE2_Event" type="@USINT">
									<descr>Pointer of first EEprom  location of Block</descr>
								</var>
								<var name="i_xResetEvent" type="BOOL">
									<descr>Reset Trigger Event</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xTriggerEvent" type="BOOL">
									<descr>Trigger Output</descr>
								</var>
								<var name="q_usiLastEvent" type="USINT">
									<descr>Last Event happened</descr>
								</var>
								<var name="q_uiAlarmID" type="UINT">
									<descr>Alarm code</descr>
								</var>
								<var name="q_uiAlertID" type="UINT">
									<descr>Alert Code</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime">
									<descr>System Date and Time Read. It is a structure of type TypeDataTime composed by the following fields:
  seconds : USINT;
	minutes : USINT;
	hours   : USINT;
	dayweek : USINT;
	daymonth: USINT;
	month   : USINT;
	year    : USINT;</descr>
								</var>
								<var name="sysClockError" type="BOOL">
									<descr>System Date and Time invalid</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="i" type="USINT">
									<descr>Variable for loop</descr>
								</var>
								<var name="j" type="USINT">
									<descr>Variable for compositi loops</descr>
								</var>
								<var name="l_uiSysWeekTime" type="UINT">
									<descr>Clock Time converted in total week minutes</descr>
								</var>
								<var name="l_uiSysWeekTimePrevious" type="UINT">
									<descr>Previous copy of l_uiSysWeekTime</descr>
								</var>
								<var name="l_usiPtr" type="@USINT">
									<descr>Local Pointer</descr>
								</var>
								<var name="l_usiEeEventID" type="USINT">
									<descr>EEprom Event IDentifier</descr>
								</var>
								<var name="l_uiEeTime" type="UINT">
									<descr>EEprom time</descr>
								</var>
								<var name="l_usiEeDay" type="USINT">
									<descr>EEprom day of the week</descr>
								</var>
								<var name="l_uiEEWeekTimeDay" type="UINT">
									<descr>EEprom time in global minutes</descr>
								</var>
								<var name="l_uiTmpMinDeltaTime" type="UINT">
									<descr>Temporary Minutes from previous Event</descr>
								</var>
								<var name="l_uiMinDeltaTime" type="UINT">
									<descr>Minutes from previous Event</descr>
									<initValue>65535</initValue>
								</var>
								<var name="l_usiEventIDPrevious" type="USINT">
									<descr>Previous l_usiEeEventID</descr>
								</var>
								<var name="l_uiTmpMaxDeltaTime" type="UINT">
									<descr>Temporary Max Minutes from post Event</descr>
								</var>
								<var name="l_uiMaxDeltaTime" type="UINT">
									<descr>Max Minutes from post Event</descr>
								</var>
								<var name="l_usiEventIDPost" type="USINT">
									<descr>Post I_usiEeEventID</descr>
								</var>
								<var name="l_xResetEventPrevious" type="BOOL">
									<descr>Local copy Reset Trigger Event</descr>
								</var>
								<var name="l_uiPtr" type="@UINT"/>
								<var name="l_usiEventHappened" type="USINT">
									<descr>Counter for Overlapped Events</descr>
								</var>
								<var name="ptrTemp" type="PVOID">
									<descr>temporary pointer</descr>
								</var>
							</localVars>
							<localConsts>
								<const name="OVERLAP_EVENT" type="USINT">
									<initValue>1</initValue>
								</const>
								<const name="RTC_IN_ERROR" type="USINT">
									<initValue>1</initValue>
								</const>
								<const name="PARAM_OUT_OF_RANGE" type="USINT">
									<initValue>2</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
