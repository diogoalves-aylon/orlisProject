					<functionBlock name="CompAppLimit" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Compressor Application Limits</title>
						<descr>&lt;HTML&gt;The function block monitors the application limits of a compressor. The evaporation temperature
(To) and condensation temperature (Tc), which defines the operating point, must be inside defined
limits. A limit alarm will be generate when the operating point is outside of the defined limits.
NOTE: The parameters must be set according to the specification of the compressor builder.
Compressor operation is possible within the limits shown on the application diagrams. Compressor
application limits should be chosen for design purposes or continuous operation. Restrictions to
the operating limits may occur when using frequency converters.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable input for the algorithm</descr>
								</var>
								<var name="iTo" type="INT">
									<descr>Evaporation temperature (*0.1 °C)</descr>
								</var>
								<var name="iTc" type="INT">
									<descr>Condensation temperature (*0.1 °C)</descr>
								</var>
								<var name="iTo1" type="INT">
									<descr>Evaporation temperature operation limit 1 (-1000 to 1000 *0.1 °C)</descr>
								</var>
								<var name="iTo2" type="INT">
									<descr>Evaporation temperature operation limit 2 (-1000 to 1000 *0.1 °C)</descr>
								</var>
								<var name="iTo3" type="INT">
									<descr>Evaporation temperature operation limit 3 (-1000 to 1000 *0.1 °C)</descr>
								</var>
								<var name="iTo4" type="INT">
									<descr>Evaporation temperature operation limit 4 (-1000 to 1000 *0.1 °C)</descr>
								</var>
								<var name="iTc1" type="INT">
									<descr>Condensation temperature operation limit 1 (-1000 to 1000 *0.1 °C)</descr>
								</var>
								<var name="iTc2" type="INT">
									<descr>Condensation temperature operation limit 2 (-1000 to 1000 *0.1 °C)</descr>
								</var>
								<var name="iTc3" type="INT">
									<descr>Condensation temperature operation limit 3 (-1000 to 1000 *0.1 °C)</descr>
								</var>
								<var name="iTc4" type="INT">
									<descr>Condensation temperature operation limit 4 (-1000 to 1000 *0.1 °C)</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="xLimitAlarm" type="BOOL">
									<descr>Limit Alarm-Temperature out of limit</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="l_rTan2i" type="REAL">
									<descr>Tan of 4a and 4b</descr>
								</var>
								<var name="l_rTan2" type="REAL">
									<descr>Tan of 3a and 3b</descr>
								</var>
								<var name="l_rTan1i" type="REAL">
									<descr>Tan of 2a and 2b</descr>
								</var>
								<var name="l_rTan1" type="REAL">
									<descr>Tan of 1a and 1b</descr>
								</var>
								<var name="l_r4b" type="REAL">
									<descr>Difference b/w To5 and To</descr>
								</var>
								<var name="l_r4a" type="REAL">
									<descr>Difference b/w Tc5 and Tc</descr>
								</var>
								<var name="l_r3b" type="REAL">
									<descr>Difference b/w To5 and To6</descr>
								</var>
								<var name="l_r3a" type="REAL">
									<descr>Difference b/w Tc5 and Tc6</descr>
								</var>
								<var name="l_r2b" type="REAL">
									<descr>Difference b/w To and To2</descr>
								</var>
								<var name="l_r2a" type="REAL">
									<descr>Difference b/w Tc and Tc2</descr>
								</var>
								<var name="l_r1b" type="REAL">
									<descr>Difference b/w To3 and To2</descr>
								</var>
								<var name="l_r1a" type="REAL">
									<descr>Difference b/w Tc3 and Tc2</descr>
								</var>
								<var name="l_iTo6" type="INT">
									<descr>Local Variable for setpoint of working area To6</descr>
								</var>
								<var name="l_iTo5" type="INT">
									<descr>Local Variable for setpoint of working area To5</descr>
								</var>
								<var name="l_iTo4" type="INT">
									<descr>Local Variable for setpoint of working area To4</descr>
								</var>
								<var name="l_iTo3" type="INT">
									<descr>Local Variable for setpoint of working area To3</descr>
								</var>
								<var name="l_iTo2" type="INT">
									<descr>Local Variable for setpoint of working area To2</descr>
								</var>
								<var name="l_iTo1" type="INT">
									<descr>Local Variable for setpoint of working area To1</descr>
								</var>
								<var name="l_iTc6" type="INT">
									<descr>Local Variable for setpoint of working area Tc6</descr>
								</var>
								<var name="l_iTc5" type="INT">
									<descr>Local Variable for setpoint of working area Tc5</descr>
								</var>
								<var name="l_iTc4" type="INT">
									<descr>Local Variable for setpoint of working area Tc4</descr>
								</var>
								<var name="l_iTc3" type="INT">
									<descr>Local Variable for setpoint of working area Tc3</descr>
								</var>
								<var name="l_iTc2" type="INT">
									<descr>Local Variable for setpoint of working area Tc2</descr>
								</var>
								<var name="l_iTc1" type="INT">
									<descr>Local Variable for setpoint of working area Tc1</descr>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
