									<descr>Compressor run command</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="udiOpHours" type="UDINT">
									<descr>Operating hours</descr>
								</var>
								<var name="udiNbStarts" type="UDINT">
									<descr>Total number of starts</descr>
								</var>
								<var name="udiCompMgmtStatus" type="UDINT">
									<descr>Status from Compressor Management FB</descr>
								</var>
								<var name="uiElapsedOnTime" type="UINT">
									<descr>Compressor remaining on time (s)</descr>
								</var>
								<var name="uiElapsedOffTime" type="UINT">
									<descr>Compressor remaining off time (s)</descr>
								</var>
								<var name="uiElapsedCycleTime" type="UINT">
									<descr>Compressor remaining Cycle time (s)</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT">
									<descr>system Timer millisecond</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="l_xCommand" type="BOOL">
									<descr>Internal variable for Command input</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="l_xPUsed" type="BOOL">
									<descr>Internal variable for compressor previously used.</descr>
								</var>
								<var name="CompRunTrig" type="R_TRIG">
									<descr>R_TRIG for Comp Run Command and Reset</descr>
								</var>
								<var name="xEnOld" type="BOOL">
									<descr>Previous state of Enable</descr>
								</var>
								<var name="STATE_IDLE" type="USINT">
									<descr>Enumeration</descr>
									<initValue>1</initValue>
								</var>
								<var name="MODE_AUTOMATIC" type="USINT">
									<descr>Enumeration</descr>
									<initValue>1</initValue>
								</var>
								<var name="MODE_MANUAL" type="USINT">
									<descr>Enumeration</descr>
									<initValue>2</initValue>
								</var>
								<var name="MODE_MAINTENANCE" type="USINT">
									<descr>Enumeration</descr>
									<initValue>3</initValue>
								</var>
