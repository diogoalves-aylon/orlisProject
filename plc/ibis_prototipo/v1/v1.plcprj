					<functionBlock name="ECBlueBasicMotorReset" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB can be used to send a motor reset to a Ziehl EC Blue Basic fan.
The reset is sent when a transition of xEn from FALSE to TRUE takes place.

The output provides the info on whether the operation has been successful or not.

The ECBlueBasicMotorReset AFB must be put inside the Background task of the PLC.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Transition FALSE -&gt; TRUE changes the settings in the fan</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_usiZiehlAddress" type="USINT">
									<descr>Ziehl Fan Address. Broadcast not suppoted. Default: 1.</descr>
									<initValue>1</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xResetOK" type="BOOL">
									<descr>TRUE if the Motor Reset has been successfull</descr>
								</var>
								<var name="q_xWorking" type="BOOL">
									<descr>Reset in progress</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xResetFailed" type="BOOL">
									<descr>Reset has failed</descr>
								</var>
								<var name="q_xWrongInputs" type="BOOL">
									<descr>Fan Address out of range</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="i" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="xEn_old" type="BOOL"/>
								<var name="uiRet_PINReset" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="iPINReset" type="INT">
									<initValue>2143</initValue>
								</var>
							</localVars>
							<localConsts>
								<const name="usiRetries" type="USINT">
									<descr>Operation retries</descr>
									<initValue>5</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
							<![CDATA[ti0R9il1tJlcBRBX08lPbwtSaq8TbTcefWaqmhJJZi1J9YFwTJr0BnhVG8sXbCtSEqwzbncd
