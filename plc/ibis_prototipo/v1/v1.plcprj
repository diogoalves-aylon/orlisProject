					</functionBlock>
					<functionBlock name="FanMgmt" version="1.0.3" creationDate="0" lastModifiedDate="1702637829">
						<title>Fans Management</title>
						<descr>&lt;HTML&gt;The FanMgmt (Fan Management) function block manages the following functionalities
and control the cold source condensation temperature in HVAC&amp;R system. 

1.	Switch On and Off the number of fans requiredstages according the uiFanControlSignal
 (calculated by FloatingPresHighCntrl FB) to control the cold source condensation temperature.
2.	On and Off sequence control of condenser fansstages.
3.	Fan Stage failure change over management when fan stage alarm occurs.
4.	Fan speed calculation.
5.4.Manage operating hours of fanstage. 

Fan Stage On / Off sequence is controlled in the following two sequences 
specified in FanMode parameter:
-	Fan sequence FIFO 
-	Fan sequence Runtime 
-	Fan sequence LIFO

The fan speed signal is controlled in the following four 2 modes 
specified in xFanFreqMode parameter:
-	Manual mode
-	Auto mode</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>True: FB  enabled False: FB disabled</descr>
								</var>
								<var name="uiFanCntrlSignal" type="UINT">
									<descr>Fan Control Signal (0 to 1000 * 0.1% Default : 0)</descr>
								</var>
								<var name="xStage1Alarm" type="BOOL">
									<descr>True : Stage1 alarm active False : Stage 1 alarm not active</descr>
								</var>
								<var name="xStage2Alarm" type="BOOL">
									<descr>True : Stage 2 alarm active False : Stage 2 alarm not active</descr>
								</var>
								<var name="xStage3Alarm" type="BOOL">
									<descr>True : Stage 3 alarm active False : Stage 3 alarm not active</descr>
								</var>
								<var name="xStage4Alarm" type="BOOL">
									<descr>True : Stage 4 alarm active False : Stage 4 alarm not active</descr>
								</var>
								<var name="xLowNoiseOper" type="BOOL">
									<descr>True: Low noise operation activates. False: Low noise operation deactivates.</descr>
								</var>
								<var name="usiNbStage" type="USINT">
									<descr>Number of stages (1 to 4)</descr>
								</var>
								<var name="usiNbFanStage1" type="USINT">
									<descr>Maximum number of fans to be controlled Stage1 (1 to 12) (FB restart required if changed.)</descr>
								</var>
								<var name="usiNbFanStage2" type="USINT">
									<descr>Maximum number of fans to be controlled Stage2 (1 to 12) (FB restart required if changed.)</descr>
								</var>
								<var name="usiNbFanStage3" type="USINT">
									<descr>Maximum number of fans to be controlled Stage3 (1 to 12) (FB restart required if changed.)</descr>
								</var>
								<var name="usiNbFanStage4" type="USINT">
									<descr>Maximum number of fans to be controlled Stage4 (1 to 12) (FB restart required if changed.)</descr>
								</var>
								<var name="usiFanMode" type="USINT">
									<descr>Fan On/Off sequence mode, 0: FIFO, 1: Runtime, 2: LIFO (Default: 0 FB restart required if changed.)</descr>
								</var>
								<var name="usiPriorityStage1" type="USINT">
									<descr>Priority of Stage1 (0 to 255) (If 2 PriorityStage are equal, the runtime mode is applied between both)</descr>
								</var>
								<var name="usiPriorityStage2" type="USINT">
									<descr>Priority of Stage2 (0 to 255) (If 2 PriorityStage are equal, the runtime mode is applied between both)</descr>
								</var>
								<var name="usiPriorityStage3" type="USINT">
									<descr>Priority of Stage3 (0 to 255) (If 2 PriorityStage are equal, the runtime mode is applied between both)</descr>
								</var>
								<var name="usiPriorityStage4" type="USINT">
									<descr>Priority of Stage4 (0 to 255) (If 2 PriorityStage are equal, the runtime mode is applied between both)</descr>
								</var>
								<var name="uiFanFreqMin" type="UINT">
									<descr>VSD minimum frequency (50 to 5000 *0.1 Hz Default: 200)</descr>
									<initValue>200</initValue>
								</var>
								<var name="uiFanFreqMax" type="UINT">
									<descr>VSD maximum frequency	(51 to 5000 *0.1 Hz  Default: 500)</descr>
									<initValue>500</initValue>
								</var>
								<var name="xMode" type="BOOL">
									<descr>0: automatic, 1: manual</descr>
								</var>
								<var name="xManualStage1" type="BOOL">
									<descr>Manual mode of stage1</descr>
								</var>
								<var name="xManualStage2" type="BOOL">
									<descr>Manual mode of stage2</descr>
								</var>
								<var name="xManualStage3" type="BOOL">
									<descr>Manual mode of stage3</descr>
								</var>
								<var name="xManualStage4" type="BOOL">
									<descr>Manual mode of stage4</descr>
								</var>
								<var name="uiManualFreq" type="UINT">
									<descr>Mode manual fan (*0.1 Hz)</descr>
								</var>
								<var name="uiLowNoiseMaxFreq" type="UINT">
									<descr>VSD low noise operation frequency reduction (uiFanFreqMin to uiFanFreqMax *0.1 Hz Default: 200 )</descr>
									<initValue>200</initValue>
								</var>
								<var name="uiFanDelayIncr" type="UINT">
									<descr>Delay in incrementing the running number of fans (0 to 60 *s Default: 0)</descr>
								</var>
								<var name="uiFanDelayDecr" type="UINT">
									<descr>Delay in decrementing the running number of fans (0 to 60 *s Default: 0)</descr>
								</var>
								<var name="uiMinOffTime" type="UINT">
									<descr>Minimum off time for every stage ( *s, If 1 stage is in anticourtcycle, the next stage is engaged If all stages are in anticourtcycle, the engagement is forced)</descr>
								</var>
								<var name="xOpHoursRst" type="BOOL">
									<descr>Reset for Stage1…4 operating hours (Resets at rising edge)</descr>
								</var>
								<var name="uiHysteresis" type="UINT">
									<descr>Hysteresis for the frequency (1 to 5000 *0.1 Hz Default: 1)</descr>
									<initValue>1</initValue>
								</var>
								<var name="ptrE2_OpHrsSt1" type="@UDINT">
									<descr>Pointer to retain variable storage for Op Hours</descr>
								</var>
								<var name="ptrE2_OpHrsSt2" type="@UDINT">
									<descr>Pointer to retain variable storage for Op Hours</descr>
								</var>
								<var name="ptrE2_OpHrsSt3" type="@UDINT">
									<descr>Pointer to retain variable storage for Op Hours</descr>
								</var>
								<var name="ptrE2_OpHrsSt4" type="@UDINT">
									<descr>Pointer to retain variable storage for Op Hours</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="usiState" type="USINT">
									<descr>0:Idle, 1:Run, 2:Alert, 3:Alarm (0 to 3)</descr>
								</var>
								<var name="xVSD" type="BOOL">
									<descr>Drive command</descr>
								</var>
								<var name="uiFanFreq" type="UINT">
									<descr>Fan speed signal to VSD (0 to 1000 *0.1 Hz  Default: 0)</descr>
								</var>
								<var name="xCmdeStage1" type="BOOL">
									<descr>stage1 Command</descr>
								</var>
								<var name="xCmdeStage2" type="BOOL">
									<descr>stage2 Command</descr>
								</var>
								<var name="xCmdeStage3" type="BOOL">
									<descr>stage3 Command</descr>
								</var>
								<var name="xCmdeStage4" type="BOOL">
									<descr>stage4 Command</descr>
								</var>
								<var name="udiOpHoursSt1" type="UDINT">
									<descr>Stage1 total operating  hours (hours)</descr>
								</var>
								<var name="udiOpHoursSt2" type="UDINT">
									<descr>Stage2 total operating  hours (hours)</descr>
								</var>
								<var name="udiOpHoursSt3" type="UDINT">
									<descr>Stage3 total operating  hours (hours)</descr>
								</var>
								<var name="udiOpHoursSt4" type="UDINT">
									<descr>Stage4 total operating  hours (hours)</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm Id</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert Id</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT"/>
							</externalVars>
							<localVars>
								<var name="l_xOffTimer" type="BOOL" dim0="4"/>
								<var name="l_xStageAlarm" type="BOOL" dim0="4"/>
								<var name="l_xTrash" type="BOOL"/>
								<var name="xCmdeStage" type="BOOL" dim0="4"/>
								<var name="xFirstGroupStarted" type="BOOL"/>
								<var name="xIdenticalNbFanStage" type="BOOL"/>
								<var name="xInvalidFanMode" type="BOOL"/>
								<var name="xInvalidMode" type="BOOL"/>
								<var name="xLastGroup" type="BOOL"/>
								<var name="xlFound" type="BOOL"/>
								<var name="xLowNoiseAlert" type="BOOL"/>
								<var name="xMinMaxInversion" type="BOOL"/>
								<var name="xNbFanOutOfRange" type="BOOL"/>
								<var name="xOutOfRangeCntrlSignal" type="BOOL"/>
								<var name="xOutOfRangeDelayDecr" type="BOOL"/>
								<var name="xOutOfRangeDelayIncr" type="BOOL"/>
								<var name="xOutOFRangeFreqMax" type="BOOL"/>
								<var name="xOutOfRangeFreqMin" type="BOOL"/>
								<var name="xOutOfRangeHyst" type="BOOL"/>
								<var name="xParamLatch" type="BOOL"/>
								<var name="xStopping" type="BOOL"/>
								<var name="arusil_FIFOStopPriority" type="USINT" dim0="4"/>
								<var name="arusil_StopPriority" type="USINT" dim0="4"/>
								<var name="i" type="USINT"/>
								<var name="j" type="USINT"/>
