					<functionBlock name="ThermalPowerFromTemperature" version="1.0.0" creationDate="0" lastModifiedDate="1729506511">
						<title>Thermal Power From Temperature</title>
						<descr>&lt;HTML&gt;&lt;p&gt;The ThermalPowerCalculation function block calculates the thermal power and the thermal energy produced. 
The calculation of the thermal power of a hydraulic system is based on the mass flow rate, the heat capacity of the medium, and the temperature difference before and after heat dissipation. &lt;/p&gt;

&lt;p&gt;The ThermalPowerCalculation function block provides the following features: 
&lt;li&gt;provides the instant thermal power and the total thermal energy. &lt;/li&gt;
&lt;li&gt;allows you to measure total thermal energy over a used-defined period. &lt;/li&gt;
&lt;li&gt;can work with metering devices providing either mass flow or volume flow information. &lt;/li&gt;
&lt;li&gt;provides thermal energy information in the right format to be used on the COPcalculation function block. &lt;/li&gt;
&lt;/p&gt;

&lt;p&gt;Energy is stored into EEprom once per hour after enabling or reset and when block is disabled&lt;/p&gt;

&lt;p&gt;The thermal power is calculated based on the following formula: 
&lt;br&gt;Pth =m * c * |ΔT|
&lt;br&gt;[Pth] = g/s * kJ / (kg * K) * K / 1000= kW 
&lt;br&gt;with 
&lt;br&gt;m = mass flow in g/s 
&lt;br&gt;c = specific heat in kWs / (kg*K) = kJ/(kg*K) 
&lt;br&gt;ΔT = temperature difference
&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable of the function Block</descr>
								</var>
								<var name="iInputTemp" type="INT">
									<descr>Input Temperature (*0.1 °C)</descr>
								</var>
								<var name="iOutputTemp" type="INT">
									<descr>Output Temperature (*0.1 °C)</descr>
								</var>
								<var name="rFlow" type="REAL">
									<descr>Flow rate of Material (g/s)</descr>
								</var>
								<var name="rHeatCap" type="REAL">
									<descr>Specific Heat of Material (kJ/(kg * K) )</descr>
								</var>
								<var name="rDensity" type="REAL">
									<descr>Density of Material (Default: 1.0)</descr>
									<initValue>1.0</initValue>
								</var>
								<var name="ptrE2_ThermalEnergySaved" type="@REAL">
									<descr>Pointer for Thermal Energy Saved in EEPROM Area</descr>
								</var>
								<var name="xReset" type="BOOL">
									<descr>Reset</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="rThermalPower" type="REAL">
									<descr>Thermal Power (kW)</descr>
								</var>
								<var name="rThermalEnergy" type="REAL">
									<descr>Thermal Energy (kWh)</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT">
									<descr>SystemTimer</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="l_iTempDelta" type="INT">
									<descr>Diffrerence Between The input and output Temperature</descr>
								</var>
								<var name="l_rThermalEnergy" type="REAL">
									<descr>Thermal Energy</descr>
								</var>
								<var name="l_rThermalEnergyOld" type="REAL">
									<descr>Old Value of Thermal Energy</descr>
								</var>
								<var name="l_rThermalPower" type="REAL">
									<descr>Thermal Power</descr>
								</var>
								<var name="l_udiSecondTimerEl" type="UDINT">
									<descr>Second Timer</descr>
								</var>
								<var name="l_udisysTimer_old" type="UDINT">
									<descr>Old  Values of system Timer</descr>
								</var>
								<var name="l_uiAlertId" type="UINT">
									<descr>Alert ID</descr>
								</var>
								<var name="l_xIsFirstMain" type="BOOL">
									<descr>First scan  bit</descr>
								</var>
								<var name="l_xSw" type="BOOL">
									<descr>Return Value System EEPROM function</descr>
								</var>
								<var name="l_xResetOld" type="BOOL">
									<descr>Old Reset Value</descr>
								</var>
								<var name="l_udiHourTimerEl" type="UDINT"/>
								<var name="xRstEnergy" type="BOOL"/>
								<var name="udiDiffTimer" type="UDINT">
									<descr>Timer difference</descr>
								</var>
							</localVars>
							<localConsts>
								<const name="MASKBIT1" type="UINT">
									<descr>Maskbit1 for alarm of Thermal power reached to max value</descr>
									<initValue>1</initValue>
								</const>
								<const name="MASKBIT2" type="UINT">
									<descr>Maskbit2 for alarm of Thermal Energy reached to max value</descr>
									<initValue>2</initValue>
								</const>
								<const name="MAXREAL" type="REAL">
									<descr>Max value of Real</descr>
									<initValue>3.40E+38</initValue>
								</const>
								<const name="SECONDTIMER" type="UDINT">
									<descr>Second Timer</descr>
									<initValue>1000</initValue>
								</const>
								<const name="HOURTIMER" type="UDINT">
									<descr>Second Timer</descr>
									<initValue>3600000</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
