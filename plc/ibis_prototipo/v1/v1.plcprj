					<functionBlock name="FB_EEVAlarmsMgmt" version="1.0.1" hidden="true" creationDate="0" lastModifiedDate="1601563475" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV alarms management</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>enable</descr>
								</var>
								<var name="uiAlarmParams" type="UINT"/>
								<var name="uiAlertParams" type="UINT"/>
								<var name="xSHPbAlarm" type="BOOL"/>
								<var name="xMOPPbAlarm" type="BOOL"/>
								<var name="xContModPbAlarm" type="BOOL"/>
								<var name="xMOPAlarm" type="BOOL"/>
								<var name="xExtAlarm" type="BOOL"/>
								<var name="xComAlarm" type="BOOL"/>
								<var name="xEEPAlarm" type="BOOL"/>
								<var name="xOpenAlert" type="BOOL"/>
							</inputVars>
							<outputVars>
								<var name="xAlarm" type="BOOL">
									<descr>T: the alarm occured</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>T: the alarm occured</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>T: the alarm occured</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="Timer" type="TON"/>
								<var name="t_on" type="BOOL"/>
								<var name="usiTestTask" type="USINT"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
