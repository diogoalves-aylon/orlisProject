					<functionBlock name="COPCalculation" version="1.0.2" creationDate="0" lastModifiedDate="1702911374">
						<title>Coefficient Of Performance calculations</title>
						<descr>&lt;HTML&gt;The coefficient of performance (COP) indicates the efficiency of heating and cooling machines.
The higher the COP, the more efficient the machine operates.
The COP is defined by the ratio heat dissipation and electrical power intake.
The COPCalculation function block calculates the COP based on the following formula:
COP = thermal power (kW) / electrical power (kW)
seasonal COP = thermal energy (kWh) / electrical energy (kWh)</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable of the Function Block</descr>
								</var>
								<var name="rElecPower" type="REAL">
									<descr>Electric Power (kW)</descr>
								</var>
								<var name="rThermalPower" type="REAL">
									<descr>Thermal Power (kW)</descr>
								</var>
								<var name="rElecEnergy" type="REAL">
									<descr>Electric Energy (kWh)</descr>
								</var>
								<var name="rThermalEnergy" type="REAL">
									<descr>Thermal Energy (kWh)</descr>
								</var>
								<var name="ptrE2_EnergyRead" type="@BOOL">
									<descr>Pointer for  Energy Read Variable in EEPROM Area</descr>
								</var>
								<var name="ptrE2_ElecEnergySaved" type="@REAL">
									<descr>Pointer for  ElecEnergySaved Variable in EEPROM Area</descr>
								</var>
								<var name="ptrE2_ThermalEnergySaved" type="@REAL">
									<descr>Pointer for ThermalEnergySaved Variable in EEPROM Area</descr>
								</var>
								<var name="ptrE2_COPLastReset" type="@USINT">
									<descr>Pointer for  COPLastReset  Variable in EEPROM Area</descr>
								</var>
								<var name="xReset" type="BOOL">
									<descr>Reset bit to Reset the COP calulation</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="uiLongTermCOP" type="UINT">
									<descr>Long Term COP (*0.01)</descr>
								</var>
								<var name="uiShortTermCOP" type="UINT">
									<descr>Short-term COP (*0.01)</descr>
								</var>
								<var name="uiInstantCOP" type="UINT">
									<descr>Instant COP (*0.01)</descr>
								</var>
								<var name="PtrSt_COPLastReset" type="@USINT">
									<descr>Pointer For Date and time of last reset</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime">
									<descr>System Clock</descr>
								</var>
								<var name="sysTimer" type="UDINT">
									<descr>System Timer</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="i" type="USINT">
									<descr>Variable For For Loop</descr>
								</var>
								<var name="l_dtDateResetTime" type="TypeDataTime">
									<descr>Date Time Reset of Last COP</descr>
								</var>
								<var name="l_ptrDateTime" type="@USINT">
									<descr>Pointer For Date Time</descr>
								</var>
								<var name="l_rElecDelta" type="REAL">
									<descr>Diffrence Between Electric Energy</descr>
								</var>
								<var name="l_rElecEnergyT1" type="REAL">
									<descr>Last Saved Energy After Reset</descr>
								</var>
								<var name="l_rLastValueEnergy" type="REAL" dim0="5">
									<descr>Last Values of  Elec energy over five minutes</descr>
								</var>
								<var name="l_rLastValueThermal" type="REAL" dim0="5">
									<descr>Last Values of  Thermal energy over five minutes</descr>
								</var>
								<var name="l_rThermalDelta" type="REAL">
									<descr>Diffrence Between Thermal Energy</descr>
								</var>
								<var name="l_rThermalEnergyT1" type="REAL">
									<descr>Last Thermal Energy After Reset</descr>
								</var>
								<var name="l_udiElapsedTime" type="UDINT">
									<descr>Elapsed Time Of COP calulation Timer</descr>
								</var>
								<var name="l_udiElapsedTimeOld" type="UDINT">
									<descr>Old Elapsed Time of Cop Calulation</descr>
								</var>
								<var name="l_udisysTimer_old" type="UDINT">
									<descr>Old Value of system Timer</descr>
								</var>
								<var name="l_xFirstRead" type="BOOL">
									<descr>First Read Bit of Energy Values</descr>
								</var>
								<var name="l_xResetOld" type="BOOL">
									<descr>Reset bit To generate the Reset Trigger</descr>
								</var>
								<var name="l_xSW" type="BOOL">
									<descr>Resturn Value of SysParWrite Function</descr>
								</var>
								<var name="ptrTemp" type="PVOID">
									<descr>temporary pointer</descr>
								</var>
							</localVars>
							<localConsts>
								<const name="DELAY" type="UINT">
									<descr>Delay for calulation of Long Term COP And Short Term COP</descr>
									<initValue>60000</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
