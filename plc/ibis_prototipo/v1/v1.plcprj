							<Pou name="Counter2Energy"/>
							<Pou name="COPCalculation"/>
							<Pou name="EnergyTrend"/>
							<Pou name="Pulse2Counter"/>
							<Pou name="ThermalPowerFromTemperature"/>
						</folder>
						<folder name="Refrigeration">
							<Pou name="CircuitMgmt"/>
							<Pou name="CompAlarmMgmt"/>
							<Pou name="CompAppLimit"/>
							<Pou name="EvapPressCntrl"/>
							<Pou name="FloatingHighPresCntrl"/>
							<Pou name="Fluid_Density"/>
							<Pou name="Fluid_Enthalpy"/>
							<Pou name="HPDefrCircuitPriority"/>
							<Pou name="ModeSelection"/>
							<Pou name="CompCntrl_OnOff"/>
							<Pou name="CompCntrl_Slider"/>
							<Pou name="CompCntrl_VS"/>
							<Pou name="CompMgmt"/>
							<Pou name="DoubleInterpo_5x8"/>
							<Pou name="FanMgmt"/>
							<Pou name="HPDefrostAndRevValve"/>
							<Pou name="Press2Temp"/>
							<Pou name="Temp2Press"/>
							<Pou name="ThermalPowerFromEnthalpy"/>
							<Pou name="CompMgmtVS"/>
						</folder>
						<folder name="Water">
							<Pou name="FloatingWaterTempSet"/>
							<Pou name="RedundantPumpCntrl"/>
							<Pou name="SetPointStepFilter"/>
							<Pou name="WaterLaw"/>
						</folder>
						<folder name="Legacy" descr="" version="" excludeFromBuildIfNotDef="">
							<Pou name="ThermalPowerCalculation"/>
							<Pou name="ThermalPower_Enthalpy"/>
						</folder>
					</folder>
				</libWorkspace>
				<globalVars/>
				<retainVars/>
				<constantVars/>
				<iecVarsDeclaration/>
				<functions/>
				<functionBlocks>
					<functionBlock name="AHUPlantModeStrategy" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Plant mode strategy for AHU</title>
						<descr>&lt;HTML&gt;This function block is a control strategy function block. 
This function sets the operation mode of an air handling unit (AHU). 
This function block is used along with other AHU module blocks.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable input for the FB</descr>
								</var>
								<var name="xFreezeStatAlarm" type="BOOL">
									<descr>Freeze alarm</descr>
								</var>
								<var name="xFanAlarm" type="BOOL">
									<descr>Fan alarm</descr>
								</var>
								<var name="xFireAlarm" type="BOOL">
									<descr>Fire alarm</descr>
								</var>
								<var name="xExtendedOper" type="BOOL">
									<descr>Extended operation</descr>
								</var>
								<var name="xSchedule" type="BOOL">
									<descr>Schedule (Digital)</descr>
								</var>
								<var name="iRoomTemp" type="INT">
									<descr>Room Temperature (*0.1 °C/°F)</descr>
									<initValue>-9999</initValue>
								</var>
								<var name="iOutdoorAirTemp" type="INT">
									<descr>Outdoor Air Temperature (*0.1 °C/°F)</descr>
									<initValue>-9999</initValue>
								</var>
								<var name="iNightpurgeOutdoorAirTempMin" type="INT">
									<descr>NIPU minimum outdoor air temperature (-580 to +3020 *0.1 °C/°F)</descr>
									<initValue>100</initValue>
								</var>
								<var name="iNightpurgeRoomTempMin" type="INT">
									<descr>NIPU minimum room temperature (-580 to +3020 *0.1 °C/°F)</descr>
									<initValue>180</initValue>
								</var>
								<var name="iNightpurgeOutdoorAirTempDiff" type="INT">
									<descr>NIPU difference between room temperature and outdoor air temperature (0 to 500 *0.1 °C/°F)</descr>
									<initValue>40</initValue>
								</var>
								<var name="iNightpurgeOutdoorAirTempHys" type="INT">
									<descr>NIPU hysteresis outdoor air temperature (0 to 500 *0.1 °C/°F)</descr>
									<initValue>20</initValue>
								</var>
								<var name="iNightpurgeRoomTempHys" type="INT">
									<descr>NIPU hysteresis room temperature (0 to 500 *0.1 °C/°F)</descr>
									<initValue>20</initValue>
								</var>
								<var name="uiNightpurgeTimeStart" type="UINT">
									<descr>NIPU start time (0 to 2359)</descr>
									<initValue>200</initValue>
								</var>
								<var name="uiNightpurgeTimeStop" type="UINT">
									<descr>NIPU stop time (0 to 2359)</descr>
									<initValue>600</initValue>
								</var>
								<var name="usiNightpurgeDays" type="USINT">
									<descr>NIPU days  (0 to 255)</descr>
									<initValue>127</initValue>
								</var>
								<var name="iNightcycleRoomTempMin" type="INT">
									<descr>Night cycle minimum room temperature  (-580 to +3020 *0.1 °C/°F)</descr>
									<initValue>100</initValue>
								</var>
								<var name="iNightcycleRoomTempMax" type="INT">
									<descr>Night cycle maximum room temperature  (-580 to +3020 *0.1 °C/°F)</descr>
									<initValue>300</initValue>
								</var>
								<var name="iNightcycleRoomTempHys" type="INT">
									<descr>Night cycle hysteresis room temperature  (0 to 500 *0.1 °C/°F)</descr>
									<initValue>20</initValue>
								</var>
								<var name="iRoomTempMaxLimit" type="INT">
									<descr>Maximum room temperature (-580 to +3020 *0.1 °C/°F)</descr>
									<initValue>400</initValue>
								</var>
								<var name="iRoomTempMinLimit" type="INT">
									<descr>Minimum room temperature (-580 to +3020 *0.1 °C/°F)</descr>
									<initValue>120</initValue>
								</var>
								<var name="uiInitializationDelay" type="UINT">
									<descr>Initialization Delay (0 to 600 *s)</descr>
									<initValue>10</initValue>
								</var>
								<var name="uiAHUOffDelay" type="UINT">
									<descr>AHU Off Delay (0 to 600 *s)</descr>
									<initValue>10</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="usiPlantMode" type="USINT">
									<descr>Plant mode (0 to 23)</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime"/>
								<var name="sysClockError" type="BOOL"/>
							</externalVars>
							<localVars>
								<var name="xNightCyclemode" type="BOOL"/>
								<var name="xNightPurgemode" type="BOOL"/>
								<var name="usiPlantModeCalc" type="USINT"/>
								<var name="iTempMin_Low" type="INT">
									<initValue>-580</initValue>
								</var>
								<var name="iTempMin_High" type="INT">
									<initValue>3020</initValue>
								</var>
								<var name="iHyst_Low" type="INT">
									<initValue>0</initValue>
								</var>
								<var name="iHyst_High" type="INT">
									<initValue>500</initValue>
								</var>
								<var name="uiDelay_High" type="UINT">
									<initValue>600</initValue>
								</var>
								<var name="xAlertBit0" type="BOOL">
									<descr>Improper parameter value or configuration</descr>
								</var>
								<var name="xAlertBit1" type="BOOL">
									<descr>RoomTemp probe disconnection error</descr>
								</var>
								<var name="xAlertBit2" type="BOOL">
									<descr>OutdoorAirTemp probe disconnection error</descr>
								</var>
								<var name="xAlertBit3" type="BOOL">
									<descr>Maximum RMT alert</descr>
								</var>
								<var name="xAlertBit4" type="BOOL">
									<descr>Minimum RMT alert</descr>
								</var>
								<var name="xAlertBit5" type="BOOL">
									<descr>Freeze alarm</descr>
								</var>
								<var name="xAlertBit6" type="BOOL">
									<descr>Fan alarm</descr>
								</var>
								<var name="xAlertBit7" type="BOOL">
									<descr>Fire alarm</descr>
								</var>
								<var name="xAlertBit8" type="BOOL">
									<descr>RTC error</descr>
								</var>
								<var name="xAlertBit9" type="BOOL">
									<descr>Param change runtime</descr>
								</var>
								<var name="iHystFix" type="INT">
									<initValue>10</initValue>
								</var>
								<var name="RealTimeClock" type="TypeDataTime"/>
								<var name="xDayEnabled" type="BOOL"/>
								<var name="xNIPUPeriodStart" type="BOOL"/>
								<var name="xRMTHyst" type="BOOL"/>
								<var name="xOATHyst" type="BOOL"/>
								<var name="xOATDiffHyst" type="BOOL"/>
								<var name="uiInitDelay" type="UINT"/>
								<var name="xCJ_GetSecondTic" type="BOOL"/>
								<var name="second_memo" type="UINT"/>
								<var name="xInit" type="BOOL"/>
								<var name="uiOffDelay" type="UINT"/>
