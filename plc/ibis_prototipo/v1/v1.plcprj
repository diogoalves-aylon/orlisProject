					<functionBlock name="Fluid_Enthalpy" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Fluid enthalpy calculation</title>
						<descr>&lt;HTML&gt;Calculate the enthalpy of a refrigerant based on the refrigerant temperature and pressure and the refrigerant type.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable/Disable the function block</descr>
								</var>
								<var name="iTemp" type="INT">
									<descr>Refrigerant temperature (*0.1 °C)</descr>
								</var>
								<var name="iPress" type="INT">
									<descr>Refrigerant relative pressure (*0.01 bar)</descr>
								</var>
								<var name="usiRefType" type="USINT">
									<descr>Refrigerant type (0 to 12)</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiRefState" type="USINT">
									<descr>Refrigerant state (1 to 2 Default: 1)</descr>
									<initValue>1</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="rEnth" type="REAL">
									<descr>Refrigerant enthalpy (kJ/kg)</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="arParam" type="REAL" dim0="6"/>
								<var name="xAlertBit0" type="BOOL"/>
								<var name="xAlertBit1" type="BOOL"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
