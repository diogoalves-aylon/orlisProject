					</functionBlock>
					<functionBlock name="ECBlueBasicLimit" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB can be used to set the Limit parameter (h18, reg19).

Speed limit when activated by a digital control function.

The configuration message is sent when a transition of xEn from FALSE to TRUE takes place.

The output provides the info on whether the operation has been successful or not.

The ECBlueBasicLimit AFB must be put inside the Background task of the PLC.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Transition FALSE -&gt; TRUE changes the settings in the fan.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_usiZiehlAddress" type="USINT">
									<descr>Ziehl Fan Address. Broadcast not suppoted. Default: 1.</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_usiLimit" type="USINT">
									<descr>Limit %. Default 75.</descr>
									<initValue>75</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xChanged" type="BOOL">
									<descr>TRUE if the parameter has been successfully changed.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xWorking" type="BOOL">
									<descr>Change Operation in progress.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xFailed" type="BOOL">
									<descr>Change has failed.</descr>
								</var>
								<var name="q_xWrongInputs" type="BOOL">
									<descr>Inputs out of range</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="i" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="xEn_old" type="BOOL"/>
								<var name="wLimit" type="WORD">
									<descr>WORD to be sent</descr>
									<initValue>65535</initValue>
								</var>
								<var name="MsgNum" type="USINT">
									<initValue>10</initValue>
								</var>
								<var name="wLimit_Check" type="WORD">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_Limit" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_Limit_Check" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="j" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="k" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="uiRet_PIN" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="iPINL2" type="INT">
									<initValue>0010</initValue>
								</var>
								<var name="uiLimit" type="UINT"/>
							</localVars>
							<localConsts>
								<const name="usiRetries" type="USINT">
									<descr>Operation retries.</descr>
									<initValue>5</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
