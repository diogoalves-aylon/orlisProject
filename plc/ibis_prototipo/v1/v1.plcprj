					<functionBlock name="EBMFanOperation" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB executes the required data conversion for normal operation of EBM type Fans.</descr>
						<vars>
							<inputVars>
								<var name="i_uiInputSpeed" type="UINT">
									<descr>Desired Speed Setpoint ( 0... 1000)</descr>
								</var>
								<var name="i_uiActualSpeed" type="UINT">
									<descr>Current Speed Data (read from the fan)</descr>
								</var>
								<var name="i_uiMaxSpeed" type="UINT">
									<descr>Max Speed Data (read from the fan)</descr>
								</var>
								<var name="i_uiMotorStatus" type="UINT">
									<descr>Motor Status Info (read from the fan)</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_uiSpecifiedSet" type="UINT">
									<descr>Data to be written on the fan (D001 / 53250)</descr>
								</var>
								<var name="q_uiSpeedRPM" type="UINT">
									<descr>Current fan speed in RPM</descr>
								</var>
								<var name="q_uiFeedbkSpeed" type="UINT">
									<descr>Current fan speed in 0...1000 format</descr>
								</var>
								<var name="q_xAlarm" type="BOOL">
									<descr>TRUE if the fan has alarms on</descr>
								</var>
							</outputVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
