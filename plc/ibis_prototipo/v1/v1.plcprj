	<commSettings>ModbusTCP:255,1000,M6#TCPIP:10.99.120.29/502,5000</commSettings>
	<sources>
		<main>
			<resources>
				<resource name="EWAD" processor="ARMv7M">
					<task name="Timed" interval="t#100000us" priority="0" type="cyclic" hidden="false" dynamic="false" descr="Timed task - execution time can be configured between 20 and 100 ms"/>
					<task name="Background" interval="t#0us" priority="1" type="cyclic" hidden="false" dynamic="false" descr="Background task - executes continuously at low priority"/>
					<task name="Boot" interval="t#0us" priority="2" type="single" hidden="false" dynamic="false" descr="Boot task - executes once at system startup"/>
					<task name="Init" interval="t#0us" priority="3" type="single" hidden="false" dynamic="false" descr="Init task - executes once at every PLC full restart"/>
					<task name="Serv" interval="t#0us" priority="4" type="single" hidden="true" dynamic="false" descr="Service task"/>
				</resource>
			</resources>
			<tasks>
				<task name="Background">
					<program>main</program>
				</task>
			</tasks>
			<globalVars>
				<group name="Global_vars" version="1.0.0">
					<var name="cnt" type="INT"/>
					<var name="T1" type="INT"/>
					<var name="T2" type="INT"/>
					<var name="T3" type="INT"/>
					<var name="T4" type="INT"/>
					<var name="T5" type="INT"/>
					<var name="P1" type="INT"/>
					<var name="P2" type="INT"/>
					<var name="Status" type="BOOL"/>
					<var name="L1_Global" type="REAL"/>
				</group>
			</globalVars>
			<retainVars/>
			<constantVars/>
			<iecVarsDeclaration>
				<group name="Global_vars">
					<iecDeclaration active="FALSE"/>
				</group>
			</iecVarsDeclaration>
			<functions/>
			<functionBlocks>
				<functionBlock name="Word2IEEE754" version="1.0.0" creationDate="0" lastModifiedDate="0">
					<descr>Conversion of 2 Word into a REAL value using IEEE754 32bit format</descr>
					<vars>
						<inputVars>
							<var name="WORDH" type="WORD">
								<descr>High Word</descr>
							</var>
							<var name="WORDL" type="WORD">
								<descr>Low Word</descr>
							</var>
						</inputVars>
						<outputVars>
							<var name="IEEE754" type="REAL">
								<descr>Real Value</descr>
							</var>
						</outputVars>
						<localVars>
							<var name="udintptr" type="@UDINT"/>
						</localVars>
					</vars>
					<iecDeclaration active="FALSE"/>
					<interfaces/>
					<methods/>
					<sourceCode type="ST">
						<![CDATA[IEEE754 := 0.0;
udintptr := ADR(IEEE754);

@udintptr := TO_UDINT(WORDL)+SHL(TO_UDINT(WORDH),16);

]]>
					</sourceCode>
				</functionBlock>
			</functionBlocks>
			<programs>
				<program name="main" version="1.0.0" creationDate="0" lastModifiedDate="1759937459">
					<vars>
						<localVars>
							<var name="W_to_IEE754_Corriente_L1" type="Word2IEEE754"/>
							<var name="W_to_IEE754_Corriente_L2" type="Word2IEEE754"/>
							<var name="W_to_IEE754_Corriente_L3" type="Word2IEEE754"/>
							<var name="W_to_IEE754_Tensao_L1_L2" type="Word2IEEE754"/>
							<var name="W_to_IEE754_Tensao_L2_L3" type="Word2IEEE754"/>
							<var name="W_to_IEE754_Tensao_L3_L1" type="Word2IEEE754"/>
							<var name="W_to_IEE754_EnergiaAtivaParcial" type="Word2IEEE754"/>
							<var name="W_to_IEE754_EnergiaReativaParcial" type="Word2IEEE754"/>
							<var name="W_to_IEE754_EnergiaAtivaTotal" type="Word2IEEE754"/>
							<var name="W_to_IEE754_EnergiaReativaTotal" type="Word2IEEE754"/>
						</localVars>
					</vars>
					<iecDeclaration active="FALSE"/>
					<sourceCode type="ST">
						<![CDATA[T1 := T1_input;
T1_output:=T1;

T2 := T2_input;
T2_output := T2;


T3 := T3_input;
T3_output := T3;


T4 := T4_input;
T4_output := T4;


T5 := T5_input;
T5_output := T5;

P1 := P1_input;
P1_output := P1;

P2 := P2_input;
P2_output := P2;


// --- Correntes ---
W_to_IEE754_Corriente_L1(WORDH:=Corrente_HIGH_L1,WORDL:=Corrente_LOW_L1);
Corrente_L1:=W_to_IEE754_Corriente_L1.IEEE754;

W_to_IEE754_Corriente_L2(WORDH:=Corrente_HIGH_L2,WORDL:=Corrente_LOW_L2);
Corrente_L2:=W_to_IEE754_Corriente_L2.IEEE754;

W_to_IEE754_Corriente_L3(WORDH:=Corrente_HIGH_L3,WORDL:=Corrente_LOW_L3);
Corrente_L3:=W_to_IEE754_Corriente_L3.IEEE754;


// --- Tensoes ---
W_to_IEE754_Tensao_L1_L2(WORDH:=Tensao_HIGH_L1_L2,WORDL:=Tensao_LOW_L1_L2);
Tensao_L1_L2:=W_to_IEE754_Tensao_L1_L2.IEEE754;

W_to_IEE754_Tensao_L2_L3(WORDH:=Tensao_HIGH_L2_L3,WORDL:=Tensao_LOW_L2_L3);
Tensao_L2_L3:=W_to_IEE754_Tensao_L2_L3.IEEE754;

W_to_IEE754_Tensao_L3_L1(WORDH:=Tensao_HIGH_L3_L1,WORDL:=Tensao_LOW_L3_L1);
Tensao_L3_L1:=W_to_IEE754_Tensao_L3_L1.IEEE754;


// --- Energia Parcial Ativa
W_to_IEE754_EnergiaAtivaParcial(WORDH:=EnergiaAtivaParcial_HIGH, WORDL:=EnergiaAtivaParcial_LOW);
EnergiaAtivaParcial:=W_to_IEE754_EnergiaAtivaParcial.IEEE754;

// --- Energia Parcial Reativa
W_to_IEE754_EnergiaReativaParcial(WORDH:=EnergiaReativaParcial_HIGH, WORDL:=EnergiaReativaParcial_LOW);
EnergiaReativaParcial:=W_to_IEE754_EnergiaReativaParcial.IEEE754;



// --- Energia Ativa Total
W_to_IEE754_EnergiaAtivaTotal(WORDH:=EnergiaAtivaTotal_HIGH, WORDL:=EnergiaAtivaTotal_LOW);
EnergiaAtivaTotal:=W_to_IEE754_EnergiaAtivaTotal.IEEE754;

// --- Energia Reativa Total
W_to_IEE754_EnergiaReativaTotal(WORDH:=EnergiaReativaTotal_HIGH, WORDL:=EnergiaReativaTotal_LOW);
EnergiaReativaTotal:=W_to_IEE754_EnergiaReativaTotal.IEEE754;







]]>
					</sourceCode>
				</program>
			</programs>
			<macros/>
			<structs/>
			<typedefs/>
			<enums/>
			<subranges/>
			<interfaces/>
		</main>
		<target id="FreeAdvance_668p15" name="v1.tgt" fullXml="false">
			<![CDATA[(************************************************************************)
(*                                                                      *)
(*	Description: Definition of target variables and functions       *)
(*                                                                      *)
(************************************************************************)


(************************************************************************)
(*                         									                            *)
(*   GLOBAL VARIABLES                                                   *)
(*                                                                      *)
(************************************************************************)

TYPE
    TypeDataTime : STRUCT
	seconds : USINT;  {DE: "seconds          " }
	minutes : USINT;  {DE: "minutes          " }
	hours   : USINT;  {DE: "hours            " }
	dayweek : USINT;  {DE: "day of week      " }
	daymonth: USINT;  {DE: "day of month     " }
	month   : USINT;  {DE: "month            " }
	year    : USINT;  {DE: "year             " }
    END_STRUCT;
END_TYPE

TYPE
    STRUCTIMPULSECOUNTER : STRUCT
	counter   : UDINT;  {DE: "counter          " }
	frequency : UDINT;  {DE: "frequency        " }
    END_STRUCT;
END_TYPE

TYPE
    MBMNODESTATUS : STRUCT 
	com_hdlr : BYTE; { DE:"Communication handler" }
	addr_1 : USINT; { DE:"Network address part 1" }
	addr_2 : USINT; { DE:"Network address part 2" }
	addr_3 : USINT; { DE:"Network address part 3" }
	addr_4 : USINT; { DE:"Network address part 4" }
	cfg : BOOL := FALSE; { DE:"Configurated" }
	pres : BOOL := FALSE; { DE:"Present" }
	miss : BOOL := FALSE; { DE:"Slave failure" }
	missCnt : UINT; { DE:"Number of Task Timed cycles with Slave failure" }
	state : UINT; { DE:"Slave failure error code" }
    END_STRUCT;
END_TYPE

{ ALLOCATE:sysClock }
{ ALLOCATE:sysImpulseCounter }
{ ALLOCATE:sysMbMRtuNodeStatus }
{ ALLOCATE:sysMbMTcpNodeStatus }
{ ALLOCATE:sysMbMRtuNodePresence }
{ ALLOCATE:sysMbMTcpNodePresence }
{ ALLOCATE:sysCANopenNodeStatus }

VAR_GLOBAL 

	{G:"Digital Inputs"}
	sysLocalDigitalInputs	AT %IX0.0  : ARRAY[ 0..1 ] OF BOOL;	{ IO:"Local Digital Inputs" }
	sysExpDigitalInputs     AT %IX10.0 : ARRAY[ 0..95 ] OF BOOL;   { IO:"Expansion Digital Inputs" }
	sysLocalDigitalInputsImpulseCounter	AT %MD55.0  : ARRAY[ 0..1 ] OF UDINT;	{ IO:"Local Digital Inputs Impulse Counter" }	
	sysLocalDigitalInputsResetCounter	AT %MX56.0  : ARRAY[ 0..1 ] OF BOOL;	{ IO:"Local Digital Inputs Reset Counter" }		
  
  (*                                                                    				
	{G:"Dip Switch"}                                                    				
	sysLocalDipSwitch	AT %IX3.0	: ARRAY[ 0..3 ] OF BOOL;	{ IO:"Local Dip Switch" }
	*)
                                                                      				
	{G:"Analog Inputs"}                                                 				
	sysLocalAnalogInputs     AT %IW1.0	: ARRAY[ 0..7 ] OF INT;		{ IO:"Local Analog Inputs" }
	sysExpAnalogInputs       AT %IW11.0 : ARRAY[ 0..71 ] OF INT;   { DE:"Expansion Analog Inputs" }
	sysLocalADCs		 AT %IW2.0	: ARRAY[ 0..7 ] OF UINT;	{ IO:"Local ADC values" }	                     
	sysLocalADCsAdj	 AT %IW20.0	: ARRAY[ 0..7 ] OF UINT;	{ IO:"Local ADC values adjusted" }	                     	
                                                                      				
	{G:"Analog Outputs"}                                                				
	sysLocalAnalogOutputs    AT %QW0.0	: ARRAY[ 0..1 ] OF INT;		{ IO:"Local Analog Outputs" }
	sysExpAnalogOutputs      AT %QW10.0 : ARRAY[ 0..59 ] OF INT;  { DE:"Expansion analog output" }
                                                                      				
	{G:"Digital Outputs"}                                               				
	sysLocalDigitalOutputs   AT %QX1.0	: ARRAY[ 0..5 ] OF BOOL;	{ IO:"Local Digital Outputs" }
	sysExpDigitalOutputs     AT %QX11.0 : ARRAY[ 0..83 ] OF BOOL;   { IO:"Expansion Digital Outputs" }

	{G:"Led Backlight Status"}                                                				
	sysLocalLeds    	AT %QB2.0	: ARRAY[ 0..2 ] OF USINT;	
	{ IO:"Local Leds Status.
	sysLocalLeds[0] = Green led
	sysLocalLeds[1] = Red led
	sysLocalLeds[2] = Yellow led	
		
	0 = Led Off.
	1 = Led On.
	2 = Led Blink.
" }
	
	sysBacklight    	AT %QB3.0	: USINT;			
	{ IO:"Backlight Status.
	0 = Off.
	1 = On.
	2 = Blink.
	3 = Timed.
	4 = Timed running.	
 " }	
                                                                      				
	{G:"System Timers"}                                                 				
	sysTimer 		AT %MD0.0 	: UDINT;			{ DE:"System timer [ms]"}
	                                                                    				
	{G:"System Tasks Execution Time"}                                                 				
	sysTskBckExeTime	AT %MD3.0	: UDINT;			{ DE:"System Background's Task Execution Time (us)"}
	sysTskTmdExeTime	AT %MD4.0	: UDINT;			{ DE:"System Timed's Task Execution Time (us)"}
	sysTskTmdScanTime	AT %MW3002.0	: UINT;			{ DE:"System Timed's Task Scan Time (ms)"}
	sysTskBckMaxExeTime	AT %MD4000.0	: UDINT;			{ DE:"System Background's Task Max Execution Time (us)"}
	sysTskTmdMaxExeTime	AT %MD4001.0	: UDINT;			{ DE:"System Timed's Task Max Execution Time (us)"}
	                                                                    				
	{G:"System Clock"}                                                  				
	sysClock                AT %MB1.0	: TypeDataTime;	
	{ DE:"System Date and Time Read. It is a structure of type TypeDataTime composed 
by the following fields:
	seconds		: USINT; seconds [0...59]
	minutes		: USINT; minutes [0...59] 
	hours		: USINT; hours [0...23]
	dayweek		: USINT; day of week [0...6] 0=sunday,...,6=saturday
	daymonth		: USINT; day of month [1...31]
	month		: USINT; month [1...12]
	year		: USINT; year [10...99]
" }			
	
	sysClockError           AT %MX2.0	: BOOL;				{ DE:"System Date and Time invalid" }		
                                                                      				
	{G:"System Impulse Counter Input"}                                                  				
	sysImpulseCounter        AT %MB5.0	: STRUCTIMPULSECOUNTER;    	
	{ DE:"System Impulse Counter Input 1 (read). It is a structure of type STRUCTIMPULSECOUNTER composed
by the following fields:
	counter		: UDINT; number of input commutation from close to open
	frequency		: UDINT; frequency [Hz/10] 
" }
	sysImpulseCounter_as_FDI        AT %IX5.0	: BOOL; { IO:"System Impulse Counter 1 as Digital Input" }
	sysImpulseCounter_ResetCounter  AT %MX50.0	: BOOL; { IO:"Reset sysImpulseCounter.counter of System Impulse Counter Input 1" }	
	
	sysImpulseCounter2        AT %MB500.0	: STRUCTIMPULSECOUNTER;    	
	{ DE:"System Impulse Counter Input 2 (read). It is a structure of type STRUCTIMPULSECOUNTER composed
by the following fields:
	counter		: UDINT; number of input commutation from close to open
	frequency		: UDINT; frequency [Hz/10] 
" }
	sysImpulseCounter_as_FDI2        AT %IX500.0	: BOOL; { IO:"System Impulse Counter 2 as Digital Input" }
	sysImpulseCounter_ResetCounter2  AT %MX550.0	: BOOL; { IO:"Reset sysImpulseCounter.counter of System Impulse Counter Input 2" }		

	{G:"Peripheral"}
	sysPeripheralStatus      AT %MX7.0 : ARRAY[ 0..129 ] OF BOOL;      	
	{ DE:"Peripheral status. 
It is an array of BOOL used to check connection status of expansions over field CANopen. 
Every expansion has its own CANopen serial address.
Connection status of expansion having serial address 3 is sysPeripheralStatus[5].
Connection status of expansion having serial address 10 is sysPeripheralStatus[12].
	TRUE	=	means expansion not recognized.
	FALSE	=	expansion correctly connected.
	" }
	
	sysCANopenNodeStatus      AT %MB2005.0 : ARRAY[ 0..129 ] OF USINT;              
         { DE:"CANopen Node Status.
It is an array of USINT used to check NMT status of expansions over field CANopen.
Every expansion has its own CANopen serial address.
Connection status of expansion having serial address 3 is sysCANopenNodeStatus [5].
Connection status of expansion having serial address 10 is sysCANopenNodeStatus [12].
         0        = NMT BOOTUP/NOTKNOWN
         1        = NMT MISSING
         4        = NMT STOPPED
         5        = NMT OPERATIONAL
         6        = NMT RESET                            
         7        = NMT RESET COMM
         127     = NMT PRE OPERATIONAL
         " }

	sysFTP_COD_FileFilter   AT %MB5001.0 : BOOL; { DE:  "TRUE = COD files can't be read by FTP, otherwise yes" }
		
	{G:"System Parameters EEPROM RAM image"}                                                  				
	sysParameter		AT %MW100.0	: ARRAY[ 0..415 ] OF WORD;	{ IO:"System Parameter (read)" }
	sysLangID		AT %MW99.0	: WORD;				{ DE:"HMI active Language ID" }
	Gain_Ntc_AI1   AT %MW100.0 : UINT; { DE:  "NTC calibration gain AI1" }
	Gain_PT1000_AI1   AT %MW100.1 : UINT; { DE:  "PT1000 calibration gain AI1" }
