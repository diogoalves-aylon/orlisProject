4j0+LxH2yXMMmeQEoFBDyVdvU1DaqQtsPx/VZxqdWkkSOpYoofCRcuSYrAWYUGvLl2+zUWKs
m2unH4VnApoyT7I+]]>
						</sourceCode>
					</function>
					<function name="f_ECBlueBasicControlWFull" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>The output returns the Control word to be written onto the fan.</descr>
						<returnValue>WORD</returnValue>
						<vars>
							<inputVars>
								<var name="i_xEnableFan" type="BOOL">
									<descr>TRUE: Fan Enable. FALSE: Fan Disable. Default: FALSE.</descr>
								</var>
								<var name="i_xSetIntern2" type="BOOL">
									<descr>TRUE: Set Intern2 (h6) for control mode 0...4 (h4, Bit[2:0])</descr>
								</var>
								<var name="i_xSetIntern3" type="BOOL">
									<descr>TRUE: Set Intern3 (h9) for control mode 0...4 (h4, Bit[3:0])</descr>
								</var>
								<var name="i_xLimit" type="BOOL">
									<descr>TRUE: Limit (h18)</descr>
								</var>
								<var name="i_xReverse" type="BOOL">
									<descr>TRUE: Reverse</descr>
								</var>
								<var name="i_xFireAlarm" type="BOOL">
									<descr>TRUE: Fire alarm (from FW 9.00)</descr>
								</var>
								<var name="i_xMinSpeedOff" type="BOOL">
									<descr>TRUE: Min. speed  OFF  (by ECblue only in combination with Premium Modul, from FW10)</descr>
								</var>
								<var name="i_xK1ControlSys" type="BOOL">
									<descr>TRUE: K1 Control system</descr>
								</var>
							</inputVars>
							<localVars>
								<var name="wTMP" type="WORD"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<sourceCode type="ST" encoded="true">
							<![CDATA[ti0R9il1tJlcBRBX08lPbwtSaq8TbTcefWaqmhJJ/iiZ95lzvJiEBvhWg8hnbNtRmq8zb98Y
