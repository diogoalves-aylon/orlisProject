			<lib version="1.3.8" name="c:\program files (x86)\eliwell\free studio plus\catalog\freeadvance\PLC\Application.plclib" fullXml="true" link="true">
				<descr>AFBs related to applications in HVAC and refrigeration</descr>
				<libWorkspace>
					<folder name="Application" excludeFromBuildIfNotDef="">
						<folder name="Air">
							<Pou name="AHUPlantModeStrategy"/>
							<Pou name="AHUTempCntrlStrategy"/>
							<Pou name="EcFanMgmt"/>
