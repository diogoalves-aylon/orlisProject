					</functionBlock>
					<functionBlock name="ModeSelection" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Mode Selection (heat/cool, on/off) of a heat pump</title>
						<descr>&lt;HTML&gt;The ModeSelection function block defines the mode of the Heat Pump, cooling or heating, and manage the delay used to swap from one to the other mode.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enables the function block</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="usiModeType" type="USINT">
									<descr>Mode type management (0...3): 0:Manual, 1:Remote, 2:Digital Input, 3:Automatic</descr>
									<initValue>3</initValue>
								</var>
								<var name="xManualValue" type="BOOL">
									<descr>Manual value (TRUE: heating, FALSE: cooling)</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="xRemoteValue" type="BOOL">
									<descr>Remote value (TRUE: heating, FALSE: cooling)</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="xDigInValue" type="BOOL">
									<descr>Digital input value (TRUE: heating, FALSE: cooling)</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="iExternalTemp" type="INT">
									<descr>External Temperature (0.1 * °C/°F)</descr>
								</var>
								<var name="iHeatTempThr" type="INT">
									<descr>Heating mode temperature threshold (-58.0…iCoolTempThr 0.1 * °C/°F)</descr>
								</var>
								<var name="iCoolTempThr" type="INT">
									<descr>Cooling mode temperature threshold (iHeatTempThr …302.0 0.1 * °C/°F)</descr>
								</var>
								<var name="uiDelayChgOver" type="UINT">
									<descr>Delay for heat/cool changeover (0...65535  s)</descr>
								</var>
							</inputVars>
							<outputVars>
