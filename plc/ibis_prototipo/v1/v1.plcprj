					<functionBlock name="EBMReset" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB sends a reset message to an EBM fan.
For additional details regarding the 4 bits that can be set, refer to the EBM user guide.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>On transition FALSE -&gt; TRUE, the reset command is sent.</descr>
								</var>
								<var name="i_usiAddress" type="USINT">
									<descr>Current EBM Fan ModBUS Address</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_xBitAWSReset" type="BOOL">
									<descr>User software reset (includes Reset error and Adopt parameters). The software is launched at the start of user software.</descr>
								</var>
								<var name="i_xBitParameter" type="BOOL">
									<descr>All parameters are copied from the EEPROM into the RAM. This bit must be set to validate revised parameters.</descr>
								</var>
								<var name="i_xBitError" type="BOOL">
									<descr>Errors are reset.</descr>
								</var>
								<var name="i_xBitReset" type="BOOL">
									<descr>Software reset (includes Reset error and Adopt parameters). The software is launched at the start of booting.</descr>
								</var>
								<var name="i_usiRetries" type="USINT">
									<descr>Operation retries.</descr>
									<initValue>3</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xCompleted" type="BOOL">
									<descr>Write sequence completed successfully.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xError" type="BOOL">
									<descr>Error during write operation.</descr>
									<initValue>FALSE</initValue>
								</var>
							</outputVars>
							<localVars>
								<var name="xEn_old" type="BOOL"/>
								<var name="wReset" type="WORD"/>
								<var name="uiAddress" type="UINT">
									<descr>Register address</descr>
								</var>
								<var name="uiRet" type="UINT"/>
								<var name="i" type="USINT">
									<initValue>250</initValue>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
