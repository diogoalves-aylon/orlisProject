								<var name="uiCompMgmtAlarmID" type="UINT">
									<descr>Compressor Management Alarm ID</descr>
								</var>
								<var name="uiMinOnTime" type="UINT">
									<descr>Minimum run time of the compressor (s)</descr>
								</var>
								<var name="uiMinOffTime" type="UINT">
									<descr>Minimum time before the next restart (s)</descr>
								</var>
								<var name="uiMinCycleTime" type="UINT">
									<descr>Minimum Cycle time (s)</descr>
								</var>
								<var name="ptrE2_OpHours" type="@UDINT">
									<descr>Pointer retaining the operating hours</descr>
								</var>
								<var name="ptrE2_NbStarts" type="@UDINT">
									<descr>Pointer retaining the number of starts</descr>
								</var>
								<var name="xOpHoursReset" type="BOOL">
									<descr>Reset Input</descr>
								</var>
							</inputVars>
							<outputVars>
