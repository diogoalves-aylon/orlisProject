					</functionBlock>
					<functionBlock name="RedundantPumpCntrl" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Redundant pumps control</title>
						<descr>&lt;HTML&gt;The RedundantPumpCtrl function block balances the operating hours of two pumps. 
This function block takes into account the status of each pump: operating time, failure, 
maintenance mode. If one the pump is not available, the second pump will run continuously.
When the pumps are not used for a long time, to avoid damage (corrosion, blocking) 
the pumps are switch on one after the other during a time set by the user. All time settings 
can be configured by the user.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable of the Function block</descr>
								</var>
								<var name="xStartStop" type="BOOL">
									<descr>To switch on/off the pump (TRUE: start FALSE: stop)</descr>
								</var>
								<var name="xAutoManual" type="BOOL">
									<descr>Automatic or manual mode (TRUE: manual mode FALSE: auto mode)</descr>
								</var>
								<var name="xManualRunP1" type="BOOL">
									<descr>TRUE : Start pump 1 in Manual mode (XRunP1 := xManualRunP1)</descr>
								</var>
								<var name="xManualRunP2" type="BOOL">
									<descr>TRUE : Start pump 2 in Manual mode (XRunP2 := xManualRunP2)</descr>
								</var>
								<var name="xMotorAlarmP1" type="BOOL">
									<descr>Signal from motor 1 protection</descr>
								</var>
								<var name="xMotorAlarmP2" type="BOOL">
									<descr>Signal from motor 2 protection</descr>
								</var>
								<var name="uiMaxRunTimeP1" type="UINT">
									<descr>Maximum running time of pump 1 (1 to 1000 Hours)</descr>
								</var>
								<var name="uiMaxRunTimeP2" type="UINT">
									<descr>Maximum running time of pump 2 (1 to 1000 Hours)</descr>
								</var>
								<var name="uiPModeRunTime" type="UINT">
									<descr>Duration of the locked rotor protection (PMode) (1 to 60000 Minutes)</descr>
								</var>
								<var name="uiPModeIdleTime" type="UINT">
									<descr>Max Idle time – Pump will be started for uiPModeRunTime  (0 to 1000 Hours)</descr>
								</var>
								<var name="xReset" type="BOOL"/>
							</inputVars>
							<outputVars>
								<var name="usiState" type="USINT">
									<descr>Current state (0 to 99)</descr>
								</var>
								<var name="xRunP1" type="BOOL">
									<descr>Start/Stop command of pump 1</descr>
								</var>
								<var name="xRunP2" type="BOOL">
									<descr>Start/Stop command of pump 2</descr>
								</var>
								<var name="uiRemainTimeP1" type="UINT">
									<descr>Remaining time before pump 1 switches over to pump 2 (0 to 1000 Hours)</descr>
								</var>
								<var name="uiRemainTimeP2" type="UINT">
									<descr>Remaining time before pump 2 switches over to pump 1 (0 to 1000 Hours)</descr>
								</var>
								<var name="uiRemainIdleTime" type="UINT">
									<descr>Remaining time before pump starts for uiPModeRunTime (0 to 1000 Hours)</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime"/>
							</externalVars>
							<localVars>
								<var name="l_xQMaxRunTime" type="BOOL"/>
								<var name="l_xQPModeIdleTime" type="BOOL"/>
								<var name="l_xQPModeRunTime" type="BOOL"/>
								<var name="l_uiValueMaxRunTime" type="UINT"/>
								<var name="l_uiValuePModeIdleTime" type="UINT"/>
								<var name="l_uiValuePModeRunTime" type="UINT"/>
								<var name="l_uiDelayMaxRunTime" type="UINT"/>
								<var name="l_xEnMaxRunTime" type="BOOL"/>
								<var name="l_xEnPModeIdleTime" type="BOOL"/>
								<var name="l_xEnPModeRunTime" type="BOOL"/>
								<var name="l_xP2active" type="BOOL"/>
								<var name="l_xPModeActive" type="BOOL"/>
								<var name="l_uiStopTimer" type="UINT"/>
								<var name="l_xAlarm" type="BOOL"/>
								<var name="l_uiDelayPModeIdleTime" type="UINT"/>
								<var name="l_uiDelayPModeRunTime" type="UINT"/>
								<var name="l_xAvailableP1" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="l_xAvailableP2" type="BOOL"/>
								<var name="Not_First_Cycle" type="BOOL"/>
								<var name="minute_memo" type="USINT"/>
								<var name="CJ_GetMinuteTic" type="BOOL"/>
							</localVars>
							<localConsts>
								<const name="uiMINUTEXHOUR" type="UINT">
									<initValue>60</initValue>
								</const>
								<const name="STATE_IDLE" type="USINT">
									<initValue>1</initValue>
								</const>
								<const name="STATE_NORMAL_OPERATION" type="USINT">
									<initValue>20</initValue>
								</const>
								<const name="STATE_TIMER_NORMAL_OPERATION" type="USINT">
									<initValue>21</initValue>
								</const>
								<const name="STATE_PMODE" type="USINT">
									<initValue>40</initValue>
								</const>
								<const name="STATE_START_PMODE" type="USINT">
									<initValue>41</initValue>
								</const>
								<const name="STATE_TIMER_PMODE" type="USINT">
									<initValue>42</initValue>
								</const>
								<const name="STATE_END_PMODE" type="USINT">
									<initValue>43</initValue>
								</const>
								<const name="STATE_ALARM" type="USINT">
									<initValue>99</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
							<![CDATA[ti0R9il1tJlcBRBX08lPbwtSaq8TbTcefWaqmhJJZi1J9YFwTJr0BnhVG8sXbCtSEqwzbncd
