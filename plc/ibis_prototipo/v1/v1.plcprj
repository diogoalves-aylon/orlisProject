	MAC_4_ETH_PI   AT %MW100.315 : UINT; { DE:  "MAC address (4 th part)" }
	MAC_5_ETH_PI   AT %MW100.316 : UINT; { DE:  "MAC address (5 th part)" }
	MAC_6_ETH_PI   AT %MW100.317 : UINT; { DE:  "MAC address (6 th part)" }
	HTTP_volume   AT %MW100.318 : UINT; { DE:  "Volume of HTTP files" }
	DAT_volume   AT %MW100.319 : UINT; { DE:  "Volume of *.DAT and *.RAW files files" }
	FTP_volume   AT %MW100.320 : UINT; { DE:  "Volume of FTP files" } 
	PLC_volume   AT %MW100.321 : UINT; { DE:  "Volume of PLC file" }
	HMI_volume   AT %MW100.322 : UINT; { DE:  "Volume of HMI file" }
	REM_volume   AT %MW100.323 : UINT; { DE:  "Volume of HMI Remote file" }
	PAR_volume   AT %MW100.324 : UINT; { DE:  "Volume of CONNEC.PAR file" }
	Modem_RS232_PI   AT %MX100.325 : BOOL; { DE:  "Modem Enable" }
	Modem_InitStr1   AT %MB100.326 : STRING[19]; { DE:  "Init String (1st part)" }
	Modem_InitStr2   AT %MB100.336 : STRING[19]; { DE:  "Init String (2nd part)" }
	Modem_HangupStr   AT %MB100.356 : STRING[19]; { DE:  "HangUp String" }
	virtualDipSwitch   AT %MW100.366 : UINT; { DE:  "Address Offset for serial lines that act as slave" }	
	CANExpPresenceByPar AT %MW100.367 :UINT; { DE:  "Allow slave presence by parameter. Register 16144 bit0  : if 0 the 1st  CAN slave in CONNEC.PAR sequence is present otherwise it is not present
                														register 16144 bit1  : if 0 the 2nd  CAN slave in CONNEC.PAR sequence is present otherwise it is not present                    
                														...             
                														register 16144 bit11 : if 0 the 11th CAN slave in CONNEC.PAR sequence is present otherwise it is not present" }
	MbMRtu_DisByPar		AT %MW100.368  :UINT; { DE:  "RS485-2 Modbus Master Status when enabled from Configuration.If Allow disable Modbus Master by Parameter is enabled from Configuration, setting this EEprom parameter to FALSE allows to disable Modbus Master. A plc reboot is required" }
	MbMTcp_ServerIp4thOctet_Node0 AT %MW100.369  :UINT; { DE:  "Modbus TCP Client via Configuration: 4th octet for server node number 0" }
	MbMTcp_ServerIp4thOctet_Node1 AT %MW100.370  :UINT; { DE:  "Modbus TCP Client via Configuration: 4th octet for server node number 1" }
	MbMTcp_ServerIp4thOctet_Node2 AT %MW100.371  :UINT; { DE:  "Modbus TCP Client via Configuration: 4th octet for server node number 2" }
	MbMTcp_ServerIp4thOctet_Node3 AT %MW100.372  :UINT; { DE:  "Modbus TCP Client via Configuration: 4th octet for server node number 3" }
	MbMTcp_ServerIp4thOctet_Node4 AT %MW100.373  :UINT; { DE:  "Modbus TCP Client via Configuration: 4th octet for server node number 4" }
	MbMTcp_ServerIp4thOctet_Node5 AT %MW100.374  :UINT; { DE:  "Modbus TCP Client via Configuration: 4th octet for server node number 5" }
	MbMTcp_ServerIp4thOctet_Node6 AT %MW100.375  :UINT; { DE:  "Modbus TCP Client via Configuration: 4th octet for server node number 6" }
	MbMTcp_ServerIp4thOctet_Node7 AT %MW100.376  :UINT; { DE:  "Modbus TCP Client via Configuration: 4th octet for server node number 7" }


  	{G:"Plug-In identification"}                                                  					
	PlugIn_Identification   AT %MD40.0 : UDINT; 
      { DE:"Plug-In identification as bit mask:
	bit  0 : CAN presence (1=yes,0=no)
	bit  1 : ETHERNET presence (1=yes,0=no)
	bit  2 : RS485 presence (1=yes,0=no)
	bit  3 : RS232 presence (1=yes,0=no)
	bit  4 : Reserved	
	bit  5 : BACnet MS/TP presence (1=yes,0=no)
	bit  6 : LON presence (1=yes,0=no)
	bit  7 : Secure Interface presence (1=yes,0=no)
	bit 31 : Identification Error (1=yes,0=no)
" }       
	
	{G:"Modbus Master"}
	sysMbMRtuNodeStatus	AT %MB2001.0	: ARRAY[ 0..127 ] OF MBMNODESTATUS;
	{ DE:"System Modbus Master RTU communication status. It is a structure of type MBMNODESTATUS composed
by the following fields:
	com_hdlr :	BYTE; Communication handler
	addr_1 :		USINT; Network address part 1
	addr_2 :		USINT; Network address part 2
	addr_3 :		USINT; Network address part 3
	addr_4 :		USINT; Network address part 4
	cfg :		BOOL; Configurated
	pres :		BOOL; Present
	miss :		BOOL; Slave failure
	missCnt:		UINT; Number of Task Timed cycles with Slave failure
	state :		UINT;Slave failure error code

state could have the following meanings:
(valid only if miss is TRUE, never set to 0 )
	0 = No errors
	1 = Tx data failed
	2 = Rx time out (at starting )
	3 = System error
	4 = Rx time out (frame not ended)


(*) System error 3 means that received frame has not a handled function command in the following list:
				
	MODBUS_FNZ_RD_COILS: 			/*	Read Coils                              */
	MODBUS_FNZ_RD_DISINP: 		/*	Read Discrete Inputs                    */
	MODBUS_FNZ_RD_HOLDREG: 		/*	Read Holding Register                   */
	MODBUS_FNZ_RD_INPREG:			/*	Read Input Register                     */
	MODBUS_FNZ_RDWR_MULTREGS: /*	Read Write Multiple Register            */
	MODBUS_FNZ_WR_SINGCOIL:		/*	Write Single Coil                       */
	MODBUS_FNZ_WR_SINGREG: 		/*	Write Single Register                   */
	MODBUS_FNZ_WR_MULTCOILS:	/*	Write Multiple Coils										*/
	MODBUS_FNZ_WR_MULTREGS:		/*	Write Multiple Registers                */
	MODBUS_FNZ_PROG_CTRL:			/*	Custom command - programm controller		*/
	MODBUS_EXCEPTION:					/*	Exception mask                          */

(valid only if miss is FALSE, and pres is TRUE on RS485 )

In this case state is the last Exception code in this format : 16#80 OR Exception code  

For instance 16#82 correspond to Illegal data address


" }	

	sysMbMRtuNodeAct AT %MB2006.0         : USINT;

	{ DE:"System Modbus Master RTU Actual pointed node index" }                  

	sysMbMTcpNodeAct AT %MB2007.0         : USINT;      

	{ DE:"System Modbus Master TCP Actual pointed node index" }                  

	sysMbMRtuNodeDisableWrites  AT %MX2008.0 : ARRAY[ 0..127 ] OF BOOL; 

	{ DE:"System Modbus Master RTU Disable any Write command for the node" }      

	sysMbMTcpNodeDisableWrites  AT %MX2009.0 : ARRAY[ 0..15 ] OF BOOL;   

	{ DE:"System Modbus Master TCP Disable any Write command for the node" }

	sysMbMTcpNodeStatus	AT %MB2002.0	: ARRAY[ 0..15 ] OF MBMNODESTATUS;
	{ DE:"System Modbus Master TCP communication status. It is a structure of type MBMNODESTATUS composed
by the following fields:
	com_hdlr :	BYTE; Communication handler
	addr_1 :		USINT; Network address part 1
	addr_2 :		USINT; Network address part 2
	addr_3 :		USINT; Network address part 3
	addr_4 :		USINT; Network address part 4
	cfg :		BOOL; Configurated
	pres :		BOOL; Present
	miss :		BOOL; Slave failure
	missCnt:		UINT; Number of Task Timed cycles with Slave failure
	state :		UINT;Slave failure error code

state could have the following meanings:
(valid only if miss is TRUE, never set to 0 )
	0 = No errors
	1 = Tx data failed
	2 = Rx time out (at starting )
	3 = System error
	4 = Rx time out (frame not ended)

(*) System error 3 means that received frame has not a handled function command in the following list:
				
	MODBUS_FNZ_RD_COILS: 			/*	Read Coils                              */
	MODBUS_FNZ_RD_DISINP: 		/*	Read Discrete Inputs                    */
	MODBUS_FNZ_RD_HOLDREG: 		/*	Read Holding Register                   */
	MODBUS_FNZ_RD_INPREG:			/*	Read Input Register                     */
	MODBUS_FNZ_RDWR_MULTREGS: /*	Read Write Multiple Register            */
	MODBUS_FNZ_WR_SINGCOIL:		/*	Write Single Coil                       */
	MODBUS_FNZ_WR_SINGREG: 		/*	Write Single Register                   */
	MODBUS_FNZ_WR_MULTCOILS:	/*	Write Multiple Coils										*/
	MODBUS_FNZ_WR_MULTREGS:		/*	Write Multiple Registers                */
	MODBUS_FNZ_PROG_CTRL:			/*	Custom command - programm controller		*/
	MODBUS_EXCEPTION:					/*	Exception mask                          */

(valid only if miss is FALSE, and pres is TRUE on ETH )

In this case state is the last Exception code in this format : 16#80 OR Exception code  

For instance 16#82 correspond to Illegal data address

" }	

	sysMbMRtuNodePresence      AT %MX2003.0 : ARRAY[ 0..127 ] OF BOOL;  
{ DE:"System Modbus Master RTU node presence: TRUE = present, FALSE = off line
If sysMbMRtuNodePresence[i] is set to FALSE then
	sysMbMRtuNodeStatus[i].cfg keep it's value
	sysMbMRtuNodeStatus[i].pres is set to FALSE
	sysMbMRtuNodeStatus[i].miss is set to FALSE
	sysMbMRtuNodeStatus[i].missCnt is set to 0
	sysMbMRtuNodeStatus[i].state is set to 0 (No error)
If sysMbMRtuNodePresence[i] is set to TRUE then
	sysMbMRtuNodeStatus[i].cfg keep it's value
	sysMbMRtuNodeStatus[i].pres is up to date
	sysMbMRtuNodeStatus[i].miss is up to date
	sysMbMRtuNodeStatus[i].missCnt is up to date
	sysMbMRtuNodeStatus[i].state is up to date
"}    	
	sysMbMTcpNodePresence      AT %MX2004.0 : ARRAY[ 0..15  ] OF BOOL;  
{ DE:"System Modbus Master TCP node presence: TRUE = present, FALSE = off line
If sysMbMTcpNodePresence[i] is set to FALSE then
	sysMbMTcpNodeStatus[i].cfg keep it's value
	sysMbMTcpNodeStatus[i].pres is set to FALSE
	sysMbMTcpNodeStatus[i].miss is set to FALSE
	sysMbMTcpNodeStatus[i].missCnt is set to 0
	sysMbMTcpNodeStatus[i].state is set to 0 (No error)
If sysMbMTcpNodePresence[i] is set to TRUE then
	sysMbMTcpNodeStatus[i].cfg keep it's value
	sysMbMTcpNodeStatus[i].pres is up to date
	sysMbMTcpNodeStatus[i].miss is up to date
	sysMbMTcpNodeStatus[i].missCnt is up to date
	sysMbMTcpNodeStatus[i].state is up to date
"}    		

	sysMbMRtuWaitBeforeSendBck AT %MB5002.0 : UINT; { DE:  "Wait before send time used by functions sysMbMRTU_FCxx(), value is lower limited to 50 [ms]" } 

	{G:"USB-Host handling"}                                                 				
	sysUsbCommand	AT %MD30.0	: UDINT;			
	{ DE: "System command to upload/download to/from USB-Host  
If the value of sysUsbCommand is in the table below, then the file is saved/loaded where indicated by the corresponding parameter. 
If the value is sysUsbCommand has an offset of 100 the file will saved/loaded in NOR flash. 
If it has an offset of 200, it will be saved/loaded in the microSD. Offset 100-200 is not supported by all commands.

Table:            
0	=	No command
7	=	load PARAM.BIN from USBH
8	=	load PLCIEC.COD from USBH to PLC_volume
9	=	load HMIIEC.COD from USBH to HMI_volume
10	=	load PARAM.DAT or PARAM.RAW from USBH
11	=	save PARAM.DAT to USBH
12	=	load CONNEC.PAR from USBH to PAR_volume                                     
13	=	load HMIREM.KBD from USBH to REM_volume
14	=	save sysUsbFileName file from microSD to USBH, file name can be name.ext or *.ext 
15	=	load sysUsbFileName file from USBH to DAT_volume (ext=DAT) otherwise to microSD, file name can be name.ext or *.ext 
16	=	load file sysUsbFileName from DAT_volume, file must have PARAM.DAT format and filename name.DAT or name .RAW
18	=	load BACNET.DAT from USBH to DAT_volume
19	=	save PARAM.BIN to USBH
20	=	save LON.XIF to NOR flash
21	=	save LON.XIF to USBH
24  = load BINDIN.PAR from USBH to PAR_volume

108	=	load PLCIEC.COD from USBH to NOR flash
109	=	load HMIIEC.COD from USBH to NOR flash
112	=	load CONNEC.PAR from USBH to NOR flash
113	=	load HMIREM.KBD from USBH to NOR flash
114	=	save sysUsbFileName file from NOR flash to USBH, file name can be name.ext or *.ext 
115	=	load sysUsbFileName file from USBH, file name can be name.ext or *.ext, to NOR flash
116	=	load file sysUsbFileName from NOR flash, file must have PARAM.DAT format and filename name.DAT or name .RAW
118	=	load BACNET.DAT from USBH to NOR flash

208	=	load PLCIEC.COD from USBH to microSD
209	=	load HMIIEC.COD from USBH to microSD
212	=	load CONNEC.PAR from USBH to microSD
213	=	load HMIREM.KBD from USBH to microSD
214	=	save sysUsbFileName file from microSD to USBH, file name can be name.ext or *.ext 
215	=	load sysUsbFileName file from USBH, file name can be name.ext or *.ext, to microSD
216	=	load file sysUsbFileName from microSD, file must have PARAM.DAT format and filename name.DAT or name .RAW
218	=	load BACNET.DAT from USBH to microSD

Note:	
PLC_volume = volume per PLCIEC.COD
HMI_volume = volume per HMIIEC.COD
PAR_volume  = volume per CONNEC.PAR
REM_volume = volume per HMIREM.KBD 
DAT_volume = volume per BACNET.DAT	

"}

	sysUsbStatus	AT %MD31.0	: UDINT;			
	{ DE: "System status of operation on USB-Host
	0	=	command completed        
	1	=	command processing       
	255	=	command failed		       
	254	=	file not present	       
	253	=	file too long		       
	252	=	USBH not connected       
	251	=	file not compatible      
	250	=	some parameters fails    
	249	=	write file failed        
	248	=	open file in write failed
"}

	sysUsbFileName   AT %MB29.0 : STRING[12]; 
	{ DE:  "File managed by sysUsbCommand.
It's format is 8.3 uppercase.
" }                

	sysUsbParamDatMinAddress	AT %MW34.0	: UINT;	{ DE: "Minimum modbus address into PARAM.DAT file downloaded from controller to USB-Host"}
	sysUsbParamDatMaxAddress	AT %MW35.0	: UINT;	{ DE: "Maximum modbus address into PARAM.DAT file downloaded from controller to USB-Host"}	


	{G:"microSD handling"}                                                 				
	sysMicroSdCommand	AT %MB600.0	: USINT;			
	{ DE: "System command to mount/unmount microSD
	0	=	no command
	1	=	mount microSD
	2	=	unmount microSD
"}

	sysMicroSdStatus	AT %MB601.0	: USINT;			
	{ DE: "System status of operation on microSD
	0	=	command completed        
	1	=	command processing       
	255	=	command failed		       
	254	=	microSD yet mounted
	252	=	microSD not present
"}

	sysMicroSdPresence   AT %MB602.0 : BOOL; 
	{ DE:  "microSD presence.
TRUE = present, otherwise non present
" } 

	
	{G:"System BIOS version"}                                                 				
	sysMSK	AT %MW32.0	: UINT;			{ DE:"Mask number"}
	sysVER	AT %MW33.0	: UINT;			{ DE:"Version number"}
	
	{G:"MAC Address"}                                                				
	sysMacAddress    	AT %MB3100.0	: ARRAY[ 0..5 ] OF BYTE;	
	{ DE:"Ethernet MAC address.
	sysMacAddress[0] = first octet
	:
	sysMacAddress[5] = last octet	
" }	

	{G:"General purpose Data Blocks"}
	sysGPArrayOf_USINT    	AT %MB3101.0	: ARRAY[ 0..511 ] OF USINT;	{ DE:"General purpose array of USINT" }	
	sysGPArrayOf_UINT    		AT %MB3102.0	: ARRAY[ 0..511 ] OF UINT;	{ DE:"General purpose array of UINT" }	
	sysGPArrayOf_UDINT    	AT %MB3103.0	: ARRAY[ 0..127 ] OF UDINT;	{ DE:"General purpose array of UDINT" }			

	{G:"IP Current settings"}
	sysIP_address    	AT %MW4200.0	: ARRAY[ 0..3 ] OF UINT;	
	{ DE:"IP address.
	sysIP_address[0] = first octet
	:
	sysIP_address[3] = last octet	
	" }	
	sysDefGtwy_address    	AT %MW4201.0	: ARRAY[ 0..3 ] OF UINT;	
	{ DE:"Default Gateway address.
	sysDefGtwy_address[0] = first octet
	:
	sysDefGtwy_address[3] = last octet	
	" }	
	sysPriDNS_address    	AT %MW4202.0	: ARRAY[ 0..3 ] OF UINT;	
	{ DE:"Primary DNS address.
	sysPriDNS_address[0] = first octet
	:
	sysPriDNS_address[3] = last octet	
	" }	
	sysSecDNS_address    	AT %MW4203.0	: ARRAY[ 0..3 ] OF UINT;	
	{ DE:"Secondary DNS address.
	sysSecDNS_address[0] = first octet
	:
	sysSecDNS_address[3] = last octet	
	" }

	{G:"System Modbus messages"}
	sysMODBUS_msg_received_USB		AT %MD5000.0 : UDINT;	{ DE:"Counter for modbus message received on USB-device" }
	sysMODBUS_msg_received_RS485_1		AT %MD5000.1 : UDINT;	{ DE:"Counter for modbus message received on RS485-1" }
	sysMODBUS_msg_received_RS485_2		AT %MD5000.2 : UDINT;	{ DE:"Counter for modbus message received on RS485-2" }
	sysMODBUS_msg_received_RS485_Plugin	AT %MD5000.3 : UDINT;	{ DE:"Counter for modbus message received on RS485/232 Plugin" }			

	

END_VAR

(************************************************************************)    
(*                         									                            *)    
(*   EMBEDDED FUNCTIONS                                                 *)    
(*                                                                      *)    
(************************************************************************)   

FUNCTION sysClockWrite: USINT
	{ DE:"Write system clock.
The function returns always 0
" }

	VAR_INPUT
	    seconds	:	USINT; { DE:"seconds [0...59]" }
	    minutes	:	USINT; { DE:"minutes [0...59]" }
	    hours	:	USINT; { DE:"hours [0...23]" }
	    dayweek	:	USINT; { DE:"day of week [0...6]" }
	    daymonth	:	USINT; { DE:"day of month [1...31]" }
	    month	:	USINT; { DE:"month [1...12]" } 
	    year	:	USINT; { DE:"year [10...99]" }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysPwmDO: BOOL 
	{ DE:"Configure PWM handling for DO5 and DO6
The function return a BOOL which could have the following meanings:
TRUE	=	Command accepted.
FALSE	=	Error entering index value or duty value

PWM signal will be enabled on the physical output if the related logic output is set.
Physical output is always off if the period is 0.
" }

	VAR_INPUT
	    index	:	USINT; { DE:"Digital Output to drive as PWM [5,6]" }
	    enable	:	BOOL;  { DE:"PWM enabling [TRUE,FALSE]" }
	    period	:	UINT;  { DE:"PWM period [0...65535sec]" }
	    duty	:	USINT; { DE:"PWM duty-cycle [0...100%]" }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysSetDI_SamplingMode: BOOL 
	{ DE:"Set DI sampling mode from/to AC [50-60Hz], DC 'slow' [Ton min>=50ms, Toff min>=50ms]
to/from DC IMPULSIVE [Ton min>=15ms, Toff min>=15ms]
The function return a BOOL which could have the following meanings:
TRUE	=	Command accepted.
FALSE	=	Error, mode code not recognized. 

NOTE: this function return always FALSE because in this target it is not operative. DI1 and DI2
are already managed also as 'impulsive'
" }

	VAR_INPUT
	    mode	:	USINT; { DE:"Sampling mode [0=AC or DC 'slow',1=DC Impulsive]" }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

FUNCTION sysHmi_Message : BOOL
	{ DE:"Open a Message window on display.
The function return a BOOL which could have the following meanings:
TRUE	=	Command accepted.
FALSE	=	Error entering id value or HMI not running or function called into task timed
" }

	VAR_INPUT
	    id	:  USINT; { DE:"User Message window ID [1..99]" }
	END_VAR
	{CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysDBase_SetExtTable : USINT
	{ HIDDEN:ON }
	{ DE:"Set extended database table" }
	VAR_INPUT
		ptr   : UDINT;    { DE:"Physical address" }
		el    : UDINT;    { DE:"Number of record" }
	END_VAR
	{CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysSetMsTaskPeriod : BOOL
	{ HIDDEN:ON }
	{ DE:"Set task Timed period" }
	VAR_INPUT
		period    : UDINT;    { DE:"Period [us]" }
	END_VAR
	{CODE:EMBEDDED}
END_FUNCTION

FUNCTION sysWriteParBOOL: BOOL
	{ DE:"Write BOOL to EEPROM. 
The function return a BOOL which could have the following meanings:
TRUE	=	Writing executed correctly.
FALSE	=	Writing not executed.

Example: bret:=sysWriteParBOOL(ADR(EEPROMPARAMETER),NewValue); 
" }
	VAR_INPUT
		address : UDINT;  { DE:"Address" }
		Value   : BOOL;   { DE:"Value" }
	END_VAR
	{ CODE:EMBEDDED }
END_FUNCTION

