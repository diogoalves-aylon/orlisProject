					<functionBlock name="OperatingHours" version="1.0.2" creationDate="0" lastModifiedDate="1715264341">
						<descr>The function block calculates the operating hours of the device. It increment operating
time every hour for which machine is running and display it.</descr>
						<vars>
							<inputVars>
								<var name="xDeviceOn" type="BOOL">
									<descr>Device ON input</descr>
								</var>
								<var name="xReset" type="BOOL">
									<descr>Reset operating time</descr>
								</var>
								<var name="ptrE2_OpHours" type="@UDINT">
									<descr>Pointer to retain Operating Hours</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="udiOpHours" type="UDINT">
									<descr>Device operating time (hours)</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT">
									<descr>system Timer millisecond OLD</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="xReset_Old" type="BOOL">
									<descr>Local Reset OLD value</descr>
								</var>
								<var name="xDeviceOn_Old" type="BOOL">
									<descr>Local Device On old value</descr>
									<initValue>FALSE</initValue>
								</var>
