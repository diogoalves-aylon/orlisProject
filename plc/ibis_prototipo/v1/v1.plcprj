					<function name="f_ECBlueBasicMotorCurrent" version="1.0.0" creationDate="0" lastModifiedDate="1625235163" excludeFromBuild="FALSE">
						<descr>This function scales down and converted into REAL the info provided by i15, iReg16 on Motor Current.</descr>
						<returnValue>REAL</returnValue>
						<vars>
							<inputVars>
								<var name="i_wMotorCurrent" type="WORD">
									<descr>Motor current read [0.01 A]</descr>
								</var>
							</inputVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<sourceCode type="ST" encoded="true">
							<![CDATA[ti0R9il1tJlcBRBX08lPbwtSaq8TbTcefWaqmhJJdi8h99lzBJm0BWhXw85PbmtRaq77a08f
