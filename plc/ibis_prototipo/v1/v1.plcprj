					<functionBlock name="CompAlarmMgmt" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Compressor Alarm Management</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enables the function block</descr>
								</var>
								<var name="xEStop" type="BOOL">
									<descr>Emergency Stop</descr>
								</var>
								<var name="xMotorAlarm" type="BOOL">
									<descr>Motor Alarm Input</descr>
								</var>
								<var name="xOilPressSwitch" type="BOOL">
									<descr>Oil Pressure Alarm Input</descr>
								</var>
								<var name="xHPSwitch" type="BOOL">
									<descr>High Pressure Switch</descr>
								</var>
								<var name="xLPSwitch" type="BOOL">
									<descr>Low Pressure Switch</descr>
								</var>
								<var name="xGenericAlarm" type="BOOL">
									<descr>Generic Alarm Input</descr>
								</var>
								<var name="xCompCommand" type="BOOL">
									<descr>Compressor Start Command (1: compressor running 0: compressor stopped)</descr>
								</var>
								<var name="iHPValue" type="INT">
									<descr>High Pressure Analog Value (*0.01 bar)</descr>
								</var>
								<var name="iLPValue" type="INT">
									<descr>Low Pressure Analog Value (*0.01 bar)</descr>
								</var>
								<var name="iHPMaxLimit" type="INT">
									<descr>High Pressure Maximum Limit (*0.01 bar)</descr>
								</var>
								<var name="iLPMinLimit" type="INT">
									<descr>Low Pressure Minimum Limit (*0.01 bar)</descr>
								</var>
								<var name="uiDelayEnAlarm" type="UINT">
									<descr>Delay timeto enable LP Alarms (s)</descr>
								</var>
								<var name="uiDelayMotorAlarm" type="UINT">
									<descr>Delay time to enable Motor Alarm (s)</descr>
								</var>
								<var name="uiDelayOilPressSwitch" type="UINT">
									<descr>Delay time to enable OilPressSwitch Alarm (s)</descr>
								</var>
								<var name="uiDelayHPSwitch" type="UINT">
									<descr>Delay time to enable HP Switch Alarm (s)</descr>
								</var>
								<var name="uiDelayLPSwitch" type="UINT">
									<descr>Delay time to enable LP Switch Alarm (s)</descr>
								</var>
								<var name="uiDelayGenericAlarm" type="UINT">
									<descr>Delay time to enable Generic Alarm (s)</descr>
								</var>
								<var name="uiDelayHPAlarm" type="UINT">
									<descr>Delay time to enable HP Value Alarm (s)</descr>
								</var>
								<var name="uiDelayLPAlarm" type="UINT">
									<descr>Delay time to enable LP Value Alarm (s)</descr>
								</var>
								<var name="uiDisableAlarm" type="UINT">
									<descr>Parameter to Disable Alarms</descr>
								</var>
								<var name="xReset" type="BOOL">
									<descr>Resets the alarm</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="xAlarm" type="BOOL">
									<descr>Alarm active output</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm Id</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT">
									<descr>System Timer</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="l_udiDelayAlarm" type="UDINT">
									<descr>Delay for Enabling the LP Alarm after comp. Start</descr>
								</var>
								<var name="l_udiDelayAlarmElapsedTime" type="UDINT">
									<descr>Alarm Enable Elapsed Time</descr>
								</var>
								<var name="l_udiDelayGenericAlarm" type="UDINT">
									<descr>Delay For Generic Alarm</descr>
								</var>
								<var name="l_udiDelayHPAlarm" type="UDINT">
									<descr>Delay For HP Alarm</descr>
								</var>
								<var name="l_udiDelayHPSwitch" type="UDINT">
									<descr>Delay For HP Switch</descr>
								</var>
								<var name="l_udiDelayLPAlarm" type="UDINT">
									<descr>Delay For LP Alarm</descr>
								</var>
								<var name="l_udiDelayLPAlarmElapsedTime" type="UDINT">
									<descr>LP Alarm Elpased Time</descr>
								</var>
								<var name="l_udiDelayLPSwitch" type="UDINT">
									<descr>Delay For LP Switch</descr>
								</var>
								<var name="l_udiDelayLPSwitchElapsedTime" type="UDINT">
									<descr>LP Switch Alarm Elapsed Time</descr>
								</var>
								<var name="l_udiDelayMotorAlarm" type="UDINT">
									<descr>Delay For Motoar Alarm</descr>
								</var>
								<var name="l_udiDelayOilPressSwitch" type="UDINT">
									<descr>Oil Pressure Switch Alarm Delay</descr>
								</var>
								<var name="l_udiGenericAlarmElapsedTime" type="UDINT">
									<descr>Generic Alarm Elpased Time</descr>
								</var>
								<var name="l_udiHPAlarmElapsedTime" type="UDINT">
									<descr>HP Alarm Elapsed Time</descr>
								</var>
								<var name="l_udiHPSwitchElapsedTime" type="UDINT">
									<descr>HP Switch Alarm Elapsed Time</descr>
								</var>
								<var name="l_udiMotorAlarmElapsedTime" type="UDINT">
									<descr>Elapsed Time for Motor Alarm Timer</descr>
								</var>
								<var name="l_udiOilPressElapsedTime" type="UDINT">
									<descr>Oil Pressure Elapsed Time</descr>
								</var>
								<var name="l_udisysTimer_old" type="UDINT">
									<descr>Old Value of System Timer</descr>
								</var>
								<var name="l_xAlarmHPActiv" type="BOOL">
									<descr>HP Alarm Active</descr>
								</var>
								<var name="l_xAlarmLPActiv" type="BOOL">
									<descr>LP Alarm Active</descr>
								</var>
								<var name="l_xDelayAlamEn" type="BOOL">
									<descr>Alarm Delay Enable</descr>
								</var>
								<var name="l_xEnOld" type="BOOL">
									<descr>Previous status of Enable input</descr>
									<initValue>FALSE</initValue>
								</var>
							</localVars>
							<localConsts>
								<const name="MASKBIT1" type="UINT">
									<descr>Motor Alarm Maskbit</descr>
									<initValue>1</initValue>
								</const>
								<const name="MASKBIT2" type="UINT">
									<descr>Oil Pressure Switch Alarm Maskbit</descr>
									<initValue>2</initValue>
								</const>
								<const name="MASKBIT3" type="UINT">
									<descr>High Pressure Switch Alarm Maskbit</descr>
									<initValue>4</initValue>
								</const>
								<const name="MASKBIT4" type="UINT">
									<descr>Low Pressure Switch Alarm Maskbit</descr>
									<initValue>8</initValue>
								</const>
								<const name="MASKBIT5" type="UINT">
									<descr>Emergency Alarm Maskbit</descr>
									<initValue>16</initValue>
								</const>
								<const name="MASKBIT6" type="UINT">
									<descr>Generic Alarm Maskbit</descr>
									<initValue>32</initValue>
								</const>
								<const name="MASKBIT7" type="UINT">
									<descr>High Pressure Alarm Maskbit</descr>
									<initValue>64</initValue>
								</const>
								<const name="MASKBIT8" type="UINT">
									<descr>Low Pressure  Alarm Maskbit</descr>
									<initValue>128</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
