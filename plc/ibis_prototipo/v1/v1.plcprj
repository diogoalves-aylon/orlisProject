					</functionBlock>
					<functionBlock name="CircuitMgmt" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Circuit Management</title>
						<descr>&lt;HTML&gt;The function block  CircuitMgmt is used to control a double circuit rack of compressors for a refrigeration or HVAC system. 
It splits power percentage driven by an external control function block (for example PidAdvanced) in two circuits following specific criteria and priorities aimed to optimize functionalities and energy consumption of compressors.
CircuitMgmt must be used together with CompMgmtVS which controls the single circuit.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="rSp" type="REAL">
									<descr>Set point [%]</descr>
								</var>
								<var name="usiNbCircuit" type="USINT">
									<descr>Number of circuits (1 to 2)</descr>
									<initValue>2</initValue>
								</var>
								<var name="usiCircuitMode" type="USINT">
									<descr>Compressor Mode, 0=FIFO, 1=Runtime, 2=LIFO</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiRegulStrategy" type="USINT">
									<descr>0=Saturation, 1=Balancing</descr>
								</var>
								<var name="rHys" type="REAL">
									<descr>Hysteresis to switch on next circuit, Range 0.0 to 99.9 %</descr>
								</var>
								<var name="rCapacityCir1" type="REAL">
									<descr>Maximum capacity of circuit 1</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="rMinCapacityCir1" type="REAL">
									<descr>Minimum capacity to start circuit 1</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="rHighLimitCir1" type="REAL">
									<descr>High Limit for circuit 1 [%]</descr>
								</var>
								<var name="rLowLimitCir1" type="REAL">
									<descr>Low Limit for circuit 1 [%]</descr>
								</var>
								<var name="rOpHoursCir1" type="REAL">
									<descr>Operating hours for circuit 1 (hours)</descr>
								</var>
								<var name="usiLifoSeqCir1" type="USINT">
									<descr>Circuit 1 start sequence (priority in sequencing mode LIFO)</descr>
								</var>
								<var name="rCapacityCir2" type="REAL">
									<descr>Maximum capacity of circuit 2</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="rMinCapacityCir2" type="REAL">
									<descr>Minimum capacity to start circuit 2</descr>
									<initValue>0.0</initValue>
								</var>
								<var name="rHighLimitCir2" type="REAL">
									<descr>High Limit for circuit 2 [%]</descr>
								</var>
								<var name="rLowLimitCir2" type="REAL">
									<descr>Low Limit for circuit 2 [%]</descr>
								</var>
								<var name="rOpHoursCir2" type="REAL">
									<descr>Operating hours for circuit 2 (hours)</descr>
								</var>
								<var name="usiLifoSeqCir2" type="USINT">
									<descr>Circuit 2 start sequence (priority in sequencing mode LIFO)</descr>
								</var>
								<var name="uiSpMaxVar" type="UINT">
									<descr>Time to increase/decrease the setpoint of 10% [s] 0 leave rSp as is</descr>
									<initValue>0</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="rSpCircuit1" type="REAL">
									<descr>Setpoint for circuit 1 [%]</descr>
								</var>
								<var name="rSpCircuit2" type="REAL">
									<descr>Setpoint for circuit 2 [%]</descr>
								</var>
								<var name="rHighLimit" type="REAL">
									<descr>High Limit for PID [%]</descr>
								</var>
								<var name="rLowLimit" type="REAL">
									<descr>Low Limit for PID [%]</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm code</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert code</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime"/>
							</externalVars>
							<localVars>
								<var name="usilNbCircuit" type="USINT"/>
								<var name="usilCircuitMode" type="USINT">
									<descr>Compressor Mode, 0=FIFO, 1=Runtime, 2=LIFO</descr>
									<initValue>0</initValue>
								</var>
								<var name="usilRegulStrategy" type="USINT">
									<descr>0=Saturation, 1=Balancing</descr>
								</var>
								<var name="xlEnOld" type="BOOL"/>
								<var name="arSpCircuit" type="REAL" dim0="2"/>
								<var name="arLowLimitCir" type="REAL" dim0="2"/>
								<var name="arHighLimitCir" type="REAL" dim0="2"/>
								<var name="arPercPIDCir" type="REAL" dim0="2"/>
								<var name="ausilNrCir" type="USINT" dim0="2"/>
								<var name="arMiniC" type="REAL" dim0="2"/>
								<var name="usiTemp" type="USINT"/>
								<var name="xSwitchCir" type="BOOL"/>
								<var name="xlGetSecondTic" type="BOOL">
									<descr>Get a tic per second</descr>
								</var>
								<var name="usilActSekunde" type="USINT">
									<descr>Help Var for second tic</descr>
								</var>
								<var name="rSpMaxVar" type="REAL">
									<descr>Help var</descr>
								</var>
								<var name="rlSp" type="REAL">
									<descr>Sp internal</descr>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
