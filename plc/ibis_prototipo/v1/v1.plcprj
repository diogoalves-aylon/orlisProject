					</functionBlock>
					<functionBlock name="ECBlueBasicInfoOpCd1" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB converts the WORD i10, iReg=11, Operation condition 1 into booleans that provide info on the fan status.</descr>
						<vars>
							<inputVars>
								<var name="i_wOpCd1" type="WORD">
									<descr>Operation condition 1 WORD. iReg=11.</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xSTOP" type="BOOL">
									<descr>TRUE: STOP</descr>
								</var>
								<var name="q_xTempMgmt" type="BOOL">
									<descr>TRUE: Temperature management</descr>
								</var>
								<var name="q_xIGBT_Fault" type="BOOL">
									<descr>TRUE: IGBT FAULT CHECK</descr>
								</var>
								<var name="q_xSysIntFault" type="BOOL">
									<descr>TRUE: Internal system fault (from FW10)</descr>
								</var>
								<var name="q_xWrongDir" type="BOOL">
									<descr>TRUE: Wrong direction of rotation (from FW10)</descr>
								</var>
								<var name="q_xFireAlarm" type="BOOL">
									<descr>TRUE: Fire alarm (from FW10)</descr>
								</var>
								<var name="q_xFieldWeak" type="BOOL">
									<descr>TRUE: Field weakening (from FW10)</descr>
								</var>
								<var name="q_xCurrLim" type="BOOL">
									<descr>TRUE: Current limit (from FW10)</descr>
								</var>
								<var name="q_xDIstate" type="BOOL">
									<descr>TRUE: D1 state</descr>
								</var>
								<var name="q_xE1digState" type="BOOL">
									<descr>TRUE: E1 digital State (D2 State)</descr>
								</var>
								<var name="q_xKstate" type="BOOL">
									<descr>TRUE: K state (from 1.03 available)</descr>
								</var>
								<var name="q_xDC_Overv" type="BOOL">
									<descr>TRUE: DC-link overvoltage (from FW10)</descr>
								</var>
								<var name="q_xTempAlarmIGBT" type="BOOL">
									<descr>TRUE: Temp. Alarm IGBT (from FW 12)</descr>
								</var>
								<var name="q_xTempAlarmInside" type="BOOL">
									<descr>TRUE: Temp. Alarm Inside (from FW 12)</descr>
								</var>
								<var name="q_xReverseON" type="BOOL">
									<descr>TRUE: Reverse active (from FW 12)</descr>
								</var>
								<var name="q_xFanBad" type="BOOL">
									<descr>TRUE: Fan Bad (from FW 13)</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="conv" type="WordToBit"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
