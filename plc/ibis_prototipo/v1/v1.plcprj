					<functionBlock name="PIDAutoTuning" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>PID Auto Tuning</title>
						<descr>&lt;HTML&gt;The PIDAutoTuning function block measures the dynamic response of a control system and
calculates automatically the parameters uiTi (integral time in seconds) and rKp (proportional
gain) for that control system. These parameters can be connected to the parameter inputs of a PID
AFB (for example PIDAdvanced).
NOTE: This function block must be used together with the PIDAdvanced.
When autotuning is enabled, it induces oscillations in the process around the set-point. After the
completion of 3 oscillations, autotuning calculates a set of PI parameters.
NOTE: During the autotuning process the system is set to the minimum and maximum operating
limits to measure the process response time. Ensure that the minimum and maximum operating
limits are set correctly.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable the function block</descr>
								</var>
								<var name="xStartAutoTune" type="BOOL">
									<descr>Start / Stop the Auto tuning function (TRUE: rising edge activate autotuning, FALSE: autotuning disabled)</descr>
								</var>
								<var name="xInversCntrl" type="BOOL">
									<descr>Inverse the control (TRUE: Cooling FALSE: Heating)</descr>
								</var>
								<var name="usiMode" type="USINT">
									<descr>Mode to select the PI parameters (0 to 3)</descr>
								</var>
								<var name="rPv" type="REAL">
									<descr>Process value (User Unit)</descr>
								</var>
								<var name="rSetp" type="REAL">
									<descr>Set point (User Unit)</descr>
								</var>
								<var name="rManualKp" type="REAL">
									<descr>Manual process gain (-300.0 to 300.0)</descr>
								</var>
								<var name="uiManualTi" type="UINT">
									<descr>Manual integral time (0 to 6000 *0.1 s)</descr>
								</var>
								<var name="rHighLimit" type="REAL">
									<descr>High limit of PID (0.0 to 100.0 %)</descr>
								</var>
								<var name="rLowLimit" type="REAL">
									<descr>Low limit of PID (0.0 to 100.0 %)</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="xAutoTune" type="BOOL">
									<descr>Auto tuning Status (TRUE: active FALSE: falling edge autotuning finished)</descr>
								</var>
								<var name="rAutoTuneValue" type="REAL">
									<descr>Auto tuning Value (rLowLimit to rHighLimit %)</descr>
								</var>
								<var name="rKp" type="REAL">
									<descr>Manual or calculated proportional gain (-300.0 to 300.0)</descr>
								</var>
								<var name="uiTi" type="UINT">
									<descr>Manual or calculated integral time (0 to 6000 * 0.1 s)</descr>
								</var>
								<var name="uiMessageID" type="UINT">
									<descr>Alarm message</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm identification</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT">
									<descr>System Timer millisecond</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="l_usiCount" type="USINT">
									<descr>Local counter for the each cycle</descr>
								</var>
								<var name="l_sysTimer_Old" type="UDINT">
									<descr>System Timer millisecond OLD</descr>
								</var>
								<var name="l_udiCycleTime" type="UDINT">
									<descr>Cycle Timer in miilisecond</descr>
								</var>
								<var name="l_xStartCycleTime" type="BOOL">
									<descr>Local Start cycle trigger</descr>
								</var>
								<var name="l_xFltrCycleTimeHold" type="BOOL">
									<descr>Filter hold trigger</descr>
								</var>
								<var name="l_usiCount1" type="USINT">
									<descr>Local counter for the each cycle</descr>
								</var>
								<var name="l_usiCount2" type="USINT">
									<descr>Local counter for the each cycle</descr>
								</var>
								<var name="l_rCycleTimeHlp" type="REAL"/>
								<var name="l_rCycleTime" type="REAL"/>
								<var name="l_udiCycleTimeAvg" type="UDINT"/>
								<var name="l_udiCycleTimeAvg_Old" type="UDINT"/>
								<var name="l_rHlCycleTime" type="REAL"/>
								<var name="l_udiCycleTimeHlp" type="UDINT"/>
								<var name="l_xAttActv" type="BOOL"/>
								<var name="l_xAttFinished" type="BOOL"/>
								<var name="l_usiJmp" type="USINT"/>
								<var name="l_rKp1" type="REAL">
									<descr>Manual or calculated proportional gain</descr>
								</var>
								<var name="l_rKp3" type="REAL">
									<descr>Manual or calculated proportional gain</descr>
								</var>
								<var name="l_rKp2" type="REAL">
									<descr>Manual or calculated proportional gain</descr>
								</var>
								<var name="l_uiTi1" type="UINT">
									<descr>Manual or calculated integral time</descr>
								</var>
								<var name="l_uiTi3" type="UINT">
									<descr>Manual or calculated integral time</descr>
								</var>
								<var name="l_uiTi2" type="UINT">
									<descr>Manual or calculated integral time</descr>
								</var>
								<var name="l_rKs" type="REAL"/>
								<var name="l_rTime1" type="REAL"/>
								<var name="l_rTime2" type="REAL"/>
								<var name="l_rTime3" type="REAL"/>
								<var name="l_rTime4" type="REAL"/>
								<var name="l_rMin" type="REAL"/>
								<var name="l_rMax" type="REAL"/>
								<var name="l_rHighLimPid" type="REAL"/>
								<var name="l_rLowLimPid" type="REAL"/>
								<var name="l_rSp" type="REAL"/>
								<var name="l_rPv" type="REAL"/>
								<var name="l_udisysTimer" type="UDINT"/>
								<var name="l_xInvers_Old" type="BOOL"/>
								<var name="l_xInvers" type="BOOL"/>
								<var name="l_xStartAttOld" type="BOOL"/>
								<var name="l_xInit" type="BOOL"/>
								<var name="l_xAttCnt" type="BOOL"/>
								<var name="l_xAttCntOld" type="BOOL"/>
								<var name="l_xRes" type="BOOL"/>
								<var name="l_xTrig" type="BOOL"/>
								<var name="l_xTrigOld" type="BOOL"/>
								<var name="l_rAttAnalog" type="REAL"/>
								<var name="l_rSp_Old" type="REAL"/>
								<var name="l_rCycleTimeAvgHlp" type="REAL"/>
								<var name="l_SysOnRtrig" type="R_TRIG">
									<descr>SysOn rising trigger to reset all variables</descr>
								</var>
								<var name="xInvalidParameters" type="BOOL"/>
							</localVars>
							<localConsts>
								<const name="MASKBIT1" type="UINT">
									<initValue>1</initValue>
								</const>
								<const name="MASKBIT4" type="UINT">
									<initValue>8</initValue>
								</const>
								<const name="MASKBIT2" type="UINT">
									<initValue>2</initValue>
								</const>
								<const name="MASKBIT3" type="UINT">
									<initValue>4</initValue>
								</const>
								<const name="MASKBIT6" type="UINT">
									<initValue>32</initValue>
								</const>
								<const name="MASKBIT5" type="UINT">
									<initValue>16</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
