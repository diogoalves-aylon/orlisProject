					</functionBlock>
					<functionBlock name="Psychrometric" version="1.1.0" creationDate="0" lastModifiedDate="1579175676">
						<title>Psychrometric calculations</title>
						<descr>&lt;HTML&gt;The function block calculates the
- absolute humidity,
- enthalpy,
- dew point temperature, and
- the specific volume.
The calculation is based on the
- dry bulb temperature,
- relative humidity, and
- as optional, the atmospheric pressure.
These are common used functions in air conditioning units for humidification control, economizer
control.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable of the Function block</descr>
								</var>
								<var name="iTemp" type="INT">
									<descr>Dry bulbTempertaure of the air (-500 to  900 *0.1 °C)</descr>
								</var>
								<var name="iRh" type="INT">
									<descr>Relative Humdity of the air (0 to  1000 *0.1 %)</descr>
								</var>
								<var name="udiAtmPres" type="UDINT">
									<descr>Atmospheric Pressure (0 to 618275 Pa Default: 101325)</descr>
									<initValue>101325</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="rSpecHum" type="REAL">
									<descr>Specific Humdity/Humdity Ratio (g/kg)</descr>
								</var>
								<var name="rEnthalpy" type="REAL">
									<descr>Enthalpy of Air (kJ/kg)</descr>
								</var>
								<var name="rDewpointTemp" type="REAL">
									<descr>DewPoint Temperature of air (°C)</descr>
								</var>
								<var name="rSpecVol" type="REAL">
									<descr>Specific Volume of Air (m^3/kg)</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="C2" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
									<initValue>6.3925247</initValue>
								</var>
								<var name="C3" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
									<initValue>-0.009677843</initValue>
								</var>
								<var name="C4" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
									<initValue>0.000000622115701</initValue>
								</var>
								<var name="C5" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
								</var>
								<var name="C5_1" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
									<initValue>2.0747825E-09</initValue>
								</var>
								<var name="C6" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
								</var>
								<var name="C6_1" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
									<initValue>-9.4840240E-13</initValue>
								</var>
								<var name="C7" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
									<initValue>4.1635019</initValue>
								</var>
								<var name="C8" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
									<initValue>-5800.2206</initValue>
								</var>
								<var name="C9" type="REAL">
									<descr>Forumula Constant Hyland and Wexler (1983a) and discussed by Olivieri (1996)</descr>
									<initValue>1.3914993</initValue>
								</var>
								<var name="l_rAlpha" type="REAL">
									<descr>Calulatio For Dew Point Temp Air</descr>
								</var>
								<var name="l_rHumRatioKg" type="REAL">
									<descr>Humidity Ration in KG</descr>
								</var>
								<var name="l_rPartPres" type="REAL">
									<descr>Partial Vapour Pressure of Air</descr>
								</var>
								<var name="l_rPartPresDt" type="REAL">
									<descr>Partial Vapour Pressure of Air For Dew Point</descr>
								</var>
								<var name="l_rPAtm" type="REAL">
									<descr>Atmospheric Pressure</descr>
								</var>
								<var name="l_rPAtmKpa" type="REAL">
									<descr>Atmospheric Pressure in Kpa</descr>
								</var>
								<var name="l_rRh" type="REAL">
									<descr>Relative Humidity</descr>
								</var>
								<var name="l_rTemp" type="REAL">
									<descr>Dry bulb Temperature of Air</descr>
								</var>
								<var name="l_rTempK" type="REAL">
									<descr>Dry bulb Temperature of Air in Kelvin</descr>
								</var>
								<var name="l_rVaporPresSat" type="REAL">
									<descr>Air vapour pressure at saturation</descr>
								</var>
								<var name="l_rVarDT1" type="REAL">
									<descr>Variable for dewpoint calculation</descr>
								</var>
								<var name="l_rVarDT2" type="REAL">
									<descr>Variable for dewpoint calculation</descr>
								</var>
								<var name="l_rVarDT3" type="REAL">
									<descr>Variable for dewpoint calculation</descr>
