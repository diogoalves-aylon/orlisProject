									<descr>OldMinOffTimerElapsedTime</descr>
									<initValue>0</initValue>
								</var>
								<var name="l_udiOpHoursEt_Old" type="UDINT">
									<descr>OldOperatingHoursTimerElapsedTime</descr>
									<initValue>0</initValue>
								</var>
