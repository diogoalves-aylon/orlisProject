					</functionBlock>
					<functionBlock name="ThermalPowerCalculation" version="1.0.2" hidden="TRUE" creationDate="0" lastModifiedDate="1702546170">
						<title>Thermal Power Calculation</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable of the function Block</descr>
								</var>
								<var name="iInputTemp" type="INT">
									<descr>Input Temperature (*0.1 °C)</descr>
								</var>
								<var name="iOutputTemp" type="INT">
									<descr>Output Temperature (*0.1 °C)</descr>
								</var>
								<var name="uiFlow" type="UINT">
									<descr>Flow rate of Material (*0.1 g/s)</descr>
								</var>
								<var name="uiHeatCap" type="UINT">
									<descr>Heat Capacity of Mateial (*0.1 kJ/(kg * K) )</descr>
								</var>
								<var name="uiDensity" type="UINT">
									<descr>Density of Material (*0.1 Default: 1.0)</descr>
									<initValue>10</initValue>
								</var>
								<var name="ptrE2_ThermalEnergySaved" type="@REAL">
									<descr>Pointer for Thermal Energy Saved in EEPROM Area</descr>
								</var>
								<var name="xReset" type="BOOL">
									<descr>Reset</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="rThermalPower" type="REAL">
									<descr>Thermal Power (kW)</descr>
								</var>
								<var name="rThermalEnergy" type="REAL">
									<descr>Thermal Energy (kWh)</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT">
									<descr>SystemTimer</descr>
								</var>
								<var name="sysClock" type="TypeDataTime"/>
							</externalVars>
							<localVars>
								<var name="l_iTempDelta" type="INT">
									<descr>Diffrerence Between The input and output Temperature</descr>
								</var>
								<var name="l_rThermalEnergy" type="REAL">
									<descr>Thermal Energy</descr>
								</var>
								<var name="l_rThermalEnergyOld" type="REAL">
									<descr>Old Value of Thermal Energy</descr>
								</var>
								<var name="l_rThermalPower" type="REAL">
									<descr>Thermal Power</descr>
								</var>
								<var name="l_udiSecondTimerEl" type="UDINT">
									<descr>Second Timer</descr>
								</var>
								<var name="l_udisysTimer_old" type="UDINT">
									<descr>Old  Values of system Timer</descr>
								</var>
								<var name="l_uiAlertId" type="UINT">
									<descr>Alert ID</descr>
								</var>
								<var name="l_xIsFirstMain" type="BOOL">
									<descr>First scan  bit</descr>
								</var>
								<var name="l_xSw" type="BOOL">
									<descr>Return Value System EEPROM function</descr>
								</var>
								<var name="l_xResetOld" type="BOOL">
									<descr>Old Reset Value</descr>
								</var>
								<var name="xCJ_GetHourTic" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="uiHour_memo" type="UINT"/>
							</localVars>
							<localConsts>
								<const name="MASKBIT1" type="UINT">
									<descr>Maskbit1 for alarm of Thermal power reached to max value</descr>
									<initValue>1</initValue>
								</const>
								<const name="MASKBIT2" type="UINT">
									<descr>Maskbit2 for alarm of Thermal Energy reached to max value</descr>
									<initValue>2</initValue>
								</const>
								<const name="MAXREAL" type="REAL">
									<descr>Max value of Real</descr>
									<initValue>3.40E+38</initValue>
								</const>
								<const name="SECONDTIMER" type="UDINT">
									<descr>Second Timer</descr>
									<initValue>1000</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
