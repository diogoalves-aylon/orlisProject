			<lib version="1.1.7" name="c:\program files (x86)\eliwell\free studio plus\catalog\freeadvance\PLC\Regul and Control.plclib" fullXml="true" link="true">
				<descr>AFBs for general purpose regulation and control</descr>
				<libWorkspace>
					<folder name="Regul and Control" excludeFromBuildIfNotDef="">
						<Pou name="DayLightSaving"/>
