					<functionBlock name="FB_EEVSupervisor" version="1.0.1" hidden="true" creationDate="0" lastModifiedDate="1591785041" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV supervisor</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xRegulaEnable" type="BOOL"/>
								<var name="usiOpenCommand" type="USINT"/>
								<var name="iSupHeatSetp" type="INT"/>
								<var name="iSupHeat" type="INT">
									<descr>Measure for the SH PID</descr>
								</var>
								<var name="uiShPropBand" type="UINT"/>
								<var name="uiShIntTime" type="UINT"/>
								<var name="uiShDerTime" type="UINT"/>
								<var name="iSatTempLimit" type="INT"/>
								<var name="iSatTempPres" type="INT">
									<descr>Measure for the MOP PID</descr>
								</var>
								<var name="uiMopPropBand" type="UINT"/>
								<var name="uiMopIntTime" type="UINT"/>
								<var name="uiMopDerTime" type="UINT"/>
								<var name="xEnMop" type="BOOL"/>
								<var name="usiContModType" type="USINT">
									<descr>Continuous modulation type (0=disable, 1=cool, 2=heat)</descr>
								</var>
								<var name="iContModSet" type="INT"/>
								<var name="iContModTemp" type="INT">
									<descr>Measure for the continuous modulation PID</descr>
									<initValue>-32768</initValue>
								</var>
								<var name="uiContModPropBand" type="UINT"/>
								<var name="uiContModIntTime" type="UINT"/>
								<var name="uiContModDerTime" type="UINT"/>
								<var name="uiExtLimitValue" type="UINT">
									<initValue>1000</initValue>
								</var>
								<var name="uiShAlarmValue" type="UINT"/>
								<var name="uiOpenValue" type="UINT"/>
								<var name="uiMaxOpenValue" type="UINT"/>
								<var name="uiDeadZoneOpenMin" type="UINT"/>
								<var name="uiDeadZoneOpenMax" type="UINT"/>
								<var name="xEnShEvo" type="BOOL">
									<descr>Enable evoluted superheat algorithm</descr>
								</var>
								<var name="uiShDz" type="UINT">
									<descr>Super heat regulation dead band (advanced algorithm)  (0.1 * K/ °R)</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="uiOutput" type="UINT"/>
								<var name="usiRegulStatus" type="USINT"/>
								<var name="xSHPbAlarm" type="BOOL">
									<descr>Superheat process value out of range</descr>
								</var>
								<var name="xMOPPbAlarm" type="BOOL">
									<descr>MOP process value out of range</descr>
								</var>
								<var name="xContModPbAlarm" type="BOOL">
									<descr>Continuous modulation process value out of range</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="PidSelect" type="FB_EEVPidSelect"/>
								<var name="PIDmop" type="FB_EEVPID"/>
								<var name="PIDcontMod" type="FB_EEVPID"/>
								<var name="uiPIDSHOut" type="UINT">
									<descr>debug</descr>
								</var>
								<var name="uiShCntrlPeriod" type="UINT">
									<descr>Control period of the super heat regulation (advanced algorithm)  (0.1 * s)</descr>
									<initValue>1</initValue>
								</var>
								<var name="SHPIDEvo" type="FB_EEVSHPIDEvo"/>
								<var name="uiPIDMOPOut" type="UINT">
									<descr>debug</descr>
								</var>
								<var name="uiPIDcontModOut" type="UINT">
									<descr>debug</descr>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
