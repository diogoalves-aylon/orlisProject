					<functionBlock name="Temp2Press" version="1.1.3" creationDate="0" lastModifiedDate="1715183201">
						<title>Temperature to pressure conversion</title>
						<descr>&lt;HTML&gt;Calculate the pressure of a refrigerant based on the refrigerant temperature and refrigerant type.&lt;br&gt;
&lt;br&gt;
usiRefState:&lt;br&gt;
&lt;br&gt;
0 Vapor (50%) + Liquid (50%) &lt;br&gt;
1 Vapor&lt;br&gt;
2 Liquid&lt;br&gt;
&lt;br&gt;
&lt;br&gt;
usiReftype:&lt;br&gt;
&lt;br&gt;
0	R22&lt;br&gt;
1	R134a&lt;br&gt;
2	R404A&lt;br&gt;
3	R407C&lt;br&gt;
