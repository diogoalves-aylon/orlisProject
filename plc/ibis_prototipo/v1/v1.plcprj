					<functionBlock name="QRcodeGenerator" version="1.0.2" creationDate="0" lastModifiedDate="1656063856" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>QR code generator</title>
						<descr>&lt;HTML&gt;The QRCodeGenerator (Quick Response Code Generator) function block converts a string of
ASCII characters to the respective quick response code. The maximum allowable number of ASCII
characters is 321, when the QR code maximum output is in version 11 format, as referenced in
ISO/IEC 18004 international standard.</descr>
						<vars>
							<inputVars>
								<var name="i_iVersion" type="INT">
									<descr>QR version required. If 0 is selected, then  the lower Version capable to contain the input string is automatically selected</descr>
								</var>
								<var name="i_pausiSource" type="PVOID">
									<descr>Pointer to input string to convert to QR code</descr>
								</var>
								<var name="i_iLenStr" type="INT">
									<descr>String Length</descr>
								</var>
								<var name="i_pausiModuleData" type="@USINT">
									<descr>Pointer to the output area where to locate the QR output. The size of the area pointed depend from Version required, as in the formula (version * 4 +17)2 byte.   If version is 10 then 3249 byte, with</descr>
								</var>
								<var name="i_xStart" type="BOOL">
									<descr>Trigger FALSE to TRUE to start   conversion</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_iVersion" type="INT">
									<descr>Output Version of QR code. Redundancy with q_i_QRCodeDim</descr>
								</var>
								<var name="q_uiQRCodeDim" type="UINT">
									<descr>Size of QR code. Redundancy with q_i_Version</descr>
								</var>
								<var name="q_usiError" type="USINT"/>
								<var name="q_xOutReady" type="BOOL">
									<descr>End of QR Conversion. Data available</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="iLevel" type="INT"/>
								<var name="iMaskingNo" type="INT"/>
								<var name="iVerGroup" type="INT"/>
								<var name="GetRSCodeWord" type="FB_GetRSCodeWord"/>
								<var name="SetAlignmentPattern" type="FB_SetAlignmentPattern"/>
