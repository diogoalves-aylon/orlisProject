					</functionBlock>
					<functionBlock name="FloatingWaterTempSet" version="1.1.1" creationDate="0" lastModifiedDate="1728900541">
						<title>Water Setpoint calculation of an Air/Water Chiller/Heat Pump</title>
						<descr>&lt;HTML&gt;The block provide a calculation of the water setpoint of an air/water chiller. The setpoint is evaluated in three different ways which can be chosen with the input usiMode:
usiMode = 0: MANUAL MODE, iWaterSetp = iPivotPoint + iManualValue
usiMode = 1: FIXED MODE, iWaterSetp = iFixedValue
usiMode = 2: LAW MODE, iWaterSetp = iPivotPoint + iOffset + rSlope *  (iPivotPoint + iOffset - iOAT)</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enables the function block</descr>
								</var>
								<var name="usiMode" type="USINT">
									<descr>Select the Setpoint calculating mode: 0=Manual, 1=Fixed, 2=Law</descr>
								</var>
								<var name="iOAT" type="INT">
									<descr>Outside External Temperature (0.1 °C/F)</descr>
								</var>
								<var name="iPivotPoint" type="INT">
									<descr>Pivot point or room setpoint for the calculation with law (0 to 1000 *0.1 °C/F)</descr>
								</var>
								<var name="iManualValue" type="INT">
									<descr>Manual value offset in manual mode (-500 to 500 *0.1 °C/F)</descr>
								</var>
								<var name="iFixedValue" type="INT">
									<descr>Fixed value of the setpoint in fixed mode (-500 to 1500 *0.1 °C/F)</descr>
								</var>
								<var name="iOffset" type="INT">
									<descr>Offset in law mode (-500 to 500 *0.1 °C/F)</descr>
								</var>
								<var name="rSlope" type="REAL">
									<descr>Slope for the setpoint calculation with the law mode</descr>
								</var>
								<var name="iMinValue" type="INT">
									<descr>Minimum value of the output setpoint (0.1 °C/F)</descr>
								</var>
								<var name="iMaxValue" type="INT">
									<descr>Maxium value of the output setpoint (0.1 °C/F)</descr>
								</var>
								<var name="uiStepFilter" type="UINT">
									<descr>Incremental temperature step of the setpoint to allow smooth variations only (0.1 °C/F)</descr>
								</var>
								<var name="uiTimeStep" type="UINT">
									<descr>Incremental time step of the setpoint to allow smooth variations only (0.1 s)</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="iWaterSetp" type="INT">
									<descr>Output water setpoint (0.1 °C/F)</descr>
								</var>
								<var name="usiAlarm" type="USINT">
									<descr>Alarms byte</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="WL" type="WaterLaw"/>
								<var name="F" type="SetPointStepFilter"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="FBD" encoded="true">
