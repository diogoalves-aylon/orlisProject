					<functionBlock name="FB_EEVParFileLoader" version="1.0.1" hidden="true" creationDate="0" lastModifiedDate="1715264130" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV parameters file loader</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="FileName" type="STRING" length="32">
									<descr>Index of the row to be parsed</descr>
								</var>
								<var name="RowSelector" type="USINT">
									<descr>Index of the row to be parsed</descr>
								</var>
								<var name="MaxNumPar" type="UINT">
									<initValue>30</initValue>
								</var>
								<var name="RowsNumber" type="UINT">
									<descr>The number of rows (after header) to be parsed (0=All)</descr>
								</var>
								<var name="i_padiCurrValues" type="@DINT">
									<descr>pointer to array of parameters</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="Result" type="USINT"/>
							</outputVars>
							<localVars>
								<var name="baseAddress" type="UINT"/>
								<var name="columnIndex" type="USINT"/>
								<var name="hdrDescFound" type="BOOL"/>
								<var name="headerLineFound" type="BOOL"/>
								<var name="intAddr" type="INT"/>
								<var name="intVal" type="INT"/>
								<var name="lineIndex" type="UINT"/>
								<var name="par_FD" type="DWORD"/>
								<var name="parseState" type="USINT"/>
								<var name="processCompleted" type="BOOL"/>
								<var name="retClose" type="BOOL"/>
								<var name="retRead" type="BOOL"/>
								<var name="retStrExt1" type="USINT"/>
								<var name="retStrExt2" type="USINT"/>
								<var name="srtField" type="STRING" length="32"/>
								<var name="strAddr" type="STRING" length="32"/>
								<var name="strRow" type="STRING" length="255"/>
								<var name="strVal" type="STRING" length="32"/>
								<var name="typePresent" type="BOOL"/>
								<var name="valuesColumnsNumber" type="UINT"/>
								<var name="valuesLinesNumber" type="UINT"/>
								<var name="FieldSeparator" type="BYTE">
									<initValue>59</initValue>
								</var>
								<var name="rowsToRead" type="UINT"/>
								<var name="HDR_ADDRESS" type="STRING" length="32">
									<initValue>'Selector'</initValue>
								</var>
								<var name="usiCfgSubIndex" type="USINT">
									<initValue>0</initValue>
								</var>
								<var name="udiCfgTmo" type="UDINT">
									<initValue>1000</initValue>
								</var>
								<var name="udiCfgRet" type="UDINT"/>
								<var name="ret_bool" type="BOOL"/>
								<var name="pdiPtr" type="@DINT">
									<descr>working pointer</descr>
								</var>
								<var name="strAdd" type="STRING" length="255"/>
								<var name="xFormatAlarm" type="BOOL"/>
								<var name="usiColumnSelector" type="USINT">
									<descr>Index of the column with line selectors</descr>
								</var>
								<var name="HDR_DESC" type="STRING" length="32">
									<initValue>'Description'</initValue>
								</var>
								<var name="MAX_NUM_COLUMN" type="USINT">
									<initValue>255</initValue>
								</var>
								<var name="hdrAddFound" type="BOOL"/>
								<var name="usiColumnDesc" type="USINT">
									<descr>Index of the column with descriptors</descr>
								</var>
								<var name="MAX_NUM_ROW" type="UINT">
									<initValue>1000</initValue>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
