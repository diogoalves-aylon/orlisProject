					</functionBlock>
					<functionBlock name="Pulse2Counter" version="1.0.1" creationDate="0" lastModifiedDate="1702561168">
						<title>Pulse to Counter</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable input for the algorithm</descr>
								</var>
								<var name="xPulse" type="BOOL">
									<descr>Pulse input from energy meter</descr>
								</var>
								<var name="ptrE2_PulseCnt" type="@UDINT">
									<descr>Pulse Count EEPROM Variable</descr>
								</var>
								<var name="ptrE2_DateTimeReset" type="@USINT">
									<descr>DateTime Reset EEPROM Variables</descr>
								</var>
								<var name="xReset" type="BOOL">
									<descr>To reset the pulse count</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="udiPulseCnt" type="UDINT">
									<descr>Pulse Count Value</descr>
								</var>
								<var name="ptrSt_DateTimeReset" type="@TypeDataTime">
									<descr>Pointer to last time at which reset is done</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime">
									<descr>System Clock</descr>
								</var>
								<var name="sysTimer" type="UDINT">
									<descr>System Timer</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="l_dtResetDateTimeOut" type="TypeDataTime">
									<descr>Reset Date Time</descr>
								</var>
								<var name="l_udiPulseCntr" type="UDINT">
									<descr>Toatal Pulse  Count</descr>
								</var>
								<var name="l_udiTimer" type="UDINT">
									<descr>Timer for calulation of instnat Energy</descr>
								</var>
								<var name="l_udiTimerDelta" type="UDINT">
									<descr>Time Diferenace Between Two Pluse</descr>
								</var>
								<var name="l_udiTimerPrev" type="UDINT">
									<descr>Previous Vlaue of System Timer</descr>
								</var>
								<var name="l_xPlsOld" type="BOOL">
									<descr>Previous  Pulse bit</descr>
								</var>
								<var name="l_xResetOld" type="BOOL">
									<descr>Previous  Reset Bit</descr>
								</var>
								<var name="l_xSW" type="BOOL">
									<descr>Return Value System write Par</descr>
								</var>
								<var name="l_xFirstMain" type="BOOL">
									<descr>First Main Scan</descr>
								</var>
								<var name="xCJ_GetHourTic" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="uiHour_memo" type="UINT"/>
							</localVars>
							<localConsts>
								<const name="PLSECNTLIMIT" type="DWORD">
									<descr>Pulse Count Limit</descr>
									<initValue>4294967295</initValue>
								</const>
								<const name="MASKBIT1" type="UINT">
									<descr>MASKBIT For alarm of  two consecutive pulses is less than 100 ms</descr>
									<initValue>1</initValue>
								</const>
								<const name="MASKBIT2" type="UINT">
									<descr>Maskbit for Alarm of Maximum Limit of the  Pulse Count</descr>
									<initValue>2</initValue>
								</const>
								<const name="DIFFCONSEPUSLE" type="UDINT">
									<descr>Time Difference Between Two Pulse</descr>
									<initValue>100</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
