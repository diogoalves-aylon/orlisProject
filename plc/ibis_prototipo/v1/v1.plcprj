					</functionBlock>
					<functionBlock name="ThreePointActuator" version="2.0.0" creationDate="0" lastModifiedDate="0">
						<title>Three Points Actuator</title>
						<descr>&lt;HTML&gt;This function block controls a 3-point actuator which is very common in HVAC systems.
3-point actuators feature two digital inputs, one for closing and one for opening action. 
The function block calculates the required commands based on the Control Signal and the 
current position. It tracks the current position of the actuator and includes 
a calibration function.
In simulation mode the function block must be used in Timed Task, otherwise the closing time calculated in the calibration is not correct.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable/disable the function block</descr>
								</var>
								<var name="xHold" type="BOOL">
									<descr>Hold input</descr>
								</var>
								<var name="uiControlSignal" type="UINT">
									<descr>Input value (0 to 10000 *0.01%)</descr>
								</var>
								<var name="uiMaxRuntime" type="UINT">
									<descr>Actuator run time (20 to 40000 *0.1 s)</descr>
								</var>
								<var name="uiHysteresis" type="UINT">
									<descr>Minimum step time (0 to 3000 *0.01%)</descr>
								</var>
								<var name="xCalibration" type="BOOL">
									<descr>Calibration command</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="usiState" type="USINT">
									<descr>Current state of the function block (0 to 99)</descr>
								</var>
								<var name="xOpen" type="BOOL">
									<descr>Actuator open signal</descr>
								</var>
								<var name="xClose" type="BOOL">
									<descr>Actuator close signal</descr>
								</var>
								<var name="uiPosition" type="UINT">
									<descr>Current actuator position (0 to 10000 *0.01%)</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysTimer" type="UDINT"/>
							</externalVars>
							<localVars>
								<var name="uilCt" type="UINT"/>
								<var name="udilCt" type="UDINT"/>
								<var name="rlCt" type="REAL"/>
								<var name="udilTmeMs" type="UDINT"/>
								<var name="rlStep" type="REAL"/>
								<var name="rlTimeAvz" type="REAL"/>
								<var name="rlMaxRt" type="REAL"/>
								<var name="udilMaxRt" type="UDINT"/>
								<var name="usilStatz" type="USINT"/>
								<var name="rlPos" type="REAL"/>
								<var name="udilTmeMsOld" type="UDINT"/>
								<var name="rlPosHlp" type="REAL"/>
								<var name="uilMaxRtOld" type="UINT"/>
								<var name="rlTimeCnt" type="REAL"/>
								<var name="udilCalibTime" type="UDINT"/>
								<var name="xlCmdOpen" type="BOOL"/>
								<var name="xlCmdClose" type="BOOL"/>
								<var name="xlStart" type="BOOL"/>
								<var name="xlEnOld" type="BOOL"/>
								<var name="xlCalib" type="BOOL"/>
								<var name="xlCalibOld" type="BOOL"/>
								<var name="xlCtHold" type="BOOL"/>
								<var name="xlUp" type="BOOL"/>
								<var name="xlDown" type="BOOL"/>
								<var name="xlTimerAvz" type="BOOL"/>
								<var name="xlAlrm" type="BOOL"/>
								<var name="xlFstCalib" type="BOOL"/>
								<var name="xlHoldOld" type="BOOL"/>
								<var name="xInit" type="BOOL"/>
								<var name="usilState" type="USINT"/>
								<var name="rTemp" type="REAL"/>
								<var name="rTemp1" type="REAL"/>
								<var name="rTemp2" type="REAL"/>
								<var name="uilRoundNbr" type="UINT"/>
								<var name="uilRound" type="UINT"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
