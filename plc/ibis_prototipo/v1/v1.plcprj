					</functionBlock>
					<functionBlock name="ThermalPower_Enthalpy" version="1.0.2" hidden="TRUE" creationDate="0" lastModifiedDate="1729506800">
						<title>Thermal Power from enthalpy and mass flow</title>
						<descr>&lt;HTML&gt;The ThermalPower_Enthalpy function calculates thermal power and thermal energy based on mass flow and on enthalpies.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable/Disable the function block</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="uiFlow" type="UINT">
									<descr>Mass flow (*0.1 g/s)</descr>
									<initValue>0</initValue>
								</var>
								<var name="rInputEnthalpy" type="REAL">
									<descr>Input enthalpy (kJ/kg)</descr>
									<initValue>0</initValue>
								</var>
								<var name="rOutputEnthalpy" type="REAL">
									<descr>Output enthalpy (kJ/kg)</descr>
									<initValue>0</initValue>
								</var>
								<var name="ptrE2_ThermalEnergySaved" type="@REAL">
									<descr>rThermalEnergySaved pointer for EEPROM variable</descr>
									<initValue>0</initValue>
								</var>
								<var name="xReset" type="BOOL">
									<descr>Reset the calculation of the thermal energy</descr>
									<initValue>FALSE</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="rThermalPower" type="REAL">
									<descr>Thermal Power (kW)</descr>
									<initValue>0</initValue>
								</var>
								<var name="rThermalEnergy" type="REAL">
									<descr>Thermal Energy (kWh)</descr>
									<initValue>0</initValue>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysClock" type="TypeDataTime"/>
							</externalVars>
							<localVars>
								<var name="l_xFirstMain" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="RtrigDetect" type="R_TRIG"/>
								<var name="uiHour_memo" type="UINT"/>
								<var name="uiSecond_memo" type="UINT">
									<initValue>0</initValue>
								</var>
								<var name="xCJ_GetHourTic" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="xCJ_GetSecondTic" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
								<var name="xSW" type="BOOL">
									<initValue>FALSE</initValue>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
