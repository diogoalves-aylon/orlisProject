						<descr>&lt;HTML&gt;The EvapPressCntrl function block is intended to provide the pressure control of a heat pump machine by regulating the speed of evaporator fans.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable/Disable the function block</descr>
								</var>
								<var name="iEvapPress" type="INT">
									<descr>Relative refrigerant pressure(*0.01 Bar/*0.1PSI)</descr>
									<initValue>100</initValue>
								</var>
								<var name="iEvapTempExtSetp" type="INT">
									<descr>Evaporating Temperature External Setpoint (*0.1°C/°F)</descr>
									<initValue>400</initValue>
								</var>
								<var name="iOutAirTemp" type="INT">
									<descr>Outdoor air temperature (*0.1°C/°F)</descr>
								</var>
								<var name="xEvapPressAlarm" type="BOOL">
									<descr>Relative Low Pressure Alarm</descr>
								</var>
								<var name="iEvapTempOffset" type="INT">
									<descr>Evaporating temperature offset (-200 to 0 *0.1°C/°F)</descr>
									<initValue>-100</initValue>
								</var>
								<var name="iEvapTempOffsetAtMin" type="INT">
									<descr>Minimum outdoor air temperature (-200 to 0 *0.1°C/°F)</descr>
									<initValue>-150</initValue>
								</var>
								<var name="iEvapTempOffsetAtMax" type="INT">
									<descr>Maximum outdoor air temperature (-200 to 0 *0.1°C/°F)</descr>
									<initValue>-200</initValue>
								</var>
								<var name="iEvapTempMin" type="INT">
									<descr>Minimum Evaporating temperature (-580 to 3020*0.1°C/°F)</descr>
									<initValue>0</initValue>
								</var>
								<var name="iEvapTempMax" type="INT">
									<descr>Maximum Evaporating temperature (-580 to 3020*0.1°C/°F)</descr>
									<initValue>500</initValue>
								</var>
								<var name="usiRefType" type="USINT">
									<descr>Refrigerant type (0 to 26 Default: 0 Custom: 255)</descr>
								</var>
								<var name="uiKp" type="UINT">
									<descr>Proportional gain (1 to 500*0.1 user unit)</descr>
									<initValue>60</initValue>
								</var>
								<var name="uiTi" type="UINT">
									<descr>Integral time (0 to 3600*0.1 s)</descr>
								</var>
								<var name="uiDeadband" type="UINT">
									<descr>Deadband (0 to 500*0.1 user unit)</descr>
									<initValue>0</initValue>
								</var>
								<var name="usiControlMode" type="USINT">
									<descr>Evaporating Pressure control type (0 to 2)</descr>
									<initValue>1</initValue>
								</var>
								<var name="iEvapPressMinLimit" type="INT">
									<descr>Evaporating pressure low limit  (0 to 14500*0.01 Bar/0.1 PSI)</descr>
									<initValue>100</initValue>
								</var>
								<var name="xUnitTypeTemp" type="BOOL">
									<descr>Unit Selection Bit : TRUE: °F, FALSE: °C</descr>
								</var>
								<var name="xUnitTypePress" type="BOOL">
									<descr>Unit Selection Bit : TRUE: PSI, FALSE: Bar</descr>
								</var>
								<var name="arCustRefParam" type="REAL" dim0="5">
									<descr>Custom Refrigerant Parameters Array</descr>
								</var>
								<var name="iCustRefPressMin" type="INT">
									<descr>Custom Refrigerant minimum pressure (*0.01 Bar)</descr>
									<initValue>0</initValue>
								</var>
								<var name="iCustRefPressMax" type="INT">
									<descr>Custom Refrigerant maximum pressure (*0.01 Bar)</descr>
									<initValue>0</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="uiFanCntrlSignal" type="UINT">
									<descr>PID output (*0.1 %)</descr>
								</var>
								<var name="iEvapTemp" type="INT">
									<descr>Evaporating Temperature (*0.1°C/°F)</descr>
								</var>
								<var name="iEvapTempSetp" type="INT">
									<descr>Evaporating Temperature Setpoint (*0.1°C/°F)</descr>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarm ID</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="tempo2" type="INT"/>
								<var name="tempo1" type="REAL"/>
								<var name="l_xUnitTypeTemp" type="BOOL"/>
								<var name="l_xUnitTypePress" type="BOOL"/>
								<var name="l_xEnOld" type="BOOL"/>
								<var name="l_usiRefType" type="USINT"/>
								<var name="l_uiDeadband" type="UINT">
									<descr>Deadband</descr>
								</var>
								<var name="iEvapRefrTempSetp_Calc" type="INT">
									<initValue>0</initValue>
								</var>
								<var name="XL" type="INT"/>
								<var name="XH" type="INT"/>
								<var name="PID_AD" type="PIDAdvanced"/>
								<var name="DX" type="INT"/>
								<var name="DOff" type="INT"/>
								<var name="Conv_Press_To_Temp" type="Press2Temp"/>
								<var name="xAlertOutOfRangeTi" type="BOOL"/>
								<var name="iEvapRefrPressInternal" type="INT"/>
							</localVars>
							<localConsts>
								<const name="testmoin58dc" type="INT">
									<initValue>-580</initValue>
								</const>
								<const name="test302dc" type="INT">
									<initValue>3020</initValue>
								</const>
								<const name="test200dc" type="INT">
									<initValue>200</initValue>
								</const>
								<const name="test1450bar" type="INT">
									<initValue>14500</initValue>
								</const>
								<const name="test0dc" type="INT">
									<initValue>0</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
