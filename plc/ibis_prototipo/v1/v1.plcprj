					</functionBlock>
					<functionBlock name="ECBlueBasicCMODE" version="1.0.0" creationDate="0" lastModifiedDate="0" excludeFromBuild="FALSE">
						<descr>This AFB can be used to set the ControlMode parameter (h4, reg5).

After the call of the AFB, a PIN/motor reset can be executed by using the related FB. This allows news settings to be taken over.

The configuration message is sent when a transition of xEn from FALSE to TRUE takes place.

The output provides the info on whether the operation has been successful or not.

The ECBlueBasicCMODE AFB must be put inside the Background task of the PLC.</descr>
						<vars>
							<inputVars>
								<var name="i_xEn" type="BOOL">
									<descr>Transition FALSE -&gt; TRUE changes the settings in the fan.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_usiZiehlAddress" type="USINT">
									<descr>Ziehl Fan Address. Broadcast not supported. Default: 1.</descr>
									<initValue>1</initValue>
								</var>
								<var name="i_usiSpeedCMODE" type="USINT">
									<descr>0: Ctrl by E1 (0-10V, PWM), default. 1: by HReg2 (ECblue: abs speed, F-ctrl: freq 1/10Hz. 2: by HReg2 (0-32767). 3: by HRge2 (0-100). 4: Set Intern1. 5: Set Intern2. 6: Set Intern3.</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_usiAutoErrReset" type="USINT">
									<descr>Automatic reset after error. 0: no reset, 1: auto reset after 1 min, 2: auto reset after 15 mins, 3: auto reset after 60 mins</descr>
									<initValue>0</initValue>
								</var>
								<var name="i_xBusconEn" type="BOOL">
									<descr>FALSE: h1 bit 0 deactivated  TRUE: h1 bit 0 active (OR'ed w/ DI)</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xBusconSetIntern2" type="BOOL">
									<descr>FALSE: h1 bit 1 deactivated  TRUE: h1 bit 1 active (OR'ed w/ DI)</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xBusconSetIntern3" type="BOOL">
									<descr>FALSE: h1 bit 2 deactivated  TRUE: h1 bit 2 active (OR'ed w/ DI)</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xBusconLimit" type="BOOL">
									<descr>FALSE: h1 bit 3 deactivated  TRUE: h1 bit 3 active (OR'ed w/ DI)</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xBusconReverse" type="BOOL">
									<descr>FALSE: h1 bit 4 deactivated  TRUE: h1 bit 4 active (OR'ed w/ DI)</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="i_xBusconFireAlarm" type="BOOL">
									<descr>FALSE: h1 bit 5 deactivated  TRUE: h1 bit 5 active (OR'ed w/ DI)</descr>
									<initValue>FALSE</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="q_xChanged" type="BOOL">
									<descr>TRUE if the ControlMode parameter has been successfully changed.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xWorking" type="BOOL">
									<descr>ControlMode Change Operation in progress.</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="q_xFailed" type="BOOL">
									<descr>ControlMode Change has failed.</descr>
								</var>
								<var name="q_xWrongInputs" type="BOOL">
									<descr>Inputs out of range</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="i" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="xEn_old" type="BOOL"/>
								<var name="wCMODE" type="WORD">
									<descr>WORD to be sent</descr>
									<initValue>65535</initValue>
								</var>
								<var name="MsgNum" type="USINT">
									<initValue>10</initValue>
								</var>
								<var name="uiTargetAddr" type="UINT"/>
								<var name="wCMODE_Check" type="WORD">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_CMODE" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="uiRet_CMODE_Check" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="j" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="k" type="USINT">
									<initValue>250</initValue>
								</var>
								<var name="uiRet_PIN" type="UINT">
									<initValue>65535</initValue>
								</var>
								<var name="iPINL2" type="INT">
									<initValue>0010</initValue>
								</var>
							</localVars>
							<localConsts>
								<const name="usiRetries" type="USINT">
									<descr>Operation retries.</descr>
									<initValue>5</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
