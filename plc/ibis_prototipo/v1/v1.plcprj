					</functionBlock>
					<functionBlock name="ATV320ModbusTcpCom" version="1.0.0" creationDate="0" lastModifiedDate="1615981464" excludeFromBuild="FALSE">
						<title>ATV320ModbusTcpCom</title>
						<descr>The ATV320ModbusTcpCom function block manages the communication between the controller
and the ATV320 drive through Modbus Tcp ethernet communication protocol.
it must be used with the ATV320 Modbus Tcp profile.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>TRUE: FB  enabled FALSE: FB disabled.</descr>
								</var>
								<var name="xCommand" type="BOOL">
									<descr>TRUE: Start Drive FALSE: Stop Drive</descr>
								</var>
								<var name="xDirection" type="BOOL">
									<descr>TRUE: Backward FALSE: Forward</descr>
