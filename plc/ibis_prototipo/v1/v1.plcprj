17 = Function not executed due to try to call it in Timed
18 = NUmber of object out of range

" }

	VAR_INPUT
		addr:		USINT;  { DE:"Physical address of the target slave" }		
		base :	UINT;  { DE:"Address of the first Input to read" }
		no :	UINT;  { DE:"Number of contiguous Inputs to read [1..20]" }
		object :	@BOOL;  { DE:"Discrete Inputs array pointer" }
		timeout :	UINT;  { DE:"Timeout [ms]" }
	END_VAR

    {CODE:EMBEDDED}
END_FUNCTION

