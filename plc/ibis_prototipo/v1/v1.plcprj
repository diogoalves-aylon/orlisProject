					<functionBlock name="FB_EEVMgmt" version="1.0.4" hidden="true" creationDate="0" lastModifiedDate="1715264130" excludeFromBuild="FALSE" excludeFromBuildIfNotDef="">
						<title>EEV management</title>
						<descr>&lt;HTML&gt;</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL"/>
								<var name="xStart" type="BOOL">
									<descr>F_to_T: start procedure  T_to_F: stop procedure</descr>
								</var>
								<var name="xAlarm" type="BOOL">
									<descr>External Alarm input</descr>
								</var>
								<var name="xComAlarm" type="BOOL">
									<descr>Communication Alarm input</descr>
								</var>
								<var name="xIntAlarm" type="BOOL">
									<descr>Internal Alarm input</descr>
								</var>
								<var name="uiAlarmValue" type="UINT">
									<descr>Value on generic external alarm</descr>
								</var>
								<var name="uiComAlarmValue" type="UINT">
									<descr>Value on comunication alarm</descr>
								</var>
								<var name="xDefrost" type="BOOL">
									<descr>F_to_T: defrost procedure  T_to_F: restart procedure</descr>
								</var>
								<var name="xManualOpen" type="BOOL">
									<descr>Comand the manual open to the valve</descr>
								</var>
								<var name="uiManualOpen" type="UINT">
									<descr>Manual open with high priority</descr>
								</var>
								<var name="uiStartValue" type="UINT">
									<descr>Value on restart from off</descr>
								</var>
								<var name="uiDelayOnStart" type="UINT">
									<descr>Time with fixed value on restart (0 to 2000 s)</descr>
								</var>
								<var name="uiStopValue" type="UINT">
									<descr>Fixed value before stop</descr>
								</var>
								<var name="uiTimeOnStop" type="UINT">
									<descr>Time on stop and on defrost procedures (0 to 2000 s)</descr>
								</var>
								<var name="uiDefrostValue" type="UINT">
									<descr>Value on restart from defrost</descr>
								</var>
								<var name="uiOut" type="UINT">
									<descr>Output value (to save the last value before off/defrost)</descr>
								</var>
								<var name="ptrE2_voidLastValue" type="PVOID">
									<descr>EEPROM area which is stored the last out</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="usiOpenCommand" type="USINT">
									<descr>Type of fixed open command (0=no open command)</descr>
								</var>
								<var name="uiOpenValue" type="UINT">
									<descr>Fixed open value</descr>
								</var>
								<var name="xEEPAlarm" type="BOOL">
									<descr>Alarm EEPROM</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="xStartOld" type="BOOL"/>
								<var name="xTstop" type="BOOL">
									<descr>Trigger the stop timer</descr>
								</var>
								<var name="xDefrostOld" type="BOOL"/>
								<var name="Timer_stop" type="TON"/>
								<var name="xT" type="BOOL">
									<descr>Trigger the restart timer</descr>
								</var>
								<var name="Timer_on" type="TON"/>
								<var name="x" type="BOOL"/>
								<var name="xEEcheck" type="BOOL"/>
								<var name="xManualOpenOld" type="BOOL"/>
								<var name="xFlag" type="BOOL"/>
								<var name="xAlarmOld" type="BOOL"/>
								<var name="ptrE2_uiLastValue" type="@UINT">
									<descr>EEPROM area which is stored the last out</descr>
								</var>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
