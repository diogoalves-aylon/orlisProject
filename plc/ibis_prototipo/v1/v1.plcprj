					</functionBlock>
					<functionBlock name="Fluid_Density" version="1.0.0" creationDate="0" lastModifiedDate="0">
						<title>Fluid density calculation</title>
						<descr>&lt;HTML&gt;Calculate the density of a refrigerant based on the refrigerant temperature and pressure and the refrigerant type.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>Enable/Disable the function block</descr>
								</var>
								<var name="iTemp" type="INT">
									<descr>Refrigerant temperature (*0.1 °C)</descr>
								</var>
								<var name="iPress" type="INT">
									<descr>Refrigerant relative pressure (*0.01 bar)</descr>
								</var>
								<var name="usiRefType" type="USINT">
									<descr>Refrigerant type (0 to 12 Default: 0)</descr>
									<initValue>0</initValue>
								</var>
							</inputVars>
							<outputVars>
								<var name="rDens" type="REAL">
									<descr>Refrigerant density (kg/m^3)</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
							</outputVars>
							<localVars>
								<var name="arParam" type="REAL" dim0="7"/>
								<var name="xAlertBit0" type="BOOL"/>
								<var name="xAlertBit1" type="BOOL"/>
							</localVars>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
						<sourceCode type="ST" encoded="true">
