					<functionBlock name="ATV320ModbusCom" version="1.0.1" creationDate="0" lastModifiedDate="1615981464" excludeFromBuild="FALSE">
						<title>ATV320ModbusCom</title>
						<descr>&lt;HTML&gt;The ATV320ModbusCom function block manages the communication between the controller
and the ATV320 drive through Modbus serial line communication protocol.
it must be used with the ATV320 Modbus profile.</descr>
						<vars>
							<inputVars>
								<var name="xEn" type="BOOL">
									<descr>TRUE: FB  enabled FALSE: FB disabled.</descr>
								</var>
								<var name="xCommand" type="BOOL">
									<descr>TRUE: Start Drive FALSE: Stop Drive</descr>
								</var>
								<var name="xDirection" type="BOOL">
									<descr>TRUE: Backward FALSE: Forward</descr>
								</var>
								<var name="uiFreqSetp" type="UINT">
									<descr>Drive Frequency (*0.1 Hz)</descr>
								</var>
								<var name="usiNodeNr" type="USINT">
									<descr>Node Number of the slave (0 to 127)</descr>
								</var>
								<var name="uiTimeOut" type="UINT">
									<descr>ModbusTimeOut (0 to 100 *s)</descr>
								</var>
								<var name="rMb_uiDrvStatus" type="UINT">
									<descr>ATV status</descr>
								</var>
								<var name="rMb_uiDrvAlarm" type="UINT">
									<descr>ATV Alarm</descr>
								</var>
								<var name="rMb_uiFreqMin" type="UINT">
									<descr>Freq Min read in ATV</descr>
								</var>
								<var name="rMb_uiFreqMax" type="UINT">
									<descr>Freq Max read in ATV</descr>
								</var>
								<var name="rMb_uiFreqSetpOut" type="UINT">
									<descr>Actual ATV Freq</descr>
								</var>
								<var name="xReset" type="BOOL">
									<descr>TRUE: Reset fault FALSE: No reset fault</descr>
								</var>
							</inputVars>
							<outputVars>
								<var name="uiActFreq" type="UINT">
									<descr>Actual drive frequency (0 to 5000 *0.1 Hz)</descr>
								</var>
								<var name="usiState" type="USINT">
									<descr>State of the FB (0 to 5)</descr>
									<initValue>0</initValue>
								</var>
								<var name="uiAlarmID" type="UINT">
									<descr>Alarme ID</descr>
								</var>
								<var name="uiAlertID" type="UINT">
									<descr>Alert ID</descr>
								</var>
								<var name="wMb_uiCmd" type="UINT">
									<descr>Drive Command</descr>
								</var>
								<var name="wMb_uiFreqSetp" type="UINT">
									<descr>Drive Frequency Command</descr>
								</var>
								<var name="wMb_uiTimeOut" type="UINT">
									<descr>Drive TimeOut</descr>
								</var>
								<var name="wMb_uiTimeOutStop" type="UINT">
									<descr>Drive TimeOut Enable/Disable Command</descr>
								</var>
							</outputVars>
							<externalVars>
								<var name="sysMbMRtuNodePresence" type="BOOL" dim0="128"/>
								<var name="sysMbMRtuNodeStatus" type="MBMNODESTATUS" dim0="128"/>
								<var name="sysTimer" type="UDINT">
									<descr>System Timer in miilisecond</descr>
								</var>
							</externalVars>
							<localVars>
								<var name="l_uiDrvStatusMasked" type="UINT">
									<descr>Masked Drive status</descr>
								</var>
								<var name="l_usiNodeNr" type="USINT">
									<descr>Local node number</descr>
								</var>
								<var name="l_xEnOld" type="BOOL">
									<descr>Local enable</descr>
									<initValue>FALSE</initValue>
								</var>
								<var name="uiActFreq_ABS" type="UINT">
									<descr>Actual frequency absolute</descr>
								</var>
								<var name="l_uiTimeOut" type="UINT">
									<descr>Local Time out</descr>
								</var>
								<var name="iActFreqInt" type="INT">
									<descr>Actual Frequency in integer</descr>
								</var>
								<var name="jk" type="INT">
									<descr>Local counter</descr>
								</var>
								<var name="l_xDrvStatus" type="WordToBit">
									<descr>Word to bit extract for drive Status</descr>
								</var>
								<var name="l_xAlarmID" type="WordToBit">
									<descr>Word to bit extract for AlaramID</descr>
								</var>
								<var name="l_xComAlarm" type="BOOL">
									<descr>Communication alarm real time</descr>
								</var>
								<var name="l_tToffTimer" type="TOF">
									<descr>TOFF for writing timeout disable after xEn - False</descr>
								</var>
								<var name="l_xComAlarmTimed" type="BOOL">
									<descr>Communication Alarm after the time delay</descr>
								</var>
								<var name="l_udiTimerEt" type="UDINT">
									<descr>Elapsed time for the milisecond timer</descr>
								</var>
								<var name="l_udiTimerEt_Old" type="UDINT">
									<descr>Elapsed time for the milisecond timer - Old</descr>
								</var>
								<var name="l_tTimeinSec" type="UDINT">
									<descr>Time in Seconds</descr>
								</var>
								<var name="sysTimer_Old" type="UDINT">
									<descr>System Timer in miilisecond - Old</descr>
								</var>
							</localVars>
							<localConsts>
								<const name="NSTSTATE1" type="UINT">
									<descr>State defines</descr>
									<initValue>80</initValue>
								</const>
								<const name="NSTSTATE2" type="UINT">
									<descr>State defines</descr>
									<initValue>64</initValue>
								</const>
								<const name="RDYSTATE1" type="UINT">
									<descr>State defines</descr>
									<initValue>49</initValue>
								</const>
								<const name="RDYSTATE2" type="UINT">
									<descr>State defines</descr>
									<initValue>33</initValue>
								</const>
								<const name="SWITCHONSTATE1" type="UINT">
									<descr>State defines</descr>
									<initValue>51</initValue>
								</const>
								<const name="SWITCHONSTATE2" type="UINT">
									<descr>State defines</descr>
									<initValue>35</initValue>
								</const>
								<const name="RUNSTATE1" type="UINT">
									<descr>State defines</descr>
									<initValue>55</initValue>
								</const>
								<const name="RUNSTATE2" type="UINT">
									<descr>State defines</descr>
									<initValue>39</initValue>
								</const>
								<const name="SHUTDOWN_CMD" type="UINT">
									<descr>Command defines</descr>
									<initValue>6</initValue>
								</const>
								<const name="SWITCHON_CMD" type="UINT">
									<descr>Command defines</descr>
									<initValue>7</initValue>
								</const>
								<const name="RUN_FWDCMD" type="UINT">
									<descr>Command defines</descr>
									<initValue>15</initValue>
								</const>
								<const name="RUN_REVCMD" type="UINT">
									<descr>Command defines</descr>
									<initValue>2063</initValue>
								</const>
								<const name="DRV_INIT" type="USINT">
									<descr>State machine defines</descr>
									<initValue>0</initValue>
								</const>
								<const name="DRV_STOP" type="USINT">
									<descr>State machine defines</descr>
									<initValue>1</initValue>
								</const>
								<const name="DRV_STARTING" type="USINT">
									<descr>State machine defines</descr>
									<initValue>2</initValue>
								</const>
								<const name="DRV_RUN" type="USINT">
									<descr>State machine defines</descr>
									<initValue>3</initValue>
								</const>
								<const name="DRV_STOPPING" type="USINT">
									<descr>State machine defines</descr>
									<initValue>4</initValue>
								</const>
								<const name="DRV_ALARM" type="USINT">
									<descr>State machine defines</descr>
									<initValue>5</initValue>
								</const>
								<const name="INTERVAL" type="UINT">
									<descr>Inveral for calculating in Seconds</descr>
									<initValue>1000</initValue>
								</const>
								<const name="DRV_RESETCMD" type="UINT">
									<descr>Drive command define</descr>
									<initValue>128</initValue>
								</const>
								<const name="MAXNODE" type="USINT">
									<descr>Maximum Node Number</descr>
									<initValue>127</initValue>
								</const>
								<const name="MAXTIMEOUT" type="UINT">
									<descr>Maximum Time Out</descr>
									<initValue>100</initValue>
								</const>
							</localConsts>
						</vars>
						<iecDeclaration active="FALSE"/>
						<interfaces/>
						<methods/>
