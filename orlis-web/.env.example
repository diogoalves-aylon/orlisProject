# Copia este ficheiro para .env.local.django (dev) ou .env.prod e preenche os valores reais.
# Nunca commitar ficheiros .env com segredos verdadeiros — só este exemplo fica no git.

DEBUG=True
DJANGO_ENVIRONMENT="local"
SECRET_KEY=changeme

# Update this with the actual base URL of your application
BASE_URL=http://127.0.0.1:8000

# Configuração do PostgreSQL
DB_NAME=orlis_local
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Configuração do MongoDB (telemetria dos chillers)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=orlis_db

# Configuração do MQTT (listener de telemetria dos chillers — apps/dashboard/management/commands/mqtt_listener.py)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_METADATA_REFRESH_SECONDS=300
# Desvio máximo (segundos) tolerado entre o timestamp do payload e a hora do servidor
# antes de o considerar suspeito e usar a hora de receção nos cálculos
MQTT_TIMESTAMP_MAX_SKEW_SECONDS=3600

# Configuração das sessões
SESSION_ENGINE=django.contrib.sessions.backends.db
SESSION_COOKIE_SECURE=False  # True em produção
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=3600

# Configuração de autenticação
LOGIN_URL=/login/
LOGOUT_REDIRECT_URL=/login/
