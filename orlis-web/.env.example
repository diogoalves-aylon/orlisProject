# Copia este ficheiro para .env.local.django (dev) ou .env.prod e preenche os valores reais.
# Nunca commitar ficheiros .env com segredos verdadeiros — só este exemplo fica no git.

DEBUG=True
DJANGO_ENVIRONMENT="local"
SECRET_KEY=changeme

# Update this with the actual base URL of your application
BASE_URL=http://127.0.0.1:8000

# Configuração do PostgreSQL
# No deployment com docker-compose.yml, DB_HOST é o nome do serviço ("postgres"), não
# localhost — dentro da rede do compose, localhost é o próprio container.
DB_NAME=orlis_local
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Configuração do MongoDB (telemetria dos chillers)
# O código lê MONGO_URL, uma URL completa — não lê MONGO_USER/MONGO_PASSWORD.
# Em local, sem autenticação, basta a URL simples:
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=orlis_db
# No servidor 172.20.50.164 o Mongo é o container `orlis_mongo` (mongo:7) da equipa de
# devops, na rede `thermia_net`, e EXIGE autenticação. Lá o docker-compose.yml monta o
# MONGO_URL a partir destas três variáveis, para não haver uma segunda cópia do segredo:
#   MONGO_USER=<pedir ao devops>
#   MONGO_PASSWORD=<pedir ao devops>
#   MONGO_AUTH_SOURCE=admin
# O authSource é a base onde o utilizador foi criado, não a base de dados da aplicação.
# Se a senha vier a ter caracteres como @ : / ? #, tem de ser percent-encoded na URL.
MONGO_AUTH_SOURCE=admin

# Configuração do MQTT (listener de telemetria dos chillers — apps/dashboard/management/commands/mqtt_listener.py)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_METADATA_REFRESH_SECONDS=300
# Desvio máximo (segundos) tolerado entre o timestamp do payload e a hora do servidor
# antes de o considerar suspeito e usar a hora de receção nos cálculos
MQTT_TIMESTAMP_MAX_SKEW_SECONDS=3600
# Tópico a subscrever. Simulador local: chillers/+/telemetria
# Broker da Thermia: iot/raspberry-aylon/#
MQTT_TOPIC=chillers/+/telemetria

# mTLS. O broker da Thermia (172.20.50.162:8883) exige CA + certificado + chave do cliente;
# os ficheiros vivem em /opt/apps/thermia/certs/mqtt no servidor 172.20.50.164.
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERTS=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=
# Desliga só a verificação do hostname (necessário através de um túnel SSH para localhost;
# na ligação direta ao IP do broker deixar false)
MQTT_TLS_INSECURE=false

# Configuração das sessões
SESSION_ENGINE=django.contrib.sessions.backends.db
SESSION_COOKIE_SECURE=False  # True em produção
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=3600

# Configuração de autenticação
LOGIN_URL=/login/
LOGOUT_REDIRECT_URL=/login/
